package pages

import "fmt"
import "github.com/cfcoimbra/mycfc/internal/validation"
import "github.com/cfcoimbra/mycfc/ui/components"

type GuardianAuthorityQueuePage struct {
	Meta components.PageMeta
	Items []GuardianAuthorityQueueItem
	Success, Conflict string
}

type GuardianAuthorityQueueItem struct {
	Reference, SubmittedLabel, Status, ReceivedAt, URL string
}

type GuardianAuthorityDetailPage struct {
	Meta components.PageMeta
	Reference, GuardianName, SubjectName, SubjectLabel, DateOfBirth, Status string
	ReadOnlyMessage string
	Version int64
	CanDecide, SelfConflict, ConflictRecorder bool
	CanVerify, CanReject, CanSuspend, CanExpire bool
	EvidenceTypes []GuardianAuthorityEvidenceType
	ReasonCodes []GuardianAuthorityReasonCode
	Errors validation.FieldErrors
	Action, EvidenceType, EvidenceReference, EvidenceDigest, ReasonCode string
}

type GuardianAuthorityEvidenceType struct { Code, Label string }
type GuardianAuthorityReasonCode struct { Code, Label string }

templ GuardianAuthorityQueue(page GuardianAuthorityQueuePage) {
	@components.Base(page.Meta, guardianAuthorityQueueContent(page))
}

templ guardianAuthorityQueueContent(page GuardianAuthorityQueuePage) {
	@components.PageHeader("Família", "Verificação de representação", "Acompanhe as representações abrangidas pela política aprovada.", nil)
	@components.StatusMessage(page.Success, "success")
	@components.StatusMessage(page.Conflict, "error")
	<section class="module" aria-labelledby="guardian-authority-queue-title">
		<h2 id="guardian-authority-queue-title">Representações a acompanhar</h2>
		if len(page.Items) == 0 {
			@components.EmptyState("Sem representações para acompanhar", "Os pedidos abrangidos aparecerão aqui quando a política estiver ativa.")
		} else {
			@components.RecordList("Pedidos de representação") {
				for _, item := range page.Items {
					<li class="record-item record-item--stacked"><div class="record-item__copy"><h3><a href={ templ.SafeURL(item.URL) }>{ item.Reference }</a></h3><p>{ item.SubmittedLabel }</p><p><strong>{ item.Status }</strong> · recebido em { item.ReceivedAt }</p></div></li>
				}
		}
		}
	</section>
}

templ GuardianAuthorityDetail(page GuardianAuthorityDetailPage) {
	@components.Base(page.Meta, guardianAuthorityDetailContent(page))
}

templ guardianAuthorityDetailContent(page GuardianAuthorityDetailPage) {
	<div class="task-route-page">
	@components.TaskRoute(components.TaskSurfaceConfig{ID: "guardian-authority-review", TitleID: "guardian-authority-review-title", Eyebrow: "Família", Title: "Verificar representação", Description: "Registe apenas metadados previstos na política. Não carregue documentos nem escreva dados pessoais em campos livres.", ReturnURL: "/admin/representacoes"}) {
		<section class="module" aria-labelledby="guardian-authority-summary-title">
			<h2 id="guardian-authority-summary-title">Resumo do pedido</h2>
			<dl><dt>Referência</dt><dd>{ page.Reference }</dd><dt>Adulto requerente</dt><dd>{ page.GuardianName }</dd><dt>{ page.SubjectLabel }</dt><dd>{ page.SubjectName }</dd><dt>Data de nascimento indicada</dt><dd>{ page.DateOfBirth }</dd><dt>Estado</dt><dd>{ page.Status }</dd></dl>
		</section>
		if page.SelfConflict {
			@components.StatusMessage("Não pode decidir uma representação em que é parte. Encaminhe-a para outra pessoa verificadora autorizada.", "error")
		}
		if page.ConflictRecorder {
			@components.StatusMessage("Registou o conflito desta representação. Outra pessoa verificadora autorizada tem de decidir.", "error")
		}
		if page.ReadOnlyMessage != "" {
			@components.StatusMessage(page.ReadOnlyMessage, "info")
		}
		if page.CanDecide {
			@components.ErrorSummary(components.FieldErrorsFor(map[string]string(page.Errors), []components.FieldErrorRef{{Key: "form", Field: "guardian-authority-decision"}, {Key: "action", Field: "action"}, {Key: "evidence_type", Field: "evidence_type"}, {Key: "evidence_reference", Field: "evidence_reference"}, {Key: "evidence_digest", Field: "evidence_digest"}, {Key: "reason_code", Field: "reason_code"}}))
			<form id="guardian-authority-decision" method="post" action={ templ.SafeURL("/admin/representacoes/" + page.Reference) } class="form-layout" data-task-form>
				@page.Meta.CSRFField
				<input type="hidden" name="version" value={ fmt.Sprint(page.Version) }/>
				<div class="form-field">@components.FieldLabel("action", "Decisão", true)<select id="action" name="action" required aria-invalid?={ page.Errors["action"] != "" } aria-describedby="action-help action-error"><option value="">Selecione</option>
					if page.CanVerify {
						<option value="VERIFY" selected?={ page.Action == "VERIFY" }>Verificar ou renovar</option>
					}
					if page.CanReject {
						<option value="REJECT" selected?={ page.Action == "REJECT" }>Rejeitar definitivamente</option>
					}
					if page.CanSuspend {
						<option value="SUSPEND" selected?={ page.Action == "SUSPEND" }>Suspender acesso imediatamente</option>
					}
					if page.CanExpire {
						<option value="EXPIRE" selected?={ page.Action == "EXPIRE" }>Registar expiração prevista</option>
					}
				</select>@components.FieldHelp("action-help", "Suspender remove imediatamente o acesso. Rejeitar termina este pedido; uma nova associação exige um novo pedido.")@components.FieldErrorMessage("action", page.Errors["action"])</div>
				<div class="form-field">@components.FieldLabel("evidence_type", "Tipo de comprovativo", false)<select id="evidence_type" name="evidence_type" aria-invalid?={ page.Errors["evidence_type"] != "" } aria-describedby="evidence-type-help evidence_type-error"><option value="">Selecione um tipo aprovado</option>
					for _, evidence := range page.EvidenceTypes {
						<option value={ evidence.Code } selected?={ page.EvidenceType == evidence.Code }>{ evidence.Label }</option>
					}
				</select>@components.FieldHelp("evidence-type-help", "A lista é definida pela política aprovada.")@components.FieldErrorMessage("evidence_type", page.Errors["evidence_type"])</div>
			<div class="form-field">@components.FieldLabel("evidence_reference", "Referência opaca do comprovativo", false)<input id="evidence_reference" name="evidence_reference" value={ page.EvidenceReference } autocomplete="off" aria-invalid?={ page.Errors["evidence_reference"] != "" } aria-describedby="evidence-reference-help evidence_reference-error"/>@components.FieldHelp("evidence-reference-help", "Obrigatória para verificar ou rejeitar. Use apenas a referência do arquivo restrito; não introduza nomes nem conteúdo do documento.")@components.FieldErrorMessage("evidence_reference", page.Errors["evidence_reference"])</div>
			<div class="form-field">@components.FieldLabel("evidence_digest", "Impressão digital SHA-256", false)<input id="evidence_digest" name="evidence_digest" value={ page.EvidenceDigest } minlength="64" maxlength="64" pattern="[0-9A-Fa-f]{64}" autocomplete="off" aria-invalid?={ page.Errors["evidence_digest"] != "" } aria-describedby="evidence-digest-help evidence_digest-error"/>@components.FieldHelp("evidence-digest-help", "Obrigatória para verificar ou rejeitar. Introduza 64 caracteres hexadecimais; não cole o conteúdo do comprovativo.")@components.FieldErrorMessage("evidence_digest", page.Errors["evidence_digest"])</div>
			<div class="form-field">@components.FieldLabel("reason_code", "Código de motivo", true)<select id="reason_code" name="reason_code" required aria-invalid?={ page.Errors["reason_code"] != "" } aria-describedby="reason-code-help reason_code-error"><option value="">Selecione</option>
				for _, reason := range page.ReasonCodes {
					<option value={ reason.Code } selected?={ page.ReasonCode == reason.Code }>{ reason.Label }</option>
				}
			</select>@components.FieldHelp("reason-code-help", "Obrigatório para todas as decisões e limitado aos motivos da política aprovada.")@components.FieldErrorMessage("reason_code", page.Errors["reason_code"])</div>
			<label><input type="checkbox" name="confirmed" value="yes" required/>Confirmo que apliquei a política aprovada e que não registei conteúdo do comprovativo.</label>
			<button class="action action--primary" type="submit">Registar decisão</button>
			</form>
		}
	}
	</div>
}
