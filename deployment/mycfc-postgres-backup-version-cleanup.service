[Unit]
Description=MyCFC exact-version PostgreSQL backup cleanup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/mycfc/deployment/postgres-backup-version-cleanup.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/tmp
