package pages

import "github.com/cfcoimbra/mycfc/ui/components"

type LandingPage struct {
	Meta    components.PageMeta
	HeroURL string
}

templ Landing(page LandingPage) {
	@components.PublicBase(page.Meta, landingContent(page))
}

templ landingContent(page LandingPage) {
	<section class="landing-hero" aria-labelledby="landing-title">
		<div class="landing-hero__image"><img src={ page.HeroURL } alt="Instalações do Clube Fluvial de Coimbra junto ao rio"/></div>
		<div class="landing-hero__copy"><p class="landing-kicker">Coimbra · desde 1989</p><h1 id="landing-title">A promover a canoagem, dentro e fora de água.</h1><p>O MyCFC aproxima atletas, famílias e o clube: acompanhe a sua atividade, consulte agendas e trate do essencial num só lugar.</p><div class="landing-actions"><a class="landing-primary" href="/registo">Criar conta MyCFC</a><a class="landing-secondary" href="/login">Iniciar sessão</a></div></div>
	</section>
	<section class="landing-intro" aria-labelledby="club-title"><p class="landing-kicker">Clube Fluvial de Coimbra</p><h2 id="club-title">Uma casa para a canoagem em Coimbra.</h2><p>Somos uma associação cultural e desportiva que promove a formação, a competição e o lazer na água. Conheça o clube, as equipas e a atividade que nos move.</p><a class="text-link" href="https://cfcoimbra.com/o-clube/">Conhecer o Clube Fluvial de Coimbra</a></section>
	<section class="landing-paths" aria-labelledby="paths-title"><div><p class="landing-kicker">MyCFC</p><h2 id="paths-title">Feito para o ritmo do clube.</h2></div><div class="landing-path-grid"><article><span class="landing-number">01</span><h3>Atletas</h3><p>Treinos, desempenho, grupos e calendários de competição sempre próximos.</p></article><article><span class="landing-number">02</span><h3>Famílias</h3><p>Acompanhe os menores a cargo e reúna as agendas relevantes num só espaço.</p></article><article><span class="landing-number">03</span><h3>Lazer</h3><p>Descubra notícias, grupos e os próximos momentos para remar em comunidade.</p></article></div></section>
	<section class="landing-club-links" aria-labelledby="links-title"><div><p class="landing-kicker">Acompanhe o clube</p><h2 id="links-title">A atividade continua no CFC.</h2></div><nav aria-label="Informação do clube"><a href="https://cfcoimbra.com/noticias/"><span>Notícias</span><strong>Ver as novidades do clube</strong></a><a href="https://cfcoimbra.com/eventos/"><span>Eventos</span><strong>Consultar o calendário público</strong></a><a href="https://cfcoimbra.com/contactos/"><span>Contactos</span><strong>Falar connosco</strong></a></nav></section>
	<section class="landing-contact" aria-labelledby="contact-title"><div><p class="landing-kicker">Venha remar connosco</p><h2 id="contact-title">O rio está aqui ao lado.</h2></div><div><a href="tel:+351912626410">+351 912 626 410</a><a href="mailto:cfluvialcoimbra@gmail.com">cfluvialcoimbra@gmail.com</a><p>Av. Inês de Castro, Pav. A<br/>3040-255 Coimbra</p></div></section>
}
