package pages

import "github.com/cfcoimbra/mycfc/ui/components"

type LoginPage struct {
	Meta      components.PageMeta
	Email     string
	Next      string
	CSRFField templ.Component
	Error     string
	Success   string
}

templ Login(page LoginPage) {
	@components.AuthBase(page.Meta, loginContent(page))
}

templ loginContent(page LoginPage) {
	<section class="auth-card auth-card--login" aria-labelledby="login-title">
		<p class="eyebrow">Área reservada</p>
		<h1 id="login-title">Iniciar sessão</h1>
		<p>Entre para acompanhar a vida do clube, os seus espaços e responsabilidades.</p>
		@components.StatusMessage(page.Success, "success")
		<form class="form-layout" method="post" action="/login">
			@page.CSRFField
			if page.Next != "" {
				<input type="hidden" name="next" value={ page.Next }/>
			}
			@components.ErrorSummary(loginErrors(page.Error))
			@components.RequiredNote()
			<div class="form-field">
				@components.FieldLabel("identifier", "Correio eletrónico ou identificador CFC", true)
				<input id="identifier" name="identifier" autocomplete="username" value={ page.Email } required aria-invalid={ ariaBoolean(page.Error != "") } aria-describedby="identifier-help identifier-error"/>
				@components.FieldHelp("identifier-help", "Também pode usar o identificador CFC atribuído a um menor.")
				@components.FieldErrorMessage("identifier", page.Error)
			</div>
			<div class="form-field">
				@components.FieldLabel("password", "Palavra-passe", true)
				<input id="password" name="password" type="password" autocomplete="current-password" required/>
			</div>
			@components.FormActions("") { <button class="action action--primary" type="submit">Iniciar sessão</button> }
		</form>
		<p class="auth-alternate"><a href="/recuperar-palavra-passe">Recuperar palavra-passe</a><br/>Ainda não tem acesso? <a href="/registo">Criar conta MyCFCoimbra</a></p>
	</section>
}

func loginErrors(message string) []components.FieldError {
	if message == "" { return nil }
	return []components.FieldError{{Field: "identifier", Message: message}}
}

func ariaBoolean(value bool) string { if value { return "true" }; return "false" }
