ssh_public_key        = "ssh-ed25519 AAAA... operator@example.com"
deploy_ssh_public_key = "ssh-ed25519 AAAA... deploy@example.com"
ssh_source_ips        = ["203.0.113.10/32"]

# Backup version cleanup uses a separate identity and credential. Enable the
# inventory-only identity first; deletion and lifecycle remain a later gate.
postgres_backup_cleanup_identity_enabled      = false
postgres_backup_noncurrent_cleanup_enabled    = false
postgres_backup_cleanup_assumer_arns          = ["arn:aws:iam::123456789012:role/mycfc-production-backup-cleanup-renewer"]
