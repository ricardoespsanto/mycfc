package pages

import "github.com/cfcoimbra/mycfc/ui/components"

type LoginPage struct {
	Meta      components.PageMeta
	Email     string
	Next      string
	CSRFField templ.Component
	Error     string
}

templ Login(page LoginPage) {
	@components.Base(page.Meta, loginContent(page))
}

templ loginContent(page LoginPage) {
	<section class="auth-card" aria-labelledby="login-title">
		<h1 id="login-title">Iniciar sessão</h1>
			<p>Utilize o seu correio eletrónico ou identificador CFC e palavra-passe.</p>
		if page.Error != "" {
			<p class="field-error" role="alert">{ page.Error }</p>
		}
		<form class="form-layout" method="post" action="/login">
			@page.CSRFField
			if page.Next != "" {
				<input type="hidden" name="next" value={ page.Next }/>
			}
			<div class="form-field">
				<label for="identifier">Correio eletrónico ou identificador CFC</label>
				<input id="identifier" name="identifier" autocomplete="username" value={ page.Email } required/>
			</div>
			<div class="form-field">
				<label for="password">Palavra-passe</label>
				<input id="password" name="password" type="password" autocomplete="current-password" required/>
			</div>
			<button type="submit">Iniciar sessão</button>
		</form>
	</section>
}
