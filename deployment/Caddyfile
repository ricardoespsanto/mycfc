{
	# cloudflared is the only proxy that can reach Caddy on the private Docker network.
	servers {
		trusted_proxies static private_ranges
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

http://{$MYCFC_DOMAIN} {
	encode zstd gzip

	rate_limit {
		zone registration_create {
			match {
				method POST
				path /registo
			}
			key {client_ip}
			events 5
			window 5m
		}
	}

	reverse_proxy app:8080 {
		health_uri /health/live
		health_interval 10s
		health_timeout 2s
	}
}
