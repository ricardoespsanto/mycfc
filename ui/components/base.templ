package components

import "strings"

type PageMeta struct {
	Title           string
	StylesheetURL   string
	ScriptURL       string
	BrandImageURL   string
	CurrentPath     string
	CurrentUserName string
	Navigation      []NavigationGroup
	CSRFField       templ.Component
	AreaLabel       string
	PageLabel       string
	SubjectContext  string
}

templ PublicBase(meta PageMeta, content templ.Component) {
	<!doctype html>
	<html lang="pt-PT">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ meta.Title }</title>
			<link rel="stylesheet" href={ meta.StylesheetURL }/>
			<script src={ meta.ScriptURL } defer></script>
		</head>
		<body class="public-body">
			<a class="skip-link" href="#conteudo-principal">Saltar para o conteúdo principal</a>
			<header class="public-header">
				<div class="public-header__content">
					<a class="public-brand" href="/" aria-label="Clube Fluvial de Coimbra, página inicial">
						<img src={ meta.BrandImageURL } alt="Clube Fluvial de Coimbra"/>
						<span>Clube Fluvial de Coimbra<small>MyCFC</small></span>
					</a>
					<nav aria-label="Navegação pública"><a href="https://cfcoimbra.com/o-clube/">O Clube</a><a href="https://cfcoimbra.com/noticias/">Notícias</a><a href="https://cfcoimbra.com/eventos/">Eventos</a></nav>
					<div class="public-header__actions"><a class="public-login" href="/login">Iniciar sessão</a><a class="public-register" href="/registo">Criar conta</a></div>
				</div>
			</header>
			<main id="conteudo-principal">
				@content
			</main>
			<footer class="public-footer">
				<div><strong>Clube Fluvial de Coimbra</strong><p>A promover a canoagem desde 1989.</p></div>
				<address><a href="tel:+351912626410">+351 912 626 410</a><a href="mailto:cfluvialcoimbra@gmail.com">cfluvialcoimbra@gmail.com</a><span>Av. Inês de Castro, Pav. A, 3040-255 Coimbra</span></address>
				<nav aria-label="Redes sociais"><a href="https://www.facebook.com/CFCoimbra">Facebook</a><a href="https://www.instagram.com/cfcoimbra/">Instagram</a><a href="https://www.youtube.com/channel/UCiCvFGLsklKxzqOrEjG9gDw">YouTube</a></nav>
			</footer>
		</body>
	</html>
}

templ Base(meta PageMeta, content templ.Component) {
	<!doctype html>
	<html lang="pt-PT">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ meta.Title }</title>
			<link rel="stylesheet" href={ meta.StylesheetURL }/>
			<script src={ meta.ScriptURL } defer></script>
		</head>
		<body class="app-body">
			<a class="skip-link" href="#conteudo-principal">Saltar para o conteúdo principal</a>
			if len(meta.Navigation) > 0 {
				<div class="app-shell">
					<aside class="app-rail" aria-label="Contexto e navegação MyCFC">
						<a class="site-brand" href="/today"><span class="site-brand__mark" aria-hidden="true">≈</span><span>MyCFC</span></a>
						<section class="account-context" aria-label="Conta atual"><strong>{ meta.CurrentUserName }</strong><span>Conta com responsabilidades cumulativas</span><div class="capability-list">
							for _, label := range capabilityLabels(meta.Navigation) {
								<span>{ label }</span>
							}
						</div></section>
						@Navigation(meta.CurrentPath, meta.Navigation)
						<div class="account-actions"><a href="/today">Conta e início</a><form method="post" action="/logout">
							if meta.CSRFField != nil {
								@meta.CSRFField
							}
							<button class="logout-button" type="submit">Terminar sessão</button>
						</form></div>
					</aside>
					<div class="app-workspace">
						<header class="workspace-header"><nav aria-label="Localização atual"><ol><li>MyCFC</li><li>{ resolvedArea(meta) }</li><li aria-current="page">{ resolvedPage(meta) }</li></ol></nav>
							if meta.SubjectContext != "" {
								<p class="subject-context"><span>A atuar sobre</span><strong>{ meta.SubjectContext }</strong></p>
							}
						</header>
						if strings.HasPrefix(meta.CurrentPath, "/admin/") {
							@AdminSubNav(meta.CurrentPath)
						}
						<main id="conteudo-principal">@content</main>
						<footer class="site-footer">Clube Fluvial de Coimbra</footer>
					</div>
				</div>
			} else {
				<main id="conteudo-principal">@content</main><footer class="site-footer">Clube Fluvial de Coimbra</footer>
			}
		</body>
	</html>
}

func capabilityLabels(groups []NavigationGroup) []string {
	labels := []string{"Membro"}
	for _, group := range groups { if group.Label != "" { for _, item := range group.Items { labels = append(labels, item.Label) } } }
	return labels
}

func resolvedArea(meta PageMeta) string { if meta.AreaLabel != "" { return meta.AreaLabel }; if strings.HasPrefix(meta.CurrentPath, "/admin/") { return "Administração" }; if strings.HasPrefix(meta.CurrentPath, "/dashboard/") { return "Os meus espaços" }; return "Atividade" }
func resolvedPage(meta PageMeta) string { if meta.PageLabel != "" { return meta.PageLabel }; for _, group := range meta.Navigation { for _, item := range group.Items { if navigationMatches(meta.CurrentPath, item.Path) { return item.Label } } }; return "Página atual" }
