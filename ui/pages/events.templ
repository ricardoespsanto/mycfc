package pages

import (
    "github.com/cfcoimbra/mycfc/internal/validation"
    "github.com/cfcoimbra/mycfc/ui/components"
)

type EventItem struct { ID, Title, When, Status, Capacity string }
type EventResponse struct { UserID, Name, Status, RespondedAt, CheckedInAt string }
type EventDependent struct { ID, Name string }
type EventProgramme struct { ID, Name string; Selected bool }
type EventTeam struct { ID, Name string; Selected bool }
type EventForm struct {
    CSRFField templ.Component
    Title, Description, StartsAt, EndsAt, Deadline, Capacity string
    Programmes []EventProgramme
    Teams []EventTeam
    Errors validation.FieldErrors
}
type EventsPage struct { Meta components.PageMeta; Management, CanManageEvents bool; PreviousURL, NextURL, Success string; Events []EventItem; Form EventForm }
type EventDetailPage struct {
    Meta components.PageMeta
    CanManageEvents bool
    ID, Title, Description, When, Deadline, Capacity, Status string
    Responses []EventResponse
    ResponsesPreviousURL, ResponsesNextURL string
    Dependents []EventDependent
    CSRFField templ.Component
}

templ Events(page EventsPage) { @components.Base(page.Meta, eventsContent(page)) }
templ eventsContent(page EventsPage) {
    <div class="collection-page">
    if page.Management {
        @components.PageHeader("Administração", "Eventos", "Crie eventos e acompanhe as respostas dos participantes.", eventPageActions(page))
    } else {
        @components.PageHeader("Atividade", "Eventos", "Consulte a agenda e responda às atividades relevantes para si.", nil)
    }
    @components.StatusMessage(page.Success, "success")
    <section class="collection-view">
        @components.SectionHeading("Agenda", "Próximos eventos", "Datas, estado da sua resposta e disponibilidade num só lugar.") {
            <span class="collection-count">{ len(page.Events) } eventos</span>
        }
        if len(page.Events) == 0 {
            @components.EmptyState("Sem eventos próximos", "Quando o clube marcar uma atividade relevante, ela aparece aqui.")
        }
        if len(page.Events) > 0 {
            <ul class="record-list collection-list" aria-label="Próximos eventos">
                for _, event := range page.Events {
                    <li class="record-item"><div class="record-item__copy"><h3><a href={ eventPageURL(page, event.ID) }>{ event.Title }</a></h3><p class="record-meta">{ event.When }{ event.Capacity }</p></div>@components.Badge(event.Status, eventStatusTone(event.Status))<a class="action action--quiet collection-open" href={ eventPageURL(page, event.ID) }>Abrir</a></li>
                }
            </ul>
        }
        if page.PreviousURL != "" || page.NextURL != "" {
            <nav class="pagination" aria-label="Paginação de eventos">
                if page.PreviousURL != "" {
                    <a href={ templ.SafeURL(page.PreviousURL) }>Anterior</a>
                }
                if page.NextURL != "" {
                    <a href={ templ.SafeURL(page.NextURL) }>Seguinte</a>
                }
            </nav>
        }
    </section>
    if page.Management {
        @EventAuthoringForm(page.Form)
    }
    </div>
}

templ EventAuthoringForm(form EventForm) {
    <details id="criar-evento" class="module disclosure create-panel" data-create-panel open?={ len(form.Errors) > 0 } aria-labelledby="event-authoring-title"><summary><span><strong id="event-authoring-title">Criar evento</strong><small>Defina data, lotação e participantes.</small></span></summary><button class="create-panel__close" type="button">Fechar</button><div class="disclosure__content">
        @components.ErrorSummary(components.FieldErrorsFor(map[string]string(form.Errors), []components.FieldErrorRef{{Key: "title", Field: "event-title"}, {Key: "description", Field: "event-description"}, {Key: "starts_at", Field: "event-starts-at"}, {Key: "ends_at", Field: "event-ends-at"}, {Key: "response_deadline", Field: "event-deadline"}, {Key: "capacity", Field: "event-capacity"}, {Key: "programme_id", Field: "event-audience"}, {Key: "team_id", Field: "event-audience"}, {Key: "audience", Field: "event-audience"}}))
        <form class="form-layout" method="post" action="/admin/events">@form.CSRFField
            @components.RequiredNote()
            @components.FieldLabel("event-title", "Título", true)<input id="event-title" name="title" value={ form.Title } required aria-invalid?={ form.Errors["title"] != "" } aria-describedby="event-title-help title-error"/>@components.FieldHelp("event-title-help", "Dê ao evento um nome curto e reconhecível.")
            @components.FieldErrorMessage("title", form.Errors["title"])
            @components.FieldLabel("event-description", "Descrição (opcional)", false)<textarea id="event-description" name="description" aria-invalid?={ form.Errors["description"] != "" } aria-describedby="description-error">{ form.Description }</textarea>
            @components.FieldErrorMessage("description", form.Errors["description"])
            @components.FieldLabel("event-starts-at", "Início", true)<input id="event-starts-at" name="starts_at" type="datetime-local" value={ form.StartsAt } required aria-invalid?={ form.Errors["starts_at"] != "" } aria-describedby="starts_at-error"/>
            @components.FieldErrorMessage("starts_at", form.Errors["starts_at"])
            @components.FieldLabel("event-ends-at", "Fim", true)<input id="event-ends-at" name="ends_at" type="datetime-local" value={ form.EndsAt } required aria-invalid?={ form.Errors["ends_at"] != "" } aria-describedby="ends_at-error"/>
            @components.FieldErrorMessage("ends_at", form.Errors["ends_at"])
            @components.FieldLabel("event-deadline", "Limite de resposta (opcional)", false)<input id="event-deadline" name="response_deadline" type="datetime-local" value={ form.Deadline } aria-invalid?={ form.Errors["response_deadline"] != "" } aria-describedby="response_deadline-error"/>
            @components.FieldErrorMessage("response_deadline", form.Errors["response_deadline"])
            @components.FieldLabel("event-capacity", "Lotação (opcional)", false)<input id="event-capacity" name="capacity" type="number" min="1" value={ form.Capacity } aria-invalid?={ form.Errors["capacity"] != "" } aria-describedby="capacity-error"/>
            @components.FieldErrorMessage("capacity", form.Errors["capacity"])
            <details id="event-audience"><summary>Destinatários (opcional)</summary><fieldset><legend>Destinatários</legend><p>Os administradores podem deixar esta lista vazia para todos os membros.</p>
                for _, programme := range form.Programmes {
                    <label><input name="programme_id" type="checkbox" value={ programme.ID } checked?={ programme.Selected }/> { programme.Name }</label>
                }
                for _, team := range form.Teams {
                    <label><input name="team_id" type="checkbox" value={ team.ID } checked?={ team.Selected }/> { team.Name }</label>
                }
            </fieldset></details>@components.FieldErrorMessage("programme_id", form.Errors["programme_id"])@components.FieldErrorMessage("team_id", form.Errors["team_id"])@components.FieldErrorMessage("audience", form.Errors["audience"])
            @components.FormActions("/admin/eventos") { <button type="submit">Criar evento</button> }
        </form>
    </div></details>
}

templ EventDetail(page EventDetailPage) { @components.Base(page.Meta, eventDetailContent(page)) }
templ eventDetailContent(page EventDetailPage) {
	@components.PageHeader(eventDetailArea(page), page.Title, page.Description, []components.PageAction{{Label: "Voltar aos eventos", Href: eventDetailBackURL(page), Variant: "quiet"}})
    <section class="module event-summary" aria-label="Informação do evento">
        <p class="record-meta">{ page.When }</p>
        if page.Deadline != "" {
            <p>{ page.Deadline }</p>
        }
        if page.Capacity != "" {
            <p>{ page.Capacity }</p>
        }
    </section>
    if !page.CanManageEvents {
        <section class="module">
            @components.SectionHeading("Participação", "A sua resposta", "Confirme a participação da pessoa certa.") {
                <span class="record-item__actions"><span class="record-meta">Estado: { page.Status }</span>@components.Badge(page.Status, eventStatusTone(page.Status))</span>
            }
            if page.Status != "Fora do prazo" {
                <form class="form-layout" method="post" action={ "/events/" + page.ID + "/responses" }>
                    @page.CSRFField@components.FieldLabel("event-subject", "Resposta para", false)
                    <select id="event-subject" name="subject_user_id"><option value="">A minha participação</option>
                        for _, dependent := range page.Dependents {
                            <option value={ dependent.ID }>{ dependent.Name }</option>
                        }
                    </select>
                    @components.FormActions("/events") {
                        <button class="action action--primary" name="status" value="Going" type="submit">Vou</button>
                        <button class="action action--secondary" name="status" value="NotGoing" type="submit">Não vou</button>
                    }
                </form>
            }
        </section>
    }
    if page.CanManageEvents {
        <section class="module">
            @components.SectionHeading("Gestão", "Respostas e presenças", "Acompanhe confirmações, lista de espera e check-in.")
            if len(page.Responses) == 0 {
                @components.EmptyState("Ainda sem respostas", "As confirmações dos participantes aparecem aqui.")
            }
            if len(page.Responses) > 0 {
                @components.RecordList("Respostas ao evento") {
                    for _, response := range page.Responses {
                        @components.RecordItem(response.Name, "", response.RespondedAt) {
                            @components.Badge(response.Status, eventStatusTone(response.Status))
                            if (response.Status == "Em lista de espera") || (response.Status == "Vou" && response.CheckedInAt == "") {
                                <details class="inline-disclosure"><summary>Ações</summary><div class="record-item__actions">
                                if response.Status == "Em lista de espera" {
                                    <form method="post" action={ "/admin/events/" + page.ID + "/confirm" }>@page.CSRFField<input type="hidden" name="user_id" value={ response.UserID }/><button class="action action--secondary" type="submit">Confirmar vaga</button></form>
                                }
                                if response.Status == "Vou" && response.CheckedInAt == "" {
                                    <form method="post" action={ "/admin/events/" + page.ID + "/check-in" }>@page.CSRFField<input type="hidden" name="user_id" value={ response.UserID }/><button class="action action--secondary" type="submit">Registar presença</button></form>
                                }
                                </div></details>
                            }
                            if response.CheckedInAt != "" {
                                <span class="record-meta">Presença: { response.CheckedInAt }</span>
                            }
                        }
                    }
                }
            }
            if page.ResponsesPreviousURL != "" || page.ResponsesNextURL != "" {
                <nav class="pagination" aria-label="Paginação de respostas">
                    if page.ResponsesPreviousURL != "" {
                        <a href={ templ.SafeURL(page.ResponsesPreviousURL) }>Anterior</a>
                    }
                    if page.ResponsesNextURL != "" {
                        <a href={ templ.SafeURL(page.ResponsesNextURL) }>Seguinte</a>
                    }
                </nav>
            }
        </section>
    }
}

func eventPageActions(page EventsPage) []components.PageAction {
    if page.Management {
        return []components.PageAction{{Label: "Criar evento", Href: "#criar-evento", Variant: "primary"}}
    }
    return nil
}

func eventPageURL(page EventsPage, id string) string { if page.Management { return "/admin/eventos/" + id }; return "/events/" + id }
func eventDetailArea(page EventDetailPage) string { if page.CanManageEvents { return "Administração · Eventos" }; return "Evento" }
func eventDetailBackURL(page EventDetailPage) string { if page.CanManageEvents { return "/admin/eventos" }; return "/events" }

func eventStatusTone(status string) string {
    switch status {
    case "Vou", "Confirmado", "Presente":
        return "success"
    case "Em lista de espera", "Pendente":
        return "warning"
    case "Não vou", "Fora do prazo":
        return "error"
    default:
        return "selected"
    }
}
