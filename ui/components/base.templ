package components

import "strings"

type PageMeta struct {
	Title           string
	StylesheetURL   string
	ScriptURL       string
	BrandImageURL   string
	CurrentPath     string
	CurrentUserName string
	CurrentUserID   string
	EmailVerificationPending bool
	Navigation      []NavigationGroup
	CSRFField       templ.Component
	AreaLabel       string
	PageLabel       string
	SubjectContext  string
	Breadcrumbs     []NavigationItem
}

templ PublicBase(meta PageMeta, content templ.Component) {
	<!doctype html>
	<html lang="pt-PT">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ meta.Title }</title>
			<link rel="stylesheet" href={ meta.StylesheetURL }/>
			<script src={ meta.ScriptURL } defer></script>
		</head>
		<body class="public-body">
			<a class="skip-link" href="#conteudo-principal">Saltar para o conteúdo principal</a>
			<header class="public-header">
				<div class="public-header__content">
					<a class="public-brand" href="/" aria-label="Clube Fluvial de Coimbra, página inicial">
						<img src={ meta.BrandImageURL } alt="Clube Fluvial de Coimbra"/>
						<span>Clube Fluvial de Coimbra<small>MyCFC</small></span>
					</a>
					<nav aria-label="Navegação pública"><a href="https://cfcoimbra.com/o-clube/">O Clube</a><a href="https://cfcoimbra.com/noticias/">Notícias</a><a href="https://cfcoimbra.com/eventos/">Eventos</a></nav>
					<div class="public-header__actions"><a class="public-login" href="/login">Iniciar sessão</a><a class="public-register" href="/registo">Criar conta</a></div>
				</div>
			</header>
			<main id="conteudo-principal">
				@content
			</main>
			<footer class="public-footer">
				<div><strong>Clube Fluvial de Coimbra</strong><p>A promover a canoagem desde 1989.</p></div>
				<address><a href="tel:+351912626410">+351 912 626 410</a><a href="mailto:cfluvialcoimbra@gmail.com">cfluvialcoimbra@gmail.com</a><span>Av. Inês de Castro, Pav. A, 3040-255 Coimbra</span></address>
				<nav aria-label="Redes sociais"><a href="https://www.facebook.com/CFCoimbra">Facebook</a><a href="https://www.instagram.com/cfcoimbra/">Instagram</a><a href="https://www.youtube.com/channel/UCiCvFGLsklKxzqOrEjG9gDw">YouTube</a></nav>
			</footer>
		</body>
	</html>
}

templ AuthBase(meta PageMeta, content templ.Component) {
	<!doctype html>
	<html lang="pt-PT">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ meta.Title }</title>
			<link rel="stylesheet" href={ meta.StylesheetURL }/>
			<script src={ meta.ScriptURL } defer></script>
		</head>
		<body class="auth-body">
			<a class="skip-link" href="#conteudo-principal">Saltar para o conteúdo principal</a>
			<header class="auth-header">
				<a class="auth-brand" href="/" aria-label="MyCFC, voltar à página inicial">
					if meta.BrandImageURL != "" {
						<img src={ meta.BrandImageURL } alt=""/>
					} else {
						<span class="site-brand__mark" aria-hidden="true">≈</span>
					}
					<span><strong>MyCFC</strong><small>Clube Fluvial de Coimbra</small></span>
				</a>
				<a class="auth-back" href="/">Voltar ao início</a>
			</header>
			<main id="conteudo-principal" class="auth-main">@content</main>
			<footer class="auth-footer">Clube Fluvial de Coimbra · Desde 1989</footer>
		</body>
	</html>
}

templ Base(meta PageMeta, content templ.Component) {
	<!doctype html>
	<html lang="pt-PT">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ meta.Title }</title>
			<link rel="stylesheet" href={ meta.StylesheetURL }/>
			<script src={ meta.ScriptURL } defer></script>
		</head>
		<body class="app-body">
			<a class="skip-link" href="#conteudo-principal">Saltar para o conteúdo principal</a>
			if len(meta.Navigation) > 0 {
				<header class="mobile-app-header">
					<a class="mobile-app-brand" href="/today">
						if meta.BrandImageURL != "" {
							<img src={ meta.BrandImageURL } alt=""/>
						} else {
							<span class="site-brand__mark" aria-hidden="true">≈</span>
						}
						<span>MyCFC</span>
					</a>
					<div class="mobile-app-header__actions">
						@announcementTrigger()
						<button class="mobile-navigation-trigger" type="button" aria-controls="mobile-navigation" aria-expanded="false" data-mobile-navigation-open hidden>Menu</button>
						<details class="mobile-app-menu" data-mobile-navigation-fallback><summary>Menu</summary><div class="mobile-app-menu__content">@mobileNavigationContent(meta)</div></details>
					</div>
				</header>
				<dialog id="mobile-navigation" class="mobile-navigation-drawer" aria-labelledby="mobile-navigation-title" data-mobile-navigation>
					<header><h2 id="mobile-navigation-title">Menu MyCFC</h2><button type="button" class="action action--quiet" data-mobile-navigation-close autofocus>Fechar</button></header>
					<div class="mobile-navigation-drawer__content">@mobileNavigationContent(meta)</div>
				</dialog>
				<section id="announcement-panel" class="announcement-panel" role="dialog" aria-modal="true" aria-labelledby="announcement-panel-title" data-announcement-panel hidden>
					<h2 id="announcement-panel-title" class="visually-hidden">Avisos</h2>
					<p class="announcement-panel__loading" role="status">A carregar avisos…</p>
				</section>
				<div class="app-shell">
					<aside class="app-rail" aria-label="Contexto e navegação MyCFC">
						<div class="app-rail__brand-row">
							<a class="site-brand" href="/today">
								if meta.BrandImageURL != "" {
									<img src={ meta.BrandImageURL } alt=""/>
								} else {
									<span class="site-brand__mark" aria-hidden="true">≈</span>
								}
								<span>MyCFC</span>
							</a>
							@announcementTrigger()
						</div>
						@Navigation(meta.CurrentPath, meta.Navigation)
						@accountContext(meta)
						@accountActions(meta)
					</aside>
					<div class="app-workspace">
						<header class={ "workspace-header " + workspaceHeaderClass(meta) }><nav aria-label="Localização atual"><ol><li><a href="/today">MyCFC</a></li>
							for _, item := range meta.Breadcrumbs {
								<li><a href={ item.Path }>{ item.Label }</a></li>
							}
							if len(meta.Breadcrumbs) == 0 && resolvedArea(meta) != resolvedPage(meta) {
								<li>{ resolvedArea(meta) }</li>
							}
							<li aria-current="page">{ resolvedPage(meta) }</li></ol></nav>
							if meta.SubjectContext != "" {
								<p class="subject-context"><span>A atuar sobre</span><strong>{ meta.SubjectContext }</strong></p>
							}
						</header>
						<main id="conteudo-principal">@content</main>
						<footer class="site-footer">Clube Fluvial de Coimbra</footer>
					</div>
				</div>
			} else {
				<main id="conteudo-principal">@content</main><footer class="site-footer">Clube Fluvial de Coimbra</footer>
			}
		</body>
	</html>
}

templ mobileNavigationContent(meta PageMeta) {
	@accountContext(meta)
	@Navigation(meta.CurrentPath, meta.Navigation)
	@accountActions(meta)
}

templ accountContext(meta PageMeta) {
	<section class="account-context" aria-label="Conta atual">
		<p class="account-context__label">Conta</p>
		<a class="account-profile-link person-name" href="/perfil" aria-label={ "Abrir perfil de " + meta.CurrentUserName }>@Avatar(meta.CurrentUserID, meta.CurrentUserName)<strong>{ meta.CurrentUserName }</strong></a>
		<span class="account-context__kind">Membro</span>
		if meta.EmailVerificationPending {
			<a class="email-verification-cue" href="/perfil">Email por verificar</a>
		}
		<span class="visually-hidden">Conta com responsabilidades cumulativas</span>
		if labels := membershipLabels(meta.Navigation); len(labels) > 0 {
			<p class="account-context__label">Inscrições</p><div class="capability-list capability-list--memberships">
				for _, label := range labels {
					<span>{ label }</span>
				}
			</div>
		}
		if labels := capabilityLabels(meta.Navigation); len(labels) > 0 {
			<p class="account-context__label">Responsabilidades</p><div class="capability-list">
				for _, label := range labels {
					<span>{ label }</span>
				}
			</div>
		}
	</section>
}

templ accountActions(meta PageMeta) {
	<div class="account-actions"><form method="post" action="/logout">
		if meta.CSRFField != nil {
			@meta.CSRFField
		}
		<button class="logout-button" type="submit">Terminar sessão</button>
	</form></div>
}

templ announcementTrigger() {
	<a class="announcement-trigger" href="/announcements" aria-label="Avisos" aria-controls="announcement-panel" aria-expanded="false" data-announcement-trigger>
		<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg>
		<span class="announcement-trigger__count" data-announcement-badge hidden></span>
	</a>
}

func capabilityLabels(groups []NavigationGroup) []string {
	labels := []string{}
	for _, group := range groups { labels = append(labels, group.Capabilities...) }
	return labels
}

func membershipLabels(groups []NavigationGroup) []string {
	labels := []string{}
	for _, group := range groups { labels = append(labels, group.Memberships...) }
	return labels
}

func resolvedArea(meta PageMeta) string { if meta.AreaLabel != "" { return meta.AreaLabel }; if meta.CurrentPath == "/today" { return "Hoje" }; for _, group := range meta.Navigation { if group.Label != "" { for _, item := range group.Items { if navigationMatches(meta.CurrentPath, item.Path) { return group.Label } } } }; if strings.HasPrefix(meta.CurrentPath, "/admin/") { return "Administração" }; if strings.HasPrefix(meta.CurrentPath, "/dashboard/") { return "Inscrições" }; return "Atividade" }
func resolvedPage(meta PageMeta) string { if meta.PageLabel != "" { return meta.PageLabel }; for _, group := range meta.Navigation { for _, item := range group.Items { if navigationMatches(meta.CurrentPath, item.Path) { return item.Label } } }; return "Página atual" }
func workspaceHeaderClass(meta PageMeta) string { if meta.SubjectContext == "" && len(meta.Breadcrumbs) == 0 { return "workspace-header--root" }; return "workspace-header--detail" }
