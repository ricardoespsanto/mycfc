package pages

import "github.com/cfcoimbra/mycfc/internal/validation"
import "github.com/cfcoimbra/mycfc/ui/components"

type GuardianPage struct {
	Meta       components.PageMeta
	Dependents []GuardianDependent
	Calendars  []CalendarLink
	CalendarAPIKey string
	CalendarSources string
	ResponsibilityURL string
	Name, DateOfBirth string
	ResponsibilityAccepted bool
	Errors     validation.FieldErrors
	Success    string
	RepairForm components.RepairFormData
}
type GuardianDependent struct { ID, Name, Detail string; LeaderboardVisible bool }

templ Guardian(page GuardianPage) {
	@components.Base(page.Meta, GuardianContent(page))
}

templ GuardianContent(page GuardianPage) {
	<div id="guardian-content">
		@components.PageHeader("Família", "Menores a cargo", "Consulte os menores a seu cargo e associe um novo dependente quando necessário.", []components.PageAction{{Label: "Adicionar menor", Href: "#adicionar-menor", Variant: "primary"}})
		if page.Success != "" {
			@components.StatusMessage(page.Success, "success")
		}
		<section class="module">@components.SectionHeading("Família", "Dependentes associados", "Menores associados à sua conta e respetivo acesso.")
			if len(page.Dependents) == 0 {
				@components.EmptyState("Ainda sem menores associados", "Adicione o primeiro menor para gerir a responsabilidade a partir da sua conta.")
			}
				if len(page.Dependents) > 0 {
					@components.RecordList("Dependentes associados") {
						for _, dependent := range page.Dependents {
							<li class="record-item"><div class="record-item__copy"><h3>{ dependent.Name }</h3><p class="record-meta">{ dependent.Detail }</p></div><form class="privacy-form" method="post" action={ templ.SafeURL("/dashboard/guardian/dependents/"+dependent.ID+"/leaderboard-privacy") }>@page.Meta.CSRFField<label><input name="leaderboard_visible" type="checkbox" checked?={ dependent.LeaderboardVisible }/> Mostrar quilómetros na classificação</label><button type="submit">Guardar</button></form></li>
						}
				}
			}
		</section>
		<details id="adicionar-menor" class="module disclosure" open?={ len(page.Dependents) == 0 || len(page.Errors) > 0 } aria-labelledby="add-dependent-title"><summary><span><strong id="add-dependent-title">Adicionar menor a cargo</strong><small>Associe um novo dependente à sua conta.</small></span></summary><div class="disclosure__content">
			@components.StatusMessage(page.Errors["form"], "error")
			@components.ErrorSummary(components.FieldErrorsFromMap(map[string]string(page.Errors), []string{"name", "date_of_birth", "accept_minor_responsibility"}))
			<form class="form-layout" method="post" action="/guardian/add-dependent" hx-post="/guardian/add-dependent" hx-target="#guardian-content" hx-swap="outerHTML" hx-target-422="#guardian-content" hx-swap-422="outerHTML" hx-disabled-elt="find button, find input[type='submit']">
				@page.Meta.CSRFField
				@components.RequiredNote()
				<div class="form-field">@components.FieldLabel("name", "Nome", true)<input id="name" name="name" autocomplete="name" value={ page.Name } required aria-invalid?={ page.Errors["name"] != "" } aria-describedby="name-help name-error"/>@components.FieldHelp("name-help", "Use o nome completo do menor.")@components.FieldErrorMessage("name", page.Errors["name"])</div>
				<div class="form-field">@components.FieldLabel("date_of_birth", "Data de nascimento", true)<input id="date_of_birth" name="date_of_birth" type="date" value={ page.DateOfBirth } required aria-invalid?={ page.Errors["date_of_birth"] != "" } aria-describedby="date-of-birth-help date_of_birth-error"/>@components.FieldHelp("date-of-birth-help", "A idade é validada à data de hoje.")@components.FieldErrorMessage("date_of_birth", page.Errors["date_of_birth"])</div>
				<label for="accept_minor_responsibility"><input id="accept_minor_responsibility" name="accept_minor_responsibility" type="checkbox" required checked?={ page.ResponsibilityAccepted } aria-invalid?={ page.Errors["accept_minor_responsibility"] != "" } aria-describedby="accept_minor_responsibility-error"/> Aceito a <a href={ templ.SafeURL(page.ResponsibilityURL) } target="_blank" rel="noopener">responsabilidade pelo menor a cargo</a>. <span class="required-mark" aria-hidden="true">*</span></label>@components.FieldErrorMessage("accept_minor_responsibility", page.Errors["accept_minor_responsibility"])
				@components.FormActions("/dashboard/guardian") { <button type="submit">Adicionar menor</button> }
			</form>
		</div></details>
		@components.RepairForm(page.RepairForm)
	</div>
}
