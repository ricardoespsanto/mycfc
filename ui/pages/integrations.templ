package pages

import "github.com/cfcoimbra/mycfc/ui/components"

type IntegrationsPage struct {
	Meta components.PageMeta
	Enabled, Eligible, Connected, ReauthorizationRequired bool
	Status, LastSync, Success, Error string
}

templ Integrations(page IntegrationsPage) { @components.Base(page.Meta, integrationsContent(page)) }

templ integrationsContent(page IntegrationsPage) {
	<div class="profile-page">
		@components.PageHeader("Conta", "Integrações", "Ligue serviços externos para importar evidência das suas atividades.", []components.PageAction{{Label: "Voltar ao perfil", Href: "/perfil", Variant: "secondary"}})
		@components.StatusMessage(page.Success, "success")
		@components.StatusMessage(page.Error, "error")
		<section class="module" aria-labelledby="polar-integration-title">
			<p class="eyebrow">Atividade</p><h2 id="polar-integration-title">Polar Flow</h2>
			if !page.Enabled {
				<p>Esta integração ainda não está configurada neste ambiente.</p>
			} else if page.Connected || page.ReauthorizationRequired {
				<dl class="profile-summary"><div><dt>Estado</dt><dd>{ page.Status }</dd></div><div><dt>Última sincronização concluída</dt><dd>{ displayValue(page.LastSync) }</dd></div></dl>
				<p>A sincronização importa apenas exercícios recentes, zonas de frequência cardíaca, Training Load Pro e 28 dias de Cardio Load. Não importa rotas, amostras, sono, dados físicos nem identificadores de dispositivos.</p>
				if !page.Eligible {
					<p role="status">A inscrição num programa terminou. A sincronização está suspensa, mas ainda pode desligar a conta Polar.</p>
				}
				<div class="record-item__actions">
					if page.Eligible && page.Connected {
						<form method="post" action="/perfil/integracoes/polar/sincronizar">@page.Meta.CSRFField<button type="submit">Sincronizar agora</button></form>
					}
					if page.Eligible && page.ReauthorizationRequired {
						<form method="post" action="/perfil/integracoes/polar/ligar">@page.Meta.CSRFField<button type="submit">Voltar a ligar Polar</button></form>
					}
					<a class="action action--danger" href="/perfil/integracoes/polar/desligar">Desligar Polar</a>
				</div>
			} else if !page.Eligible {
				<p>A ligação está disponível para atletas adultos com uma inscrição ativa num programa do clube.</p>
			} else {
				<p>Ligue a sua conta para importar os últimos 30 dias de exercícios, zonas de frequência cardíaca e carga de treino disponibilizada pela Polar.</p>
				<p>Os exercícios, zonas de frequência cardíaca e dados de carga importados permanecem no MyCFC depois de desligar. Até existir a opção de eliminação prevista no trabalho #111, a eliminação deve ser pedida ao operador do MyCFC.</p>
				<form method="post" action="/perfil/integracoes/polar/ligar">@page.Meta.CSRFField<button type="submit">Ligar Polar</button></form>
			}
		</section>
	</div>
}

type PolarDisconnectPage struct { Meta components.PageMeta }
templ PolarDisconnect(page PolarDisconnectPage) {
	@components.Base(page.Meta, polarDisconnectContent(page))
}
templ polarDisconnectContent(page PolarDisconnectPage) {
	@components.TaskRoute(components.TaskSurfaceConfig{ID: "desligar-polar", TitleID: "polar-disconnect-title", Eyebrow: "Confirmação", Title: "Desligar Polar", Description: "A sincronização futura será interrompida.", Variant: "confirmation", ReturnURL: "/perfil/integracoes"}) {
		<p>As credenciais locais serão eliminadas. Os exercícios, zonas de frequência cardíaca e dados de carga já importados permanecem como evidência histórica no MyCFC.</p>
		<form method="post" action="/perfil/integracoes/polar/desligar">@page.Meta.CSRFField<input type="hidden" name="confirm_disconnect" value="yes"/><button class="action action--danger" type="submit">Desligar Polar</button></form>
	}
}
