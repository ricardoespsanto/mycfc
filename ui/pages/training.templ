package pages

import (
	"fmt"
	"github.com/cfcoimbra/mycfc/internal/validation"
	"github.com/cfcoimbra/mycfc/ui/components"
)

type TrainingChoice struct{ ID, Name string }
type TrainingSession struct {
	ID, Plan, Title, Detail, When, Modality, Outcome, Distance, DistanceKM, CancellationReason string
	ActualDuration, DurationMinutes, PerceivedEffort, RecoveryFeeling, PerceptionNote, FeedbackUpdatedAt string
	OutcomeVersion int
	Cancelled, PrescriptionAvailable bool
}
type ManagedTrainingSession struct{ ID, Title, Description, When, Modality, CancellationReason, CancelledAt, CancelledBy string; Cancelled, Editable bool }
type ManagedTrainingPlan struct {
	ID, Title, Description string
	Sessions               []ManagedTrainingSession
}
type TrainingPlanForm struct {
	Title, Description, ProgrammeID, TeamID string
	Errors                                  validation.FieldErrors
}
type TrainingSessionForm struct {
	ID, PlanID, Title, Description, StartsAt, EndsAt, ModalityID, ExpectedUpdatedAt string
	Editing, PlanLocked bool
	Errors                                                   validation.FieldErrors
}
type TrainingSessionEditPage struct {
	Meta components.PageMeta
	CSRFField templ.Component
	SessionID, Conflict, CancellationReason string
	CancellationErrors validation.FieldErrors
	Form TrainingSessionForm
	Plans, Modalities []TrainingChoice
}
type TrainingSessionCancelPage struct {
	Meta components.PageMeta
	SessionID, Title, When, ExpectedUpdatedAt, Conflict, CancellationReason string
	CancellationErrors validation.FieldErrors
	CSRFField templ.Component
}
type TrainingPage struct {
	Meta                                         components.PageMeta
	CSRFField                                    templ.Component
	Management, CanManage, StructuredAvailable   bool
	Success, Error                               string
	Sessions                                     []TrainingSession
	Calendar                                     BasicCalendarMonth
	ManagedPlans                                 []ManagedTrainingPlan
	ManagedPlansPreviousURL, ManagedPlansNextURL string
	Programmes, Teams, Modalities, Plans         []TrainingChoice
	PlanForm                                     TrainingPlanForm
	SessionForm                                  TrainingSessionForm
}

templ Training(page TrainingPage) {
	@components.Base(page.Meta, trainingContent(page))
}

templ trainingContent(page TrainingPage) {
	if page.Management {
		@components.PageHeader("Coordenação", "Treinos", "Organize planos e sessões para os grupos sob a sua responsabilidade.", trainingPageActions(page))
	} else {
		@components.PageHeader("Atividade", "Treinos", "Consulte as sessões do seu grupo e registe os respetivos resultados.", trainingPageActions(page))
	}
	@components.StatusMessage(page.Success, "success")
	@components.StatusMessage(page.Error, "error")
	if !page.Management {
	@BasicCalendar(page.Calendar, "Calendário de treinos", "Vista mensal das sessões carregadas nesta página.")
	<section class="module">
		@components.SectionHeading("Agenda", "As minhas sessões", "O trabalho previsto para o seu grupo e o respetivo estado.")
		if len(page.Sessions) == 0 {
			@components.EmptyState("Sem sessões disponíveis", "Quando o seu grupo tiver trabalho planeado, ele aparece aqui.")
		}
		if len(page.Sessions) > 0 {
			@components.RecordList("As minhas sessões") {
				for _, session := range page.Sessions {
					<li class="record-item record-item--stacked">
						<div class="record-item__copy">
							<h3>{ session.Plan }: { session.Title }</h3>
							<p class="record-meta">
								{ session.When }
								if session.Modality != "" {
									· { session.Modality }
								}
							</p>
							<p>{ session.Detail }</p>
							if session.PrescriptionAvailable {
								<p><a class="action action--quiet" href={ templ.SafeURL("/treinos/prescricoes/sessoes/" + session.ID) }>Abrir prescrição publicada</a></p>
							}
							if session.Cancelled {
								<div class="callout callout--warning" role="status"><strong>Sessão cancelada</strong><p>{ session.CancellationReason }</p></div>
							}
						</div>
						if session.Cancelled {
							<div class="record-item__actions">@components.Badge("Cancelada", "error")</div>
						} else if session.Outcome != "" {
							<div class="record-item__actions">
								@components.Badge(trainingOutcomeLabel(session.Outcome), trainingOutcomeTone(session.Outcome))
								if session.Outcome == "COMPLETED" {
									<p class="record-meta">
										if session.ActualDuration != "" {
											<span>Duração real: { session.ActualDuration }</span>
										}
										if session.Distance != "" {
											<span> · Distância real: { session.Distance }</span>
										}
										if session.PerceivedEffort != "" {
											<span> · Esforço percebido: { session.PerceivedEffort }/10</span>
										}
										if session.RecoveryFeeling != "" {
											<span> · Sensação geral: { trainingFeelingLabel(session.RecoveryFeeling) }</span>
										}
									</p>
									if session.PerceptionNote != "" {
										<p><strong>Nota do atleta:</strong> { session.PerceptionNote }</p>
									}
									if session.FeedbackUpdatedAt != "" {
										<small>Última atualização: { session.FeedbackUpdatedAt }</small>
									}
									<details class="inline-disclosure"><summary>Registar ou corrigir dados reais e perceção</summary>@trainingFeedbackForm(page, session, true)</details>
								}
							</div>
						} else {
							<div class="record-item__actions">
								<details class="inline-disclosure"><summary>Marcar concluída</summary><form class="form-layout" method="post" action="/treinos/sessoes/resultados">@page.CSRFField
	<input type="hidden" name="session_id" value={ session.ID }/><input type="hidden" name="status" value="COMPLETED"/>@trainingFeedbackFields(session, false)<button type="submit">Concluir sessão</button></form></details>
								<form method="post" action="/treinos/sessoes/resultados">@page.CSRFField
<input type="hidden" name="session_id" value={ session.ID }/><input type="hidden" name="status" value="MISSED"/><button class="action action--secondary" type="submit">Não realizada</button></form>
							</div>
							<details class="inline-disclosure record-item__details">
								<summary>Registar sessão de substituição</summary>
								<form class="form-layout" method="post" action="/treinos/sessoes/resultados">
									@page.CSRFField
									<input type="hidden" name="session_id" value={ session.ID }/><input type="hidden" name="status" value="REPLACED"/>@components.FieldLabel("replacement-session-"+session.ID, "Sessão de substituição", true)
									<select id={ "replacement-session-" + session.ID } name="replacement_session_id" required>
										<option value="">Selecione</option>
										for _, replacement := range page.Sessions {
										if replacement.ID != session.ID && !replacement.Cancelled {
												<option value={ replacement.ID }>{ replacement.Plan }: { replacement.Title } ({ replacement.When })</option>
											}
										}
									</select>@components.FieldLabel("replacement-reason-"+session.ID, "Motivo", true)
									<input id={ "replacement-reason-" + session.ID } name="replacement_reason" minlength="2" maxlength="300" required/>@components.FormActions("/treinos") {
	<button type="submit">Registar substituição</button>
}

									</form>
							</details>
						}
					</li>
				}
			}
		}
	</section>
	}
	if page.Management {
		@trainingAuthoring(page)
	}
}

templ trainingFeedbackForm(page TrainingPage, session TrainingSession, correction bool) {
	<form class="form-layout" method="post" action="/treinos/sessoes/feedback">@page.CSRFField
		<input type="hidden" name="session_id" value={ session.ID }/>
		<input type="hidden" name="expected_version" value={ fmt.Sprintf("%d", session.OutcomeVersion) }/>
		@trainingFeedbackFields(session, correction)
		@components.FormActions("/treinos") {
			<button type="submit">Guardar dados reais e perceção</button>
		}
	</form>
}

templ trainingFeedbackFields(session TrainingSession, correction bool) {
	@components.FieldLabel("duration-"+session.ID, "Duração real (minutos)", false)
	<input id={ "duration-"+session.ID } name="actual_duration_minutes" type="number" min="1" max="1440" step="1" inputmode="numeric" value={ session.DurationMinutes }/>
	@components.FieldLabel("distance-"+session.ID, "Distância real (km)", false)
	<input id={ "distance-"+session.ID } name="distance_km" type="number" min="0.01" max="200" step="0.01" inputmode="decimal" value={ session.DistanceKM } aria-describedby={ "distance-help-"+session.ID }/>
	@components.FieldHelp("distance-help-"+session.ID, "Opcional para sessões com distância; deixe vazio para remover numa correção.")
	@components.FieldLabel("effort-"+session.ID, "Esforço percebido (0–10)", false)
	<select id={ "effort-"+session.ID } name="perceived_exertion">
		<option value="">Não responder</option>
		for _, option := range []struct{ Value, Label string }{{"0", "0 — repouso"}, {"1", "1 — muito leve"}, {"2", "2 — leve"}, {"3", "3 — moderado"}, {"4", "4"}, {"5", "5 — intenso"}, {"6", "6"}, {"7", "7 — muito intenso"}, {"8", "8"}, {"9", "9 — quase máximo"}, {"10", "10 — máximo"}} {
			<option value={ option.Value } selected?={ session.PerceivedEffort == option.Value }>{ option.Label }</option>
		}
	</select>
	@components.FieldLabel("feeling-"+session.ID, "Como se sentiu no conjunto? (1–5)", false)
	<select id={ "feeling-"+session.ID } name="recovery_feeling">
		<option value="">Não responder</option>
		for _, option := range []struct{ Value, Label string }{{"1", "1 — muito mal"}, {"2", "2 — mal"}, {"3", "3 — razoavelmente"}, {"4", "4 — bem"}, {"5", "5 — muito bem"}} {
			<option value={ option.Value } selected?={ session.RecoveryFeeling == option.Value }>{ option.Label }</option>
		}
	</select>
	@components.FieldLabel("perception-note-"+session.ID, "Nota sobre a sessão (opcional)", false)
	<textarea id={ "perception-note-"+session.ID } name="perception_note" maxlength="500" aria-describedby={ "perception-help-"+session.ID }>{ session.PerceptionNote }</textarea>
	@components.FieldHelp("perception-help-"+session.ID, "A perceção é do atleta. Pode ser lida pelo treinador atualmente responsável, pelo tutor atual enquanto o atleta for menor e por administradores; não gera diagnósticos nem altera a prescrição.")
}

func trainingFeelingLabel(value string) string {
	switch value {
	case "1":
		return "muito mal"
	case "2":
		return "mal"
	case "3":
		return "razoavelmente"
	case "4":
		return "bem"
	case "5":
		return "muito bem"
	default:
		return "não indicada"
	}
}

templ trainingAuthoring(page TrainingPage) {
	<section id="gerir-treinos" class="module">
			<section>
				@components.SectionHeading("", "Planos e sessões", "Âmbitos e sessões sob a sua responsabilidade.")
				if len(page.ManagedPlans) == 0 {
					@components.EmptyState("Sem planos no seu âmbito", "Crie o primeiro plano para começar a organizar sessões.")
				}
				if len(page.ManagedPlans) > 0 {
					@components.RecordList("Planos geridos") {
						for _, plan := range page.ManagedPlans {
							<li class="record-item record-item--stacked">
								<div class="record-item__copy">
									<h3>{ plan.Title }</h3>
									<p>{ plan.Description }</p>
									if len(plan.Sessions) == 0 {
										<p class="record-meta">Ainda sem sessões.</p>
									}
									for _, session := range plan.Sessions {
										<div class="nested-record">
											<h4>{ session.Title }</h4>
											<p class="record-meta">
												{ session.When }
												if session.Modality != "" {
													· { session.Modality }
												}
											</p>
											<p>{ session.Description }</p>
											if session.Cancelled {
												<div class="callout callout--warning" role="status"><strong>Sessão cancelada</strong><p>{ session.CancellationReason }</p>
													if session.CancelledAt != "" {
														<small>Cancelada em { session.CancelledAt } por { session.CancelledBy }.</small>
													}
												</div>
											} else if session.Editable {
												<p><a class="action action--secondary" href={ templ.SafeURL("/admin/treinos/sessoes/" + session.ID + "/editar") }>Editar sessão</a></p>
											}
										</div>
									}
								</div>
							</li>
						}
					}
				}
				if page.ManagedPlansPreviousURL != "" || page.ManagedPlansNextURL != "" {
					<nav class="pagination" aria-label="Paginação de planos geridos">
						if page.ManagedPlansPreviousURL != "" {
							<a href={ templ.SafeURL(page.ManagedPlansPreviousURL) }>Anterior</a>
						}
						if page.ManagedPlansNextURL != "" {
							<a href={ templ.SafeURL(page.ManagedPlansNextURL) }>Seguinte</a>
						}
					</nav>
				}
			</section>
			@trainingPlanForm(page)
			@trainingSessionForm(page)
	</section>
}

templ trainingPlanForm(page TrainingPage) {
	@components.TaskDialog(trainingPlanTaskConfig()) {
		@trainingPlanTaskForm(page)
	}
	@components.DiscardConfirmation()
}

templ TrainingPlanCreateView(page TrainingPage) { @components.Base(page.Meta, trainingPlanCreateContent(page)) }

templ trainingPlanCreateContent(page TrainingPage) {
	<div class="task-route-page">@components.TaskRoute(trainingPlanTaskConfig()) { @trainingPlanTaskForm(page) }</div>
}

templ trainingPlanTaskForm(page TrainingPage) {
	<div class="task-form">@components.StatusMessage(page.Error, "error")
		@components.ErrorSummary(components.FieldErrorsFor(map[string]string(page.PlanForm.Errors), []components.FieldErrorRef{{Key: "title", Field: "training-plan-title"}, {Key: "description", Field: "training-plan-description"}, {Key: "scope", Field: "training-plan-scope"}}))
		<form class="form-layout" method="post" action="/admin/treinos/planos" data-task-form>@page.CSRFField
@components.RequiredNote()
@components.FieldLabel("training-plan-title", "Título", true)
			<input id="training-plan-title" name="title" value={ page.PlanForm.Title } required data-task-initial-focus autofocus?={ len(page.PlanForm.Errors) == 0 } aria-invalid?={ page.PlanForm.Errors["title"] != "" } aria-describedby="title-error"/>@components.FieldErrorMessage("title", page.PlanForm.Errors["title"])
@components.FieldLabel("training-plan-description", "Descrição (opcional)", false)
<textarea id="training-plan-description" name="description" aria-invalid?={ page.PlanForm.Errors["description"] != "" } aria-describedby="description-error">{ page.PlanForm.Description }</textarea>@components.FieldErrorMessage("description", page.PlanForm.Errors["description"])
<fieldset id="training-plan-scope"><legend>Âmbito</legend>@trainingScopeChoices(page, "training-plan", page.PlanForm.ProgrammeID, page.PlanForm.TeamID)
</fieldset>@components.FieldErrorMessage("scope", page.PlanForm.Errors["scope"])
@components.TaskActions("/admin/treinos") {
	<button class="action action--primary" type="submit" data-task-submit>Criar plano</button>
}
		</form></div>
}

templ trainingSessionForm(page TrainingPage) {
	@components.TaskDialog(trainingSessionTaskConfig()) {
		@trainingSessionTaskForm(page)
	}
	@components.DiscardConfirmation()
}

templ TrainingSessionCreateView(page TrainingPage) { @components.Base(page.Meta, trainingSessionCreateContent(page)) }

templ trainingSessionCreateContent(page TrainingPage) {
	<div class="task-route-page">@components.TaskRoute(trainingSessionTaskConfig()) { @trainingSessionTaskForm(page) }</div>
}

templ trainingSessionTaskForm(page TrainingPage) {
	<div class="task-form">@components.StatusMessage(page.Error, "error")
		@components.ErrorSummary(components.FieldErrorsFor(map[string]string(page.SessionForm.Errors), []components.FieldErrorRef{{Key: "plan_id", Field: "training-session-plan"}, {Key: "title", Field: "training-session-title"}, {Key: "description", Field: "training-session-description"}, {Key: "starts_at", Field: "training-session-start"}, {Key: "ends_at", Field: "training-session-end"}, {Key: "modality_id", Field: "training-session-modality"}}))
		<form class="form-layout" method="post" action="/admin/treinos/sessoes" data-task-form>
			@page.CSRFField
			@components.RequiredNote()
			@components.FieldLabel("training-session-plan", "Plano", true)
			<select id="training-session-plan" name="plan_id" required aria-invalid?={ page.SessionForm.Errors["plan_id"] != "" } aria-describedby="plan_id-error">
				<option value="">Selecione</option>
				for _, item := range page.Plans {
					<option value={ item.ID } selected?={ item.ID == page.SessionForm.PlanID }>{ item.Name }</option>
				}
			</select>@components.FieldErrorMessage("plan_id", page.SessionForm.Errors["plan_id"])
			@components.FieldLabel("training-session-title", "Título", true)
			<input id="training-session-title" name="title" value={ page.SessionForm.Title } required data-task-initial-focus autofocus?={ len(page.SessionForm.Errors) == 0 } aria-invalid?={ page.SessionForm.Errors["title"] != "" } aria-describedby="title-error"/>@components.FieldErrorMessage("title", page.SessionForm.Errors["title"])
			@components.FieldLabel("training-session-description", "Descrição (opcional)", false)
			<textarea id="training-session-description" name="description" aria-invalid?={ page.SessionForm.Errors["description"] != "" } aria-describedby="description-error">{ page.SessionForm.Description }</textarea>@components.FieldErrorMessage("description", page.SessionForm.Errors["description"])
			@components.FieldLabel("training-session-start", "Início", true)
			<input id="training-session-start" name="starts_at" type="datetime-local" value={ page.SessionForm.StartsAt } required aria-invalid?={ page.SessionForm.Errors["starts_at"] != "" } aria-describedby="starts_at-error"/>@components.FieldErrorMessage("starts_at", page.SessionForm.Errors["starts_at"])
			@components.FieldLabel("training-session-end", "Fim", true)
			<input id="training-session-end" name="ends_at" type="datetime-local" value={ page.SessionForm.EndsAt } required aria-invalid?={ page.SessionForm.Errors["ends_at"] != "" } aria-describedby="ends_at-error"/>@components.FieldErrorMessage("ends_at", page.SessionForm.Errors["ends_at"])
			@components.FieldLabel("training-session-modality", "Modalidade (opcional)", false)
			<select id="training-session-modality" name="modality_id" aria-invalid?={ page.SessionForm.Errors["modality_id"] != "" } aria-describedby="modality_id-error">
				<option value="">Sem modalidade</option>
				for _, item := range page.Modalities {
					<option value={ item.ID } selected?={ item.ID == page.SessionForm.ModalityID }>{ item.Name }</option>
				}
			</select>@components.FieldErrorMessage("modality_id", page.SessionForm.Errors["modality_id"])
			@components.TaskActions("/admin/treinos") {
				<button class="action action--primary" type="submit" data-task-submit>Criar sessão</button>
			}
		</form>
	</div>
}

templ TrainingSessionEdit(page TrainingSessionEditPage) {
	@components.Base(page.Meta, trainingSessionEditContent(page))
}

templ trainingSessionEditContent(page TrainingSessionEditPage) {
	@components.PageHeader("Coordenação · Treinos", "Editar sessão", page.Form.Title, []components.PageAction{{Label: "Voltar aos treinos", Href: "/admin/treinos", Variant: "quiet"}})
	@components.StatusMessage(page.Conflict, "error")
	<section class="module">
		@components.ErrorSummary(components.FieldErrorsFor(map[string]string(page.Form.Errors), []components.FieldErrorRef{{Key: "state", Field: "training-session-edit-title"}, {Key: "plan_id", Field: "training-session-edit-plan"}, {Key: "title", Field: "training-session-edit-title"}, {Key: "description", Field: "training-session-edit-description"}, {Key: "starts_at", Field: "training-session-edit-start"}, {Key: "ends_at", Field: "training-session-edit-end"}, {Key: "modality_id", Field: "training-session-edit-modality"}}))
		<form class="form-layout" method="post" action={ templ.SafeURL("/admin/treinos/sessoes/" + page.SessionID) }>@page.CSRFField
			<input type="hidden" name="expected_updated_at" value={ page.Form.ExpectedUpdatedAt }/>
			@components.RequiredNote()
			@components.FieldLabel("training-session-edit-plan", "Plano", true)
			<select id="training-session-edit-plan" name="plan_id" required disabled?={ page.Form.PlanLocked }>
				for _, item := range page.Plans {
					<option value={ item.ID } selected?={ item.ID == page.Form.PlanID }>{ item.Name }</option>
				}
			</select>
			if page.Form.PlanLocked {
				<input type="hidden" name="plan_id" value={ page.Form.PlanID }/><p class="field-help">O plano não pode ser alterado depois do primeiro resultado.</p>
			}
			@components.FieldErrorMessage("plan_id", page.Form.Errors["plan_id"])
			@components.FieldLabel("training-session-edit-title", "Título", true)<input id="training-session-edit-title" name="title" value={ page.Form.Title } required/>@components.FieldErrorMessage("title", page.Form.Errors["title"])
			@components.FieldLabel("training-session-edit-description", "Descrição (opcional)", false)<textarea id="training-session-edit-description" name="description">{ page.Form.Description }</textarea>@components.FieldErrorMessage("description", page.Form.Errors["description"])
			@components.FieldLabel("training-session-edit-start", "Início", true)<input id="training-session-edit-start" name="starts_at" type="datetime-local" value={ page.Form.StartsAt } required/>@components.FieldErrorMessage("starts_at", page.Form.Errors["starts_at"])
			@components.FieldLabel("training-session-edit-end", "Fim", true)<input id="training-session-edit-end" name="ends_at" type="datetime-local" value={ page.Form.EndsAt } required/>@components.FieldErrorMessage("ends_at", page.Form.Errors["ends_at"])
			@components.FieldLabel("training-session-edit-modality", "Modalidade (opcional)", false)<select id="training-session-edit-modality" name="modality_id"><option value="">Sem modalidade</option>
				for _, item := range page.Modalities {
					<option value={ item.ID } selected?={ item.ID == page.Form.ModalityID }>{ item.Name }</option>
				}
			</select>@components.FieldErrorMessage("modality_id", page.Form.Errors["modality_id"])
			@components.FormActions("/admin/treinos") { <button type="submit">Guardar alterações</button> }
		</form>
	</section>
	<section class="module destructive-region" aria-labelledby="cancel-training-session-title">
		<h2 id="cancel-training-session-title">Cancelar sessão</h2><p>A sessão e os resultados existentes continuam visíveis. Esta ação não pode ser anulada.</p>
		<a class="action action--danger" href={ templ.SafeURL("/admin/treinos/sessoes/" + page.SessionID + "/cancelar") }>Cancelar sessão</a>
	</section>
}

templ TrainingSessionCancel(page TrainingSessionCancelPage) { @components.Base(page.Meta, trainingSessionCancelContent(page)) }
templ trainingSessionCancelContent(page TrainingSessionCancelPage) {
	<div class="task-route-page">
		@components.TaskRoute(components.TaskSurfaceConfig{ID: "cancelar-sessao", TitleID: "cancel-training-session-title", Eyebrow: "Confirmação", Title: "Cancelar sessão", Description: page.Title + " · " + page.When, Variant: "confirmation", ReturnURL: "/admin/treinos"}) {
			<form class="form-layout task-form destructive-region" method="post" action={ templ.SafeURL("/admin/treinos/sessoes/" + page.SessionID + "/cancelar") } data-task-form>
				@page.CSRFField<input type="hidden" name="expected_updated_at" value={ page.ExpectedUpdatedAt }/>
				@components.TaskConflict("A sessão foi alterada", page.Conflict, "", "/admin/treinos", "Voltar aos treinos")
				<p>A sessão mantém-se legível, incluindo resultados existentes, mas deixa de aceitar novas ações.</p>
				@components.ErrorSummary(components.FieldErrorsFor(map[string]string(page.CancellationErrors), []components.FieldErrorRef{{Key: "cancellation_reason", Field: "training-session-cancellation-reason"}, {Key: "confirm_cancellation", Field: "confirm-training-session-cancellation"}}))
				@components.FieldLabel("training-session-cancellation-reason", "Motivo", true)<textarea id="training-session-cancellation-reason" name="cancellation_reason" minlength="2" maxlength="500" required>{ page.CancellationReason }</textarea>@components.FieldErrorMessage("cancellation_reason", page.CancellationErrors["cancellation_reason"])
				<label for="confirm-training-session-cancellation"><input id="confirm-training-session-cancellation" type="checkbox" name="confirm_cancellation" value="yes" required/> Confirmo que pretendo cancelar definitivamente a sessão { page.Title }.</label>@components.FieldErrorMessage("confirm_cancellation", page.CancellationErrors["confirm_cancellation"])
				@components.TaskActions("/admin/treinos") {
					if page.Conflict == "" {
						<button class="action action--danger" type="submit" data-task-submit>Cancelar sessão</button>
					}
				}
			</form>
		}
	</div>
}

templ trainingScopeChoices(page TrainingPage, prefix, programmeID, teamID string) {
	@components.FieldLabel(prefix+"-team", "Equipa (preferencial)", false)
	<select id={ prefix + "-team" } name="team_id">
		<option value="">Sem equipa</option>
		for _, item := range page.Teams {
			<option value={ item.ID } selected?={ item.ID == teamID }>{ item.Name }</option>
		}
	</select>@components.FieldLabel(prefix+"-programme", "Programa", false)
	<select id={ prefix + "-programme" } name="programme_id">
		<option value="">Sem programa</option>
		for _, item := range page.Programmes {
			<option value={ item.ID } selected?={ item.ID == programmeID }>{ item.Name }</option>
		}
	</select>
}

func trainingOutcomeLabel(status string) string {
	switch status {
	case "COMPLETED":
		return "Concluída"
	case "MISSED":
		return "Não realizada"
	case "REPLACED":
		return "Substituída"
	default:
		return status
	}
}

func trainingOutcomeTone(status string) string {
	switch status {
	case "COMPLETED":
		return "success"
	case "MISSED":
		return "error"
	case "REPLACED":
		return "selected"
	default:
		return "warning"
	}
}

func trainingPageActions(page TrainingPage) []components.PageAction {
	if page.Management && page.CanManage {
		actions := []components.PageAction{{Label: "Criar plano", Href: "/admin/treinos/planos/criar", Variant: "primary", TaskID: "criar-plano"}, {Label: "Criar sessão", Href: "/admin/treinos/sessoes/criar", Variant: "secondary", TaskID: "criar-sessao"}}
		if page.StructuredAvailable {
			actions = append(actions, components.PageAction{Label: "Planeamento semanal", Href: "/admin/treinos/estruturados", Variant: "secondary"})
		}
		return actions
	}
	if !page.Management && page.StructuredAvailable {
		return []components.PageAction{{Label: "Planeamento semanal", Href: "/treinos/estruturados", Variant: "secondary"}}
	}
	return nil
}

func trainingPlanTaskConfig() components.TaskSurfaceConfig {
	return components.TaskSurfaceConfig{ID: "criar-plano", TitleID: "training-plan-authoring-title", Eyebrow: "Coordenação", Title: "Criar plano", Description: "Defina o plano e o respetivo âmbito.", Variant: "sheet", URL: "/admin/treinos/planos/criar", ReturnURL: "/admin/treinos"}
}

func trainingSessionTaskConfig() components.TaskSurfaceConfig {
	return components.TaskSurfaceConfig{ID: "criar-sessao", TitleID: "training-session-authoring-title", Eyebrow: "Coordenação", Title: "Criar sessão", Description: "Associe uma sessão a um plano existente.", Variant: "sheet", URL: "/admin/treinos/sessoes/criar", ReturnURL: "/admin/treinos"}
}
