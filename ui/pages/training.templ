package pages

import "github.com/cfcoimbra/mycfc/ui/components"

type TrainingChoice struct { ID, Name string }
type TrainingSession struct { ID, Plan, Title, Detail, When, Modality, Outcome string }
type ManagedTrainingSession struct { Title, Description, When, Modality string }
type ManagedTrainingPlan struct { ID, Title, Description string; Sessions []ManagedTrainingSession }
type CompetitionDocument struct { Title, URL, Source, ReviewedOn, Context string }
type TrainingPage struct { Meta components.PageMeta; CSRFField templ.Component; CanManage bool; Sessions []TrainingSession; Documents []CompetitionDocument; ManagedPlans []ManagedTrainingPlan; ManagedPlansPreviousURL, ManagedPlansNextURL string; Programmes, Teams, Modalities, Events, Plans []TrainingChoice }

templ Training(page TrainingPage) { @components.Base(page.Meta, trainingContent(page)) }
templ trainingContent(page TrainingPage) {
    <section class="dashboard-hero"><p class="eyebrow">MyCFC</p><h1>Treinos e competição</h1><p>Consulte as sessões do seu grupo e os documentos oficiais aplicáveis.</p></section>
    <section class="dashboard-card"><h2>As minhas sessões</h2>
        if len(page.Sessions) == 0 {
            <p class="empty-state">Ainda não tem sessões disponíveis para o seu grupo.</p>
        }
        for _, session := range page.Sessions {
            <article><h3>{ session.Plan }: { session.Title }</h3><p>{ session.When }
                if session.Modality != "" {
                    · { session.Modality }
                }
            </p><p>{ session.Detail }</p>
            if session.Outcome != "" {
                <p><strong>{ trainingOutcomeLabel(session.Outcome) }</strong></p>
            } else {
                <form class="inline-action" method="post" action="/treinos/sessoes/resultados">@page.CSRFField<input type="hidden" name="session_id" value={ session.ID }/><input type="hidden" name="status" value="COMPLETED"/><button type="submit">Marcar como concluída</button></form>
                <form class="inline-action" method="post" action="/treinos/sessoes/resultados">@page.CSRFField<input type="hidden" name="session_id" value={ session.ID }/><input type="hidden" name="status" value="MISSED"/><button type="submit">Marcar como não realizada</button></form>
                <details class="inline-disclosure"><summary>Registar substituição</summary><form class="form-layout" method="post" action="/treinos/sessoes/resultados">@page.CSRFField<input type="hidden" name="session_id" value={ session.ID }/><input type="hidden" name="status" value="REPLACED"/><label>Sessão de substituição <select name="replacement_session_id" required><option value="">Selecione</option>
                    for _, replacement := range page.Sessions {
                        if replacement.ID != session.ID {
                            <option value={ replacement.ID }>{ replacement.Plan }: { replacement.Title } ({ replacement.When })</option>
                        }
                    }
                </select></label><label>Motivo <input name="replacement_reason" minlength="2" maxlength="300" required/></label><button type="submit">Registar substituição</button></form></details>
            }
            </article>
        }
    </section>
    <section class="dashboard-card"><h2>Cadernos de prova e documentos oficiais</h2>
        if len(page.Documents) == 0 {
            <p class="empty-state">Não existem documentos aplicáveis.</p>
        }
        for _, document := range page.Documents {
            <article><h3><a href={ document.URL } target="_blank" rel="noopener noreferrer">{ document.Title }</a></h3><p>{ document.Context }</p><p>Fonte: { document.Source } · Revisto em: { document.ReviewedOn }</p></article>
        }
    </section>
    if page.CanManage {
        @trainingAuthoring(page)
    }
}
templ trainingAuthoring(page TrainingPage) {
	<details class="dashboard-card disclosure-card"><summary><span class="disclosure-card__title">Gerir treinos</span><span class="disclosure-card__summary">Consulte planos e crie sessões ou documentos.</span></summary><div class="disclosure-card__content"><section><h2>Planos que gere</h2>
        if len(page.ManagedPlans) == 0 {
            <p class="empty-state">Ainda não existem planos no seu âmbito.</p>
        }
        for _, plan := range page.ManagedPlans {
            <article><h3>{ plan.Title }</h3><p>{ plan.Description }</p>
                if len(plan.Sessions) == 0 {
                    <p class="empty-state">Este plano ainda não tem sessões.</p>
                }
                for _, session := range plan.Sessions {
                    <div><h4>{ session.Title }</h4><p>{ session.When }
                        if session.Modality != "" {
                            · { session.Modality }
                        }
                    </p><p>{ session.Description }</p></div>
                }
            </article>
        }
        if page.ManagedPlansPreviousURL != "" || page.ManagedPlansNextURL != "" {
            <nav class="pagination" aria-label="Paginação de planos geridos">
                if page.ManagedPlansPreviousURL != "" {
                    <a href={ templ.SafeURL(page.ManagedPlansPreviousURL) }>Anterior</a>
                }
                if page.ManagedPlansNextURL != "" {
                    <a href={ templ.SafeURL(page.ManagedPlansNextURL) }>Seguinte</a>
                }
            </nav>
        }
    </section>
    <details class="inline-disclosure"><summary>Criar plano</summary><form class="form-layout" method="post" action="/treinos/planos">@page.CSRFField<label>Título <input name="title" required/></label><label>Descrição <textarea name="description"></textarea></label>@trainingScopeChoices(page)<button type="submit">Criar plano</button></form></details>
    <details class="inline-disclosure"><summary>Criar sessão</summary><form class="form-layout" method="post" action="/treinos/sessoes">@page.CSRFField
        <label>Plano <select name="plan_id" required><option value="">Selecione</option>
            for _, item := range page.Plans {
                <option value={ item.ID }>{ item.Name }</option>
            }
        </select></label><label>Título <input name="title" required/></label><label>Descrição <textarea name="description"></textarea></label><label>Início <input name="starts_at" type="datetime-local" required/></label><label>Fim <input name="ends_at" type="datetime-local" required/></label><label>Modalidade <select name="modality_id"><option value="">Sem modalidade</option>
            for _, item := range page.Modalities {
                <option value={ item.ID }>{ item.Name }</option>
            }
        </select></label><button type="submit">Criar sessão</button></form></details>
    <details class="inline-disclosure"><summary>Publicar documento de competição</summary><form class="form-layout" method="post" action="/treinos/documentos">@page.CSRFField<label>Título <input name="title" required/></label><label>Ligação HTTPS <input name="url" type="url" required/></label><label>Fonte oficial <input name="source" required/></label><label>Revisto em <input name="reviewed_on" type="date" required/></label><label>Evento <select name="event_id"><option value="">Sem evento</option>
        for _, item := range page.Events {
            <option value={ item.ID }>{ item.Name }</option>
        }
    </select></label><label>Modalidade <select name="modality_id"><option value="">Sem modalidade</option>
        for _, item := range page.Modalities {
            <option value={ item.ID }>{ item.Name }</option>
        }
    </select></label><p>Selecione pelo menos um contexto. A modalidade exige programa ou equipa; um documento só de evento usa o público desse evento.</p>@trainingScopeChoices(page)<button type="submit">Publicar documento</button></form></details></div></details>
}
templ trainingScopeChoices(page TrainingPage) { <label>Equipa (preferencial) <select name="team_id"><option value="">Sem equipa</option>
    for _, item := range page.Teams {
        <option value={ item.ID }>{ item.Name }</option>
    }
</select></label><label>Programa <select name="programme_id"><option value="">Sem programa</option>
    for _, item := range page.Programmes {
        <option value={ item.ID }>{ item.Name }</option>
    }
</select></label> }

func trainingOutcomeLabel(status string) string {
	switch status {
	case "COMPLETED": return "Concluída"
	case "MISSED": return "Não realizada"
	case "REPLACED": return "Substituída"
	default: return status
	}
}
