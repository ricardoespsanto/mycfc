[Unit]
Description=Poll for one attested MyCFC privacy production operation
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
TimeoutStartSec=50min
ExecStart=/opt/mycfc/deployment/run-with-cloudwatch-logs.sh /opt/mycfc/deployment/privacy-production-operation-agent.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/mycfc/release-aws -/etc/mycfc/backup-aws -/etc/mycfc/backup-auth -/etc/mycfc/backup-cleanup-aws -/etc/mycfc/privacy-production-operations -/etc/mycfc/privacy-restore -/etc/mycfc/privacy-activation -/etc/mycfc/privacy-activation.env -/etc/mycfc/privacy-activation-disable.env -/etc/mycfc/privacy-retention.env -/etc/mycfc/privacy-retention -/etc/mycfc/privacy-worker -/etc/mycfc/privacy-worker.env -/etc/mycfc/privacy-acceptance.env -/etc/mycfc/privacy-acceptance -/etc/mycfc/guardian-activation.env -/etc/mycfc/guardian-release-bind.env /opt/mycfc/deployment
ReadWritePaths=/etc/mycfc /etc/mycfc/deployment -/etc/mycfc/legacy-media-purge /run /var/lib/mycfc/privacy-operations -/var/lib/mycfc/legacy-media-purge /run/docker.sock
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
