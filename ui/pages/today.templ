package pages

import "fmt"
import "github.com/cfcoimbra/mycfc/ui/components"

type TodayEvent struct { ID, Title, When string }
type TodayDependent struct { Name string; HasAccess bool }
type TodayOperation struct { Label, Detail string }
type TodayShortcut struct { Label, Detail, Path string }
type TodayLeaderboardRow struct { Position int64; Name, Distance string }
type TodayLeaderboard struct { Period string; Rows []TodayLeaderboardRow; Current *TodayLeaderboardRow; IsAthlete, Visible bool }
type TodayPage struct {
	Meta components.PageMeta
	Name string
	EventBasePath string
	NextEvent *TodayEvent
	Events []TodayEvent
	Dependents []TodayDependent
	Operations []TodayOperation
	Shortcuts []TodayShortcut
	Leaderboard TodayLeaderboard
	Success string
	ShowShortcuts bool
}

templ Today(page TodayPage) { @components.Base(page.Meta, todayContent(page)) }

templ todayContent(page TodayPage) {
	<section class={ todayHeroClass(page) }><div><h1>Olá, { firstName(page.Name) }</h1><p>O que merece a sua atenção agora, reunido num só lugar.</p></div>
		if page.NextEvent != nil {
			<a class="today-next" href={ todayEventPath(page, page.NextEvent.ID) }><span>A seguir</span><strong>{ page.NextEvent.Title }</strong><small>{ page.NextEvent.When }</small></a>
		}
		</section>
		@components.StatusMessage(page.Success, "success")
		<div class="today-grid">
	<section class="today-module today-module--agenda"><header><div><h2>Agenda de hoje</h2></div><a href={ todayEventsPath(page) }>Ver agenda</a></header>
		if len(page.Events) == 0 {
			<p class="today-empty">Não existem eventos para hoje. Consulte a agenda para preparar os próximos dias.</p>
		}
		if len(page.Events) > 0 {
			<ul class="today-list">
				for _, event := range page.Events {
					<li><span>{ event.When }</span><a href={ todayEventPath(page, event.ID) }>{ event.Title }</a></li>
				}
			</ul>
		}
		</section>
		<section id="leaderboard" class="today-module today-module--leaderboard"><header><div><h2>Classificação do clube</h2></div></header>
			<nav class="leaderboard-tabs" aria-label="Período da classificação">
				@leaderboardTab("week", "Semana", page.Leaderboard.Period)
				@leaderboardTab("month", "Mês", page.Leaderboard.Period)
				@leaderboardTab("year", "Ano", page.Leaderboard.Period)
				@leaderboardTab("all", "Todo o tempo", page.Leaderboard.Period)
			</nav>
			if len(page.Leaderboard.Rows) == 0 {
				<p class="today-empty">Ainda não existem quilómetros registados neste período.</p>
			} else {
				<ol class="leaderboard-list">
					for _, row := range page.Leaderboard.Rows {
						<li><span aria-label={ "Posição "+fmt.Sprint(row.Position) }>{ fmt.Sprint(row.Position) }</span><strong>{ row.Name }</strong><b>{ row.Distance }</b></li>
					}
				</ol>
			}
			if page.Leaderboard.Current != nil {
				<div class="leaderboard-current"><span>A sua posição</span><strong>{ fmt.Sprint(page.Leaderboard.Current.Position) } · { page.Leaderboard.Current.Name }</strong><b>{ page.Leaderboard.Current.Distance }</b></div>
			}
			if page.Leaderboard.IsAthlete {
				<form class="leaderboard-privacy" method="post" action="/leaderboard/privacy">@page.Meta.CSRFField<input type="hidden" name="leaderboard_period" value={ page.Leaderboard.Period }/><label><input name="leaderboard_visible" type="checkbox" checked?={ page.Leaderboard.Visible }/> Mostrar os meus quilómetros na classificação</label><button type="submit">Guardar privacidade</button></form>
				if !page.Leaderboard.Visible {
					<p class="today-empty">Os seus totais estão privados e não entram na classificação.</p>
				}
			}
		</section>
	if len(page.Dependents) > 0 {
		<section class="today-module"><header><div><h2>Menores a cargo</h2></div><a class="action action--quiet" href="/dashboard/guardian">Gerir</a></header><ul class="today-list">
			for _, dependent := range page.Dependents {
				<li><strong>{ dependent.Name }</strong>
						if dependent.HasAccess {
							<span>Acesso ativo</span>
						} else {
							<span>Sem acesso próprio</span>
						}
				</li>
			}
		</ul></section>
	}
	if len(page.Operations) > 0 {
		<section class="today-module today-module--attention"><header><div><h2>Requer atenção</h2></div><a class="action action--quiet" href="/admin/fleet">Abrir frota</a></header><ul class="today-list">
			for _, item := range page.Operations {
				<li><strong>{ item.Label }</strong><span>{ item.Detail }</span></li>
			}
		</ul></section>
	}
		if page.ShowShortcuts {
			<section class="today-module today-module--shortcuts"><header><div><h2>Continuar no MyCFC</h2></div></header><div class="today-shortcuts">
				for _, item := range page.Shortcuts {
					<a href={ item.Path }><strong>{ item.Label }</strong><span>{ item.Detail }</span></a>
				}
			</div></section>
		}
	</div>
}

func firstName(name string) string { for i, r := range name { if r == ' ' { return name[:i] } }; return name }

func todayHeroClass(page TodayPage) string { if page.NextEvent != nil { return "today-hero today-hero--has-next" }; return "today-hero" }

func todayEventsPath(page TodayPage) string { if page.EventBasePath != "" { return page.EventBasePath }; return "/events" }
func todayEventPath(page TodayPage, id string) string { return todayEventsPath(page) + "/" + id }

templ leaderboardTab(period, label, selected string) {
	if period == selected {
		<a href={ templ.SafeURL("/today?leaderboard_period="+period+"#leaderboard") } aria-current="page">{ label }</a>
	} else {
		<a href={ templ.SafeURL("/today?leaderboard_period="+period+"#leaderboard") }>{ label }</a>
	}
}
