package pages

import "github.com/cfcoimbra/mycfc/internal/validation"
import "github.com/cfcoimbra/mycfc/ui/components"

type RegistrationPage struct {
	Meta                                components.PageMeta
	Name, Email, DateOfBirth, Role, Squad string
	Errors                       validation.FieldErrors
	CSRFField                    templ.Component
}

templ Registration(page RegistrationPage) {
	@components.Base(page.Meta, registrationContent(page))
}

templ registrationContent(page RegistrationPage) {
	<section class="auth-card" aria-labelledby="registration-title">
		<h1 id="registration-title">Criar conta</h1>
		<form method="post" action="/registo">
			@page.CSRFField
			<div class="form-field"><label for="name">Nome</label><input id="name" name="name" autocomplete="name" value={ page.Name } required/>@errorText(page.Errors, "name")</div>
			<div class="form-field"><label for="email">Correio eletrónico</label><input id="email" name="email" type="email" autocomplete="email" value={ page.Email } required/>@errorText(page.Errors, "email")</div>
			<div class="form-field"><label for="date_of_birth">Data de nascimento</label><input id="date_of_birth" name="date_of_birth" type="date" value={ page.DateOfBirth } required/>@errorText(page.Errors, "date_of_birth")</div>
			<div class="form-field"><label for="role">Tipo de conta</label><select id="role" name="role" required><option value="">Selecione</option><option value="Competitor" selected?={ page.Role == "Competitor" }>Competidor</option><option value="Leisure" selected?={ page.Role == "Leisure" }>Lazer</option><option value="Guardian" selected?={ page.Role == "Guardian" }>Encarregado de educação</option></select>@errorText(page.Errors, "role")</div>
			<div class="form-field"><label for="squad_category">Categoria de equipa (apenas competidor)</label><select id="squad_category" name="squad_category"><option value="">Selecione</option><option value="Iniciante" selected?={ page.Squad == "Iniciante" }>Iniciante</option><option value="Polo_Senior" selected?={ page.Squad == "Polo_Senior" }>Polo sénior</option><option value="Master_A" selected?={ page.Squad == "Master_A" }>Master A</option></select></div>
			<div class="form-field"><label for="password">Palavra-passe</label><input id="password" name="password" type="password" autocomplete="new-password" required/>@errorText(page.Errors, "password")</div>
			<div class="form-field"><label for="password_confirmation">Confirmar palavra-passe</label><input id="password_confirmation" name="password_confirmation" type="password" autocomplete="new-password" required/>@errorText(page.Errors, "password_confirmation")</div>
			<label><input name="accept_terms" type="checkbox" required/> Aceito os termos gerais.</label>@errorText(page.Errors, "accept_terms")
			<label><input name="accept_image_use" type="checkbox" required/> Aceito a autorização de uso de imagem.</label>@errorText(page.Errors, "accept_image_use")
			<button type="submit">Criar conta</button>
		</form>
	</section>
}

templ errorText(errors validation.FieldErrors, field string) {
	if message := errors[field]; message != "" {
		<span class="field-error" role="alert">{ message }</span>
	}
}
