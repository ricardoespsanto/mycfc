package pages

import (
	"fmt"
	"github.com/cfcoimbra/mycfc/internal/validation"
	"github.com/cfcoimbra/mycfc/ui/components"
	"net/url"
	"regexp"
	"sort"
	"strings"
	"time"
)

type StructuredReuseContext struct{ Label, Group, Season, Week, Day, Item string }
type StructuredReuseMapping struct {
	Key, SourceLabel, Precision, Band, Duration string
	StartOccurrences, EndOccurrences            []StructuredWorkoutChoice
	NeedsStart, NeedsEnd                        bool
}
type StructuredReuseRoutine struct{ ID, Name, Kind, Description, URL string }
type StructuredReuseTaskPage struct {
	Meta                                                                                                                                                                                   components.PageMeta
	CSRFField                                                                                                                                                                              templ.Component
	Values                                                                                                                                                                                 url.Values
	Errors                                                                                                                                                                                 validation.FieldErrors
	Source, Target                                                                                                                                                                         StructuredReuseContext
	Groups, Seasons, Sessions, Segments                                                                                                                                                    []StructuredWorkoutChoice
	Mappings                                                                                                                                                                               []StructuredReuseMapping
	Routines                                                                                                                                                                               []StructuredReuseRoutine
	SourcePreview, TargetPreview                                                                                                                                                           templ.Component
	Message, ProposalJSON, ReviewToken, DraftURL, PreviewURL, ConfirmURL, ReturnURL, ReloadURL, DestinationURL, AdaptURL, RoutineURL, PreviousURL, NextURL, GroupPreviousURL, GroupNextURL string
	Reviewing, ReadOnly, Unknown, NoWork, ShowRoutineLibrary                                                                                                                               bool
}

var reuseMappingKey = regexp.MustCompile(`^m_([1-9]|[1-5][0-9]|6[0-4])$`)
var reuseNativeTime = regexp.MustCompile(`^[0-9]{2}:[0-9]{2}(:[0-9]{2}(\.[0-9]{1,3})?)?$`)

func reuseTopologyValid(p StructuredReuseTaskPage) bool {
	if len(p.Mappings) > 64 || len(p.Routines) > 20 {
		return false
	}
	seen := map[string]bool{}
	for _, m := range p.Mappings {
		if !reuseMappingKey.MatchString(m.Key) || seen[m.Key] {
			return false
		}
		seen[m.Key] = true
	}
	return true
}
func reuseTitle(p StructuredReuseTaskPage) string {
	switch p.Values.Get("source_kind") {
	case "WEEK":
		return "Copiar semana"
	case "DAY":
		return "Copiar dia"
	case "SESSION":
		return "Copiar sessão"
	case "ROUTINE":
		return "Usar rotina"
	}
	return "Reutilizar treino"
}
func reuseMappingPrefix(m StructuredReuseMapping) string { return "mappings[" + m.Key + "]" }
func reuseSessionVisible(p StructuredReuseTaskPage) bool {
	return p.Sessions != nil || p.Values.Get("target_session_id") != ""
}
func reuseSegmentVisible(p StructuredReuseTaskPage) bool {
	return p.Segments != nil || p.Values.Get("target_segment_id") != ""
}
func reuseMappingVisible(p StructuredReuseTaskPage, m StructuredReuseMapping, field string) bool {
	prefix := reuseMappingPrefix(m)
	switch field {
	case "date":
		return true
	case "start_time":
		return m.NeedsStart || len(m.StartOccurrences) > 0 || p.Values.Get(prefix+".start_time") != "" || p.Values.Get(prefix+".start_occurrence") != ""
	case "end_date", "end_time":
		return m.NeedsEnd || len(m.EndOccurrences) > 0 || p.Values.Get(prefix+".end_date") != "" || p.Values.Get(prefix+".end_time") != "" || p.Values.Get(prefix+".end_occurrence") != ""
	case "start_occurrence":
		return len(m.StartOccurrences) > 0 || p.Values.Get(prefix+".start_occurrence") != ""
	case "end_occurrence":
		return len(m.EndOccurrences) > 0 || p.Values.Get(prefix+".end_occurrence") != ""
	}
	return false
}
func reuseSourceFields(p StructuredReuseTaskPage) []workoutHiddenField {
	out := []workoutHiddenField{}
	for _, n := range []string{"source_kind", "source_plan_id", "source_session_id", "source_day", "routine_id"} {
		if v := p.Values.Get(n); v != "" {
			out = append(out, workoutHiddenField{n, v})
		}
	}
	return out
}
func reuseRawNames(p StructuredReuseTaskPage) []string {
	out := []string{"target_group_id", "season_id", "week_start", "target_session_id", "target_segment_id", "week_title", "week_description", "planned_load_percentage"}
	for _, m := range p.Mappings {
		for _, f := range []string{"date", "start_time", "start_occurrence", "end_date", "end_time", "end_occurrence"} {
			out = append(out, reuseMappingPrefix(m)+"."+f)
		}
	}
	return out
}
func reuseHidden(p StructuredReuseTaskPage) []workoutHiddenField {
	out := reuseSourceFields(p)
	for _, n := range reuseRawNames(p) {
		out = append(out, workoutHiddenField{n, p.Values.Get(n)})
	}
	for _, m := range p.Mappings {
		out = append(out, workoutHiddenField{"mapping_order", m.Key})
	}
	return out
}
func reuseFields(p StructuredReuseTaskPage) StructuredWorkoutTaskPage {
	errors := validation.FieldErrors{}
	for name, message := range p.Errors {
		errors[workoutErrorKey(name)] = message
	}
	return StructuredWorkoutTaskPage{Values: p.Values, Errors: errors, Context: StructuredWorkoutContext{SessionID: "reuse-fields"}}
}
func reuseErrorKeys(p StructuredReuseTaskPage) []string {
	keys := []string{}
	for k, v := range p.Errors {
		if v != "" {
			keys = append(keys, k)
		}
	}
	sort.Strings(keys)
	return keys
}
func reuseErrorTarget(p StructuredReuseTaskPage, name string) string {
	if p.ReadOnly || p.Reviewing || p.Unknown || p.NoWork || !reuseTopologyValid(p) {
		return ""
	}
	if p.ShowRoutineLibrary {
		for _, n := range []string{"routine_query", "routine_modality", "routine_objective", "routine_tag"} {
			if name == n {
				return workoutFieldID(n)
			}
		}
		return ""
	}
	if p.DraftURL == "" {
		return ""
	}
	for _, n := range []string{"target_group_id", "season_id", "week_start", "week_title", "week_description", "planned_load_percentage"} {
		if name == n {
			return workoutFieldID(n)
		}
	}
	if name == "target_session_id" && reuseSessionVisible(p) || name == "target_segment_id" && reuseSegmentVisible(p) {
		return workoutFieldID(name)
	}
	for _, m := range p.Mappings {
		for _, f := range []string{"date", "start_time", "start_occurrence", "end_date", "end_time", "end_occurrence"} {
			if name == reuseMappingPrefix(m)+"."+f && reuseMappingVisible(p, m, f) {
				return workoutFieldID(name)
			}
		}
	}
	return ""
}
func reuseTimeType(value string) string {
	if value == "" {
		return "time"
	}
	if !reuseNativeTime.MatchString(value) {
		return "text"
	}
	for _, layout := range []string{"15:04", "15:04:05.999999999"} {
		if _, err := time.Parse(layout, value); err == nil {
			return "time"
		}
	}
	return "text"
}
func reuseBandLabel(value string) string {
	if value == "MORNING" {
		return "Manhã"
	}
	if value == "AFTERNOON" {
		return "Tarde"
	}
	return value
}
func reuseRetainedLabel(name string) string {
	switch name {
	case "target_group_id":
		return "Grupo de destino"
	case "season_id":
		return "Época"
	case "week_start":
		return "Segunda-feira de destino"
	case "target_session_id":
		return "Sessão de destino"
	case "target_segment_id":
		return "Atividade de destino"
	case "week_title":
		return "Título da nova semana"
	case "week_description":
		return "Notas da nova semana"
	case "planned_load_percentage":
		return "Carga planeada"
	}
	switch {
	case strings.HasSuffix(name, ".date"):
		return "Data de destino"
	case strings.HasSuffix(name, ".start_time"):
		return "Hora de início"
	case strings.HasSuffix(name, ".end_date"):
		return "Data de fim"
	case strings.HasSuffix(name, ".end_time"):
		return "Hora de fim"
	case strings.HasSuffix(name, ".start_occurrence"):
		return "Ocorrência do início"
	case strings.HasSuffix(name, ".end_occurrence"):
		return "Ocorrência do fim"
	}
	return "Valor apresentado"
}

templ StructuredReuseTask(page StructuredReuseTaskPage) {
	@components.Base(page.Meta, structuredReuseContent(page))
}

templ structuredReuseContent(page StructuredReuseTaskPage) {
	<div class="task-route-page">
		@components.TaskRoute(components.TaskSurfaceConfig{Variant: "modal", ID: "structured-reuse-task", TitleID: "structured-reuse-title", Eyebrow: "Planeamento · Reutilizar", Title: reuseTitle(page), ReturnURL: page.ReturnURL}) {
			<div class="task-form">
				if page.Unknown {
					<section role="alert" tabindex="-1" autofocus>
						<h2>Confirme o resultado no destino</h2>
						if page.Message!="" {
							<p>{ page.Message }</p>
						}
						<p>Não foi possível confirmar o resultado. Consulte o destino antes de repetir a operação.</p>
					</section>
					@structuredReuseRecovery(page, true)
				} else {
					@structuredReuseErrors(page)
					if page.Message!="" {
						<section class="task-conflict" role="alert" tabindex="-1" autofocus?={ len(reuseErrorKeys(page))==0 }><p>{ page.Message }</p></section>
					}
					@structuredReuseContext("Origem", page.Source)
					@structuredReuseContext("Destino", page.Target)
					if !reuseTopologyValid(page) {
						<p role="alert">Não foi possível apresentar a operação completa. Reveja o contexto antes de continuar.</p>
						@structuredReuseRetained(page)
						@structuredReuseRecovery(page, false)
					} else if page.ShowRoutineLibrary {
						@structuredReuseLibrary(page)
						@structuredReuseRecovery(page, false)
					} else if page.NoWork {
						<p role="status">Não existe conteúdo para copiar nesta origem. Nenhuma cópia é proposta.</p>
						@structuredReusePreviews(page)
						@structuredReuseRecovery(page, false)
					} else if page.ReadOnly {
						@structuredReusePreviews(page)
						@structuredReuseRetained(page)
						@structuredReuseRecovery(page, false)
					} else if page.Reviewing {
						<h2>Rever a cópia independente</h2>
						<p>Estas são as instruções de base, antes de adaptações individuais. A confirmação cria uma cópia independente em rascunho; não publica para os atletas.</p>
						@structuredReusePreviews(page)
						if page.DraftURL!="" {
							<form method="post" action={ templ.SafeURL(page.DraftURL) } class="form-layout">
								@structuredReuseCSRF(page)
								@structuredWorkoutHidden(reuseHidden(page))
								@structuredReuseProof(page)
								<input type="hidden" name="command" value="refresh"/>
								<button class="action action--secondary" type="submit" formnovalidate>Continuar a editar</button>
							</form>
						}
						if page.SourcePreview!=nil&&page.TargetPreview!=nil&&page.ReviewToken!=""&&page.ProposalJSON!=""&&page.ConfirmURL!=""&&len(reuseErrorKeys(page))==0 {
							<form method="post" action={ templ.SafeURL(page.ConfirmURL) } class="form-layout" data-task-form>
								@structuredReuseCSRF(page)
								<input type="hidden" name="intent" value="confirm"/>
								<input type="hidden" name="proposal" value={ page.ProposalJSON }/>
								<input type="hidden" name="review_token" value={ page.ReviewToken }/>
								<button class="action action--primary" type="submit">Confirmar cópia em rascunho</button>
							</form>
						} else {
							<p role="status">Reveja a origem e o destino antes de confirmar.</p>
						}
						@structuredReuseRecovery(page, false)
					} else if page.DraftURL!="" {
						<form method="post" action={ templ.SafeURL(page.DraftURL) } class="form-layout">
							@structuredReuseCSRF(page)
							@structuredWorkoutHidden(reuseSourceFields(page))
							@structuredReuseProof(page)
							@structuredReuseEditor(page)
							@structuredReuseRecovery(page, false)
							@components.TaskActions(page.ReturnURL) {
								if page.PreviewURL!="" {
									<button class="action action--primary" type="submit" name="command" value="preview" formaction={ templ.SafeURL(page.PreviewURL) }>Pré-visualizar cópia</button>
								}
							}
						</form>
					} else {
						@structuredReuseRetained(page)
						@structuredReuseRecovery(page, false)
					}
				}
			</div>
		}
	</div>
}

templ structuredReuseCSRF(page StructuredReuseTaskPage) {
	if page.CSRFField!=nil {
		@page.CSRFField
	}
}

templ structuredReuseProof(page StructuredReuseTaskPage) {
	if page.ProposalJSON!="" {
		<input type="hidden" name="prior_proposal" value={ page.ProposalJSON }/>
	}
	if page.ReviewToken!="" {
		<input type="hidden" name="prior_review_token" value={ page.ReviewToken }/>
	}
}

templ structuredReuseContext(title string, facts StructuredReuseContext) {
	<section aria-label={ title }>
		<h2>{ title }</h2>
		if facts.Label!="" {
			<p>{ facts.Label }</p>
		}
		<dl class="status-summary">
			if facts.Group!="" {
				<div><dt>Grupo</dt><dd>{ facts.Group }</dd></div>
			}
			if facts.Season!="" {
				<div><dt>Época configurada</dt><dd>{ facts.Season }</dd></div>
			}
			if facts.Week!="" {
				<div><dt>Semana</dt><dd>{ facts.Week }</dd></div>
			}
			if facts.Day!="" {
				<div><dt>Data</dt><dd>{ facts.Day }</dd></div>
			}
			if facts.Item!="" {
				<div><dt>Conteúdo</dt><dd>{ facts.Item }</dd></div>
			}
		</dl>
	</section>
}

templ structuredReuseErrors(page StructuredReuseTaskPage) {
	if len(reuseErrorKeys(page))>0 {
		<section class="error-summary" aria-labelledby="reuse-error-title" role="alert" tabindex="-1" autofocus>
			<h2 id="reuse-error-title">Reveja os dados apresentados</h2>
			<ul>
				for _,name:=range reuseErrorKeys(page) {
					<li>
						if target:=reuseErrorTarget(page,name);target!="" {
							<a href={ "#" + target }>{ page.Errors[name] }</a>
						} else {
							<span>{ page.Errors[name] }</span>
						}
					</li>
				}
			</ul>
		</section>
	}
}

templ structuredReusePreviews(page StructuredReuseTaskPage) {
	if page.SourcePreview!=nil {
		<section aria-label="Instruções de origem">
			<h2>Instruções de origem</h2>@page.SourcePreview
		</section>
	}
	if page.TargetPreview!=nil {
		<section aria-label="Instruções propostas no destino">
			<h2>Instruções propostas no destino</h2>@page.TargetPreview
		</section>
	}
}

templ structuredReuseEditor(page StructuredReuseTaskPage) {
	@components.RequiredNote()
	<h2>Escolher o destino</h2>
	@structuredWorkoutSelect(reuseFields(page), "target_group_id", "Grupo de destino", page.Groups, true, "")
	<nav class="cluster" aria-label="Páginas de grupos">
		if page.GroupPreviousURL!="" {
			<a href={ templ.SafeURL(page.GroupPreviousURL) }>Grupos anteriores</a>
		}
		if page.GroupNextURL!="" {
			<a href={ templ.SafeURL(page.GroupNextURL) }>Mais grupos</a>
		}
	</nav>
	@structuredWorkoutSelect(reuseFields(page), "season_id", "Época configurada", page.Seasons, true, "Escolha a época configurada para este grupo; não são presumidas datas do clube.")
	@structuredWorkoutInput(reuseFields(page), "week_start", "Segunda-feira de destino", "date", "numeric", 32, true, "")
	if reuseSessionVisible(page) {
		@structuredWorkoutSelect(reuseFields(page), "target_session_id", "Sessão de destino", page.Sessions, true, "A sessão tem de aceitar alterações no momento de guardar.")
		if page.Sessions != nil && len(page.Sessions) == 0 {
			<p role="status">Não existem sessões elegíveis neste destino.</p>
		}
	}
	if reuseSegmentVisible(page) {
		@structuredWorkoutSelect(reuseFields(page), "target_segment_id", "Atividade de destino", page.Segments, true, "Escolha uma atividade compatível com o bloco.")
		if page.Segments != nil && len(page.Segments) == 0 {
			<p role="status">Não existem atividades compatíveis neste destino.</p>
		}
	}
	@structuredWorkoutCommand("refresh", "Atualizar opções sem perder os dados", false)
	<details open?={ page.Values.Get("week_title")!=""||page.Values.Get("week_description")!=""||page.Values.Get("planned_load_percentage")!=""||page.Errors["week_title"]!=""||page.Errors["week_description"]!=""||page.Errors["planned_load_percentage"]!="" }>
		<summary>Dados de uma nova semana</summary>
		<p>Necessários apenas se ainda não existir uma semana neste destino. Uma semana existente não é renomeada.</p>
		@structuredWorkoutInput(reuseFields(page), "week_title", "Título da nova semana", "text", "", 180, false, "")
		@structuredWorkoutText(reuseFields(page), "week_description", "Notas da nova semana (opcional)", 4000, false, "")
		@structuredWorkoutInput(reuseFields(page), "planned_load_percentage", "Carga planeada (%, opcional)", "text", "decimal", 40, false, "Valor definido pelo treinador; nenhuma carga é calculada automaticamente.")
	</details>
	for _,m:=range page.Mappings {
		<fieldset class="form-section">
			<legend>{ m.SourceLabel }</legend>
			<input type="hidden" name="mapping_order" value={ m.Key }/>
			<p>
				{ workoutShapeLabel(m.Precision) }
				if m.Band!="" {
					<span>· { reuseBandLabel(m.Band) }</span>
				}
				if m.Duration!="" {
					<span>· Duração representada: { m.Duration }</span>
				}
			</p>
			@structuredWorkoutInput(reuseFields(page), reuseMappingPrefix(m)+".date", "Data de destino", "date", "numeric", 32, true, "")
			if reuseMappingVisible(page,m,"start_time") {
				@structuredReuseTime(page, reuseMappingPrefix(m)+".start_time", "Hora de início", m.NeedsStart)
			}
			if reuseMappingVisible(page,m,"start_occurrence") {
				@structuredWorkoutSelect(reuseFields(page), reuseMappingPrefix(m)+".start_occurrence", "Ocorrência da hora de início", m.StartOccurrences, true, "Escolha explicitamente a ocorrência da mudança de hora.")
			}
			if reuseMappingVisible(page,m,"end_date") {
				@structuredWorkoutInput(reuseFields(page), reuseMappingPrefix(m)+".end_date", "Data de fim", "date", "numeric", 32, m.NeedsEnd, "Nenhuma data de fim é inventada.")
			}
			if reuseMappingVisible(page,m,"end_time") {
				@structuredReuseTime(page, reuseMappingPrefix(m)+".end_time", "Hora de fim", m.NeedsEnd)
			}
			if reuseMappingVisible(page,m,"end_occurrence") {
				@structuredWorkoutSelect(reuseFields(page), reuseMappingPrefix(m)+".end_occurrence", "Ocorrência da hora de fim", m.EndOccurrences, true, "Não é escolhido um desvio horário automaticamente.")
			}
		</fieldset>
	}
}

templ structuredReuseTime(page StructuredReuseTaskPage, name, label string, required bool) {
	<div class="field-group">
		@components.FieldLabel(workoutFieldID(name), label, required)
		<input id={ workoutFieldID(name) } name={ name } type={ reuseTimeType(page.Values.Get(name)) } step="any" inputmode="decimal" maxlength="32" value={ page.Values.Get(name) } required?={ required } aria-invalid={ fmt.Sprint(page.Errors[name] != "") } aria-describedby={ workoutDescribedBy(reuseFields(page), name, "") }/>
		@components.FieldErrorMessage(workoutFieldID(name), page.Errors[name])
	</div>
}

templ structuredReuseRetained(page StructuredReuseTaskPage) {
	<section aria-label="Dados apresentados para consulta">
		<h2>Dados apresentados</h2>
		<dl class="status-summary">
			for _,name:=range reuseRawNames(page) {
				if value:=page.Values.Get(name);value!="" && !strings.HasSuffix(name,"_id") {
					<div><dt>{ reuseRetainedLabel(name) }</dt><dd class="preserve-lines">{ value }</dd></div>
				}
			}
		</dl>
	</section>
}

templ structuredReuseRecovery(page StructuredReuseTaskPage, unknown bool) {
	<nav class="cluster" aria-label="Outras opções de reutilização">
		if page.ReturnURL!="" {
			<a class="action action--quiet" href={ templ.SafeURL(page.ReturnURL) }>Voltar à semana</a>
		}
		if page.ReloadURL!="" {
			<a class="action action--quiet" href={ templ.SafeURL(page.ReloadURL) }>Recarregar contexto atual</a>
		}
		if page.DestinationURL!="" {
			<a class="action action--quiet" href={ templ.SafeURL(page.DestinationURL) }>Consultar destino</a>
		}
		if !unknown&&page.AdaptURL!="" {
			<a class="action action--quiet" href={ templ.SafeURL(page.AdaptURL) }>Adaptar para…</a>
		}
		if !unknown&&page.RoutineURL!=""&&!page.ShowRoutineLibrary {
			<a class="action action--quiet" href={ templ.SafeURL(page.RoutineURL) }>Usar rotina</a>
		}
	</nav>
}

templ structuredReuseLibrary(page StructuredReuseTaskPage) {
	<h2>Rotinas configuradas</h2>
	<form method="get" action={ templ.SafeURL(page.RoutineURL) } class="form-layout">
		<input type="hidden" name="source_kind" value="ROUTINE"/>
		for _,name:=range []string{"target_group_id","season_id","week_start","target_session_id","target_segment_id"} {
			if v:=page.Values.Get(name);v!="" {
				<input type="hidden" name={ name } value={ v }/>
			}
		}
		@structuredWorkoutInput(reuseFields(page), "routine_query", "Pesquisar rotinas", "text", "", 180, false, "")
		@structuredWorkoutSelect(reuseFields(page), "routine_modality", "Modalidade", []StructuredWorkoutChoice{{"", "Todas"}, {"WATER", "Água"}, {"GYM", "Ginásio"}, {"RUN", "Corrida"}, {"BIKE", "Bicicleta"}, {"ERGOMETER", "Ergómetro"}, {"FLEXIBILITY", "Mobilidade"}, {"SPORTS_GAMES", "Jogos desportivos"}, {"OTHER", "Outra"}}, false, "")
		@structuredWorkoutInput(reuseFields(page), "routine_objective", "Objetivo", "text", "", 120, false, "")
		@structuredWorkoutInput(reuseFields(page), "routine_tag", "Etiqueta", "text", "", 120, false, "")
		<button class="action action--secondary" type="submit">Pesquisar</button>
	</form>
	if len(page.Routines)==0 {
		<p role="status">Sem rotinas visíveis para estes filtros. Pode pesquisar outros termos ou guardar uma rotina no planeamento.</p>
	}
	<div class="record-list">
		for _,r:=range page.Routines {
			<article class="record-item record-item--stacked">
				<div class="record-item__copy">
					<h3>{ r.Name }</h3>
					<p class="record-meta">{ trainingRoutineKindLabel(r.Kind) }</p>
					if r.Description!="" {
						<p class="preserve-lines">{ r.Description }</p>
					}
					if r.URL!="" {
						<a class="action action--quiet" href={ templ.SafeURL(r.URL) }>Usar { r.Name }</a>
					}
				</div>
			</article>
		}
	</div>
	<nav class="cluster" aria-label="Páginas de rotinas">
		if page.PreviousURL!="" {
			<a href={ templ.SafeURL(page.PreviousURL) }>Rotinas anteriores</a>
		}
		if page.NextURL!="" {
			<a href={ templ.SafeURL(page.NextURL) }>Mais rotinas</a>
		}
	</nav>
}
