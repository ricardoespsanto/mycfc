package pages

import "github.com/cfcoimbra/mycfc/ui/components"

type DashboardPage struct {
	Meta      components.PageMeta
	Heading   string
	Intro     string
	EmptyText string
	Agenda    []CalendarItem
	ShowAgenda bool
	Sections []DashboardSection
	Actions []components.PageAction
}

type CalendarItem struct { Title, Detail, URL, Kind string }
type DashboardSection struct { Heading, Empty string; Items []DashboardItem }
type DashboardItem struct { Title, Detail, URL string }

templ Dashboard(page DashboardPage) {
	@components.Base(page.Meta, dashboardContent(page))
}

templ dashboardContent(page DashboardPage) {
	@components.PageHeader("O meu programa", page.Heading, page.Intro, page.Actions)
	for _, section := range page.Sections {
		<section class="module">
			@components.SectionHeading("Visão geral", section.Heading, dashboardSectionSummary(section.Heading))
			if len(section.Items) == 0 {
				@components.EmptyState("Ainda sem registos", section.Empty)
			}
			if len(section.Items) > 0 {
				@components.RecordList(section.Heading) {
					for _, item := range section.Items {
						@components.RecordItem(item.Title, item.URL, item.Detail)
					}
				}
			}
		</section>
	}
	if page.ShowAgenda {
		@Calendar(page.Agenda, "Eventos e treinos relevantes para o seu perfil.")
	}
}

func dashboardSectionSummary(heading string) string {
	switch heading {
	case "Desempenho":
		return "Métricas recentes para acompanhar a sua evolução."
	case "Treinos recentes":
		return "Registos das sessões realizadas nos últimos 90 dias."
	case "Notícias":
		return "Atualizações publicadas pelo clube."
	case "Grupos WhatsApp":
		return "Canais associados às suas inscrições ativas."
	default:
		return "Informação relevante para o seu programa."
	}
}

templ Calendar(items []CalendarItem, intro string) {
	<section class="module">@components.SectionHeading("Calendários", "Agenda", intro)
		if len(items) == 0 {
			@components.EmptyState("Agenda sem itens", "Ainda não existem eventos ou treinos futuros para apresentar.")
		}
		if len(items) > 0 {
		<ul class="calendar-events record-list" aria-label="Próximos itens da agenda">
			for _, item := range items {
				<li class="record-item"><div class="record-item__copy"><h3><a href={ templ.SafeURL(item.URL) }>{ item.Title }</a></h3><p class="record-meta">{ item.Detail }</p></div>@components.Badge(item.Kind, "info")</li>
			}
		</ul>
		}
	</section>
}
