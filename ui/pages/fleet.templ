package pages

import (
	"fmt"
	"github.com/cfcoimbra/mycfc/internal/validation"
	"github.com/cfcoimbra/mycfc/ui/components"
)

type FleetPage struct {
	Meta                 components.PageMeta
	Success              string
	Counts               []FleetStatusCount
	Equipment            []FleetEquipment
	EquipmentPreviousURL string
	EquipmentNextURL     string
	Repairs              []FleetRepair
	RepairsPreviousURL   string
	RepairsNextURL       string
	Maintenance          []FleetMaintenance
	MaintenancePreviousURL string
	MaintenanceNextURL     string
	MaintenanceForm      FleetMaintenanceForm
	EquipmentForm        EquipmentForm
	CalendarAPIKey       string
	CalendarSources      string
	Calendars            []CalendarLink
}

type FleetStatusCount struct { Status string; Total int64 }
type FleetEquipment struct { ID, AssetTag, Name, Type, Status, Notes, PhotoURL, PhotoUnavailable string }
type FleetRepair struct { ID, Equipment, Description, Status, ReportedAt, PhotoURL, PhotoUnavailable, ActionError string }
type FleetMaintenance struct { ID, Equipment, Description, Status, ScheduledFor, ActionError string }
type FleetMaintenanceForm struct {
	CSRFField templ.Component
	Equipment []components.RepairEquipment
	EquipmentID, ScheduledFor, Description, Success string
	Errors validation.FieldErrors
}

templ Fleet(page FleetPage) {
	@components.Base(page.Meta, fleetContent(page))
}

templ fleetContent(page FleetPage) {
	<div class="collection-page fleet-collection">
	@components.PageHeader("Administração", "Frota", "Inventário, avarias e manutenção organizados por tarefa.", []components.PageAction{{Label: "Adicionar equipamento", Href: "#equipment-form", Variant: "primary"}, {Label: "Agendar manutenção", Href: "#maintenance-form", Variant: "secondary"}})
	@components.StatusMessage(page.Success, "success")
	<section class="fleet-overview" aria-labelledby="fleet-overview-title"><h2 id="fleet-overview-title" class="visually-hidden">Estado da frota</h2><ul aria-label="Totais atuais por estado operacional">
		for _, count := range page.Counts {
			<li><strong>{ fleetCountLabel(count.Total) }</strong><span>{ fleetStatusLabel(count.Status) }</span></li>
		}
	</ul></section>
	<nav class="collection-tabs" aria-label="Áreas da frota" data-collection-tabs><a href="#equipment-inventory" aria-current="page">Equipamentos</a><a href="#repair-requests">Reparações <span>{ len(page.Repairs) }</span></a><a href="#maintenance-schedule">Manutenção <span>{ len(page.Maintenance) }</span></a></nav>
	<section id="equipment-inventory" class="collection-view collection-tab-panel" data-tab-panel>
		@components.SectionHeading("Inventário", "Equipamentos", "Consulte o inventário e o estado de cada equipamento.") {
			<span class="collection-count">{ len(page.Equipment) } nesta página</span>
		}
		if len(page.Equipment) == 0 {
			@components.EmptyState("Ainda sem equipamentos", "Os equipamentos registados aparecem aqui.")
		}
		if len(page.Equipment) > 0 {
			@components.DataRegion("Inventário da frota", fleetEquipmentTable(page))
		}
		@fleetPagination(page.EquipmentPreviousURL, page.EquipmentNextURL, "Paginação de equipamentos")
	</section>
	<section id="repair-requests" class="collection-view collection-tab-panel" data-tab-panel>
		@components.SectionHeading("Avarias", "Pedidos de reparação pendentes", "Problemas reportados que ainda exigem acompanhamento.") {
			<span class="collection-count">{ len(page.Repairs) } pendentes</span>
		}
		if len(page.Repairs) == 0 {
			@components.EmptyState("Sem reparações pendentes", "Não existem pedidos de reparação a exigir acompanhamento.")
		}
		if len(page.Repairs) > 0 {
			<ul class="record-list collection-list" aria-label="Pedidos de reparação pendentes">
			for _, repair := range page.Repairs {
				<li class="record-item record-item--stacked"><div class="record-item__copy"><h3>{ repair.Equipment }</h3><p>{ repair.Description }</p><p class="record-meta">{ repair.ReportedAt }</p>
					if repair.PhotoURL != "" {
						<img class="record-thumbnail" src={ repair.PhotoURL } alt="Fotografia da avaria"/>
					}
					if repair.PhotoUnavailable != "" {
						<span class="record-meta">{ repair.PhotoUnavailable }</span>
					}
				</div>@components.Badge(fleetStatusLabel(repair.Status), fleetStatusTone(repair.Status))<div class="record-item__actions">@RepairStatusForm(repair, page.Meta.CSRFField)</div></li>
			}
			</ul>
		}
		@fleetPagination(page.RepairsPreviousURL, page.RepairsNextURL, "Paginação de pedidos de reparação")
	</section>
	<section id="maintenance-schedule" class="collection-view collection-tab-panel" data-tab-panel>
		@components.SectionHeading("Planeamento", "Próximas manutenções", "Intervenções previstas para os próximos 90 dias.") {
			<span class="collection-count">{ len(page.Maintenance) } agendadas</span>
		}
		if len(page.Maintenance) == 0 {
			@components.EmptyState("Sem manutenções agendadas", "Não existem manutenções nos próximos 90 dias.")
		}
		if len(page.Maintenance) > 0 {
			<ul class="record-list collection-list" aria-label="Próximas manutenções">
			for _, task := range page.Maintenance {
				<li class="record-item record-item--stacked"><div class="record-item__copy"><h3>{ task.Equipment }</h3><p>{ task.Description }</p><p class="record-meta">{ task.ScheduledFor }</p></div>@components.Badge(fleetStatusLabel(task.Status), fleetStatusTone(task.Status))<div class="record-item__actions">@MaintenanceCompletionForm(task, page.Meta.CSRFField)</div></li>
			}
			</ul>
		}
		@fleetPagination(page.MaintenancePreviousURL, page.MaintenanceNextURL, "Paginação de manutenções")
		<div class="collection-secondary">@Calendar(page.CalendarAPIKey, page.CalendarSources, page.Calendars, "Consulte todos os calendários públicos do clube.")</div>
	</section>
	@EquipmentCreateForm(page.EquipmentForm)
	@MaintenanceForm(page.MaintenanceForm)
	</div>
}

templ fleetEquipmentTable(page FleetPage) {
	<table class="data-table collection-table"><thead><tr><th scope="col">Equipamento</th><th scope="col">Tipo</th><th scope="col">Estado</th><th scope="col" aria-label="Ações"></th></tr></thead><tbody>
				for _, equipment := range page.Equipment {
					<tr><th scope="row"><span class="equipment-identity">
						if equipment.PhotoURL != "" {
							<img class="equipment-thumbnail" src={ equipment.PhotoURL } alt="" loading="lazy"/>
						}
						<span><strong>{ equipment.AssetTag } · { equipment.Name }</strong>
						if equipment.PhotoUnavailable != "" {
							<small>{ equipment.PhotoUnavailable }</small>
						}
						</span></span></th><td>{ equipmentTypeLabel(equipment.Type) }</td><td>@components.Badge(fleetStatusLabel(equipment.Status), fleetStatusTone(equipment.Status))</td><td><details class="inline-disclosure"><summary>Ações</summary><div class="record-item__actions"><a class="action action--secondary" href={ templ.SafeURL("/admin/fleet/equipment/" + equipment.ID + "/edit") }>Editar</a>
							if equipment.Status == "Retired" {
								<form method="post" action={ "/admin/fleet/equipment/" + equipment.ID + "/reactivate" }>@page.Meta.CSRFField<button type="submit">Reativar</button></form>
							} else {
								<form method="post" action={ "/admin/fleet/equipment/" + equipment.ID + "/retire" }>@page.Meta.CSRFField<button class="action action--secondary" type="submit">Retirar da frota</button></form>
							}
						</div></details></td></tr>
				}
	</tbody></table>
}

templ fleetPagination(previousURL, nextURL, label string) {
	if previousURL != "" || nextURL != "" {
		<nav class="pagination" aria-label={ label }>
			if previousURL != "" {
				<a href={ templ.SafeURL(previousURL) }>Anterior</a>
			}
			if nextURL != "" {
				<a href={ templ.SafeURL(nextURL) }>Seguinte</a>
			}
		</nav>
	}
}

templ RepairStatusForm(repair FleetRepair, csrfField templ.Component) {
	if repair.Status == "Pendente" || repair.Status == "Em_Analise" {
		<form class="inline-action" method="post" action="/admin/repairs/status" hx-post="/admin/repairs/status" hx-target="this" hx-swap="outerHTML" hx-target-422="this" hx-swap-422="outerHTML" hx-target-409="this" hx-swap-409="outerHTML" hx-disabled-elt="find button, find input[type='submit']">
			@csrfField
			<input type="hidden" name="repair_id" value={ repair.ID }/>
			<input type="hidden" name="expected_status" value={ repair.Status }/>
			if repair.Status == "Pendente" {
				<input type="hidden" name="status" value="Em_Analise"/><button type="submit">Iniciar análise</button>
			} else {
				<input type="hidden" name="status" value="Resolvido"/><button type="submit">Marcar como resolvido</button>
			}
			if repair.ActionError != "" {
				<p role="alert">{ repair.ActionError }</p>
			}
		</form>
	}
}

templ MaintenanceCompletionForm(task FleetMaintenance, csrfField templ.Component) {
	if task.Status == "Scheduled" || task.Status == "In_Progress" {
		<form class="inline-action" method="post" action={ "/admin/maintenance/" + task.ID + "/complete" } hx-post={ "/admin/maintenance/" + task.ID + "/complete" } hx-target="this" hx-swap="outerHTML" hx-target-422="this" hx-swap-422="outerHTML" hx-target-409="this" hx-swap-409="outerHTML" hx-disabled-elt="find button, find input[type='submit']">
			@csrfField
			<input type="hidden" name="maintenance_id" value={ task.ID }/><button type="submit">Concluir manutenção</button>
			if task.ActionError != "" {
				<p role="alert">{ task.ActionError }</p>
			}
		</form>
	}
}

templ FleetActionFeedback(success, errorMessage string) {
	<section class="module" aria-live="polite">
		if success != "" {
			<p class="status-message" role="status" tabindex="-1">{ success }</p>
		}
		if errorMessage != "" {
			<p class="status-message" role="alert">{ errorMessage }</p>
		}
	</section>
}

templ MaintenanceForm(form FleetMaintenanceForm) {
	<details id="maintenance-form" class="module disclosure create-panel" data-create-panel open?={ len(form.Errors) > 0 || form.Success != "" } aria-labelledby="maintenance-title">
		<summary><span><strong id="maintenance-title">Agendar manutenção</strong><small>Planeie uma intervenção para um equipamento.</small></span></summary><button class="create-panel__close" type="button">Fechar</button><div class="disclosure__content">
		if form.Success != "" {
			@components.StatusMessage(form.Success, "success")
		}
		@components.ErrorSummary(components.FieldErrorsFor(map[string]string(form.Errors), []components.FieldErrorRef{{Key: "equipment_id", Field: "maintenance-equipment"}, {Key: "scheduled_for", Field: "maintenance-scheduled-for"}, {Key: "description", Field: "maintenance-description"}}))
		<form class="form-layout" method="post" action="/admin/maintenance" hx-post="/admin/maintenance" hx-target="#maintenance-form" hx-swap="outerHTML" hx-target-422="#maintenance-form" hx-swap-422="outerHTML" hx-disabled-elt="find button, find input[type='submit']">
			@form.CSRFField
			@components.RequiredNote()
			@components.FieldLabel("maintenance-equipment", "Equipamento", true)
			<select id="maintenance-equipment" name="equipment_id" required aria-invalid?={ form.Errors["equipment_id"] != "" } aria-describedby="maintenance-equipment-help equipment_id-error">
				<option value="">Selecione um equipamento</option>
				for _, equipment := range form.Equipment {
					<option value={ equipment.ID } selected?={ form.EquipmentID == equipment.ID }>{ equipment.Label }</option>
				}
			</select>
			@components.FieldHelp("maintenance-equipment-help", "Apenas equipamentos disponíveis podem ser agendados.")
			@components.FieldErrorMessage("equipment_id", form.Errors["equipment_id"])
			@components.FieldLabel("maintenance-scheduled-for", "Data e hora", true)
			<input id="maintenance-scheduled-for" name="scheduled_for" type="datetime-local" value={ form.ScheduledFor } required aria-invalid?={ form.Errors["scheduled_for"] != "" } aria-describedby="scheduled_for-error"/>
			@components.FieldErrorMessage("scheduled_for", form.Errors["scheduled_for"])
			@components.FieldLabel("maintenance-description", "Descrição", true)
			<textarea id="maintenance-description" name="description" required aria-invalid?={ form.Errors["description"] != "" } aria-describedby="maintenance-description-help description-error">{ form.Description }</textarea>
			@components.FieldHelp("maintenance-description-help", "Descreva a intervenção prevista (10 a 2000 caracteres).")
			@components.FieldErrorMessage("description", form.Errors["description"])
			@components.FormActions("/admin/fleet") { <button type="submit">Agendar manutenção</button> }
		</form>
	</div></details>
}

func fleetCountLabel(total int64) string { return fmt.Sprintf("%d", total) }

func fleetStatusLabel(status string) string {
	switch status {
	case "Operational": return "Operacional"
	case "Maintenance", "Scheduled": return "Manutenção"
	case "Retired": return "Retirado"
	case "Pendente": return "Pendente"
	case "Em_Analise": return "Em análise"
	case "Resolvido", "Completed": return "Concluído"
	case "In_Progress": return "Em curso"
	default: return status
	}
}

func fleetStatusTone(status string) string {
	switch status {
	case "Operational", "Resolvido", "Completed": return "success"
	case "Maintenance", "Scheduled", "Em_Analise", "In_Progress": return "warning"
	case "Retired": return "error"
	default: return "selected"
	}
}

func equipmentTypeLabel(value string) string {
	switch value {
	case "Boat": return "Embarcação"
	case "Paddle": return "Pagaia"
	case "Vehicle": return "Veículo"
	default: return value
	}
}
