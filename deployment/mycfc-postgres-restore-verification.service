[Unit]
Description=MyCFC isolated PostgreSQL restore verification
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/opt/mycfc/deployment/run-with-cloudwatch-logs.sh /opt/mycfc/deployment/postgres-restore-verification.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/mycfc/mycfc.env /etc/mycfc/backup-aws/credentials /etc/mycfc/backup-auth/manifest.key
ReadWritePaths=/var/tmp /run
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
