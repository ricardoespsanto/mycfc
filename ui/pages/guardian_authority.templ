package pages

import "fmt"
import "github.com/cfcoimbra/mycfc/internal/validation"
import "github.com/cfcoimbra/mycfc/ui/components"

type GuardianAuthorityQueuePage struct {
	Meta components.PageMeta
	Items []GuardianAuthorityQueueItem
	Success, Conflict string
	CanManageInvitations bool
}

type GuardianAuthorityQueueItem struct {
	Reference, SubmittedLabel, Status, ReceivedAt, URL string
}

type GuardianAuthorityInvitationsPage struct {
	Meta components.PageMeta
	Items []GuardianAuthorityInvitationItem
	Token string
	Errors validation.FieldErrors
	RequirePassword bool
}

type GuardianAuthorityInvitationItem struct {
	Reference, Email, ExpiresAt, State string
	CanRevoke bool
}

type GuardianAuthorityDetailPage struct {
	Meta components.PageMeta
	Reference, GuardianName, SubjectName, SubjectLabel, DateOfBirth, Status string
	Expiry, RenewalStatus, RenewalResponse string
	ReadOnlyMessage string
	Version int64
	CanDecide, SelfConflict, ConflictRecorder bool
	CanApprove, CanRenew, CanReject, CanSuspend, CanEnd bool
	RequirePassword bool
	Errors validation.FieldErrors
	Action, EvidenceCategory, ReasonCode string
}

type GuardianAuthorityReasonCode struct { Code, Label string }

templ GuardianAuthorityQueue(page GuardianAuthorityQueuePage) {
	@components.Base(page.Meta, guardianAuthorityQueueContent(page))
}

templ guardianAuthorityQueueContent(page GuardianAuthorityQueuePage) {
	if page.CanManageInvitations {
		@components.PageHeader("Família", "Verificação de representação", "Acompanhe as representações abrangidas pela política aprovada.", []components.PageAction{{Label: "Gerir convites", Href: "/admin/representacoes/convites", Variant: "secondary"}})
	} else {
		@components.PageHeader("Família", "Verificação de representação", "Acompanhe as representações abrangidas pela política aprovada.", nil)
	}
	@components.StatusMessage(page.Success, "success")
	@components.StatusMessage(page.Conflict, "error")
	<section class="module" aria-labelledby="guardian-authority-queue-title">
		<h2 id="guardian-authority-queue-title">Representações a acompanhar</h2>
		if len(page.Items) == 0 {
			@components.EmptyState("Sem representações para acompanhar", "Os pedidos abrangidos aparecerão aqui quando a política estiver ativa.")
		} else {
			@components.RecordList("Pedidos de representação") {
				for _, item := range page.Items {
					<li class="record-item record-item--stacked"><div class="record-item__copy"><h3><a href={ templ.SafeURL(item.URL) }>{ item.Reference }</a></h3><p>{ item.SubmittedLabel }</p><p><strong>{ item.Status }</strong> · recebido em { item.ReceivedAt }</p></div></li>
				}
		}
		}
	</section>
}

templ GuardianAuthorityInvitations(page GuardianAuthorityInvitationsPage) {
	@components.Base(page.Meta, guardianAuthorityInvitationsContent(page))
}

templ guardianAuthorityInvitationsContent(page GuardianAuthorityInvitationsPage) {
	@components.PageHeader("Família", "Convites para associação", "Emita um código de utilização única, válido durante 30 dias, para um email específico.", []components.PageAction{{Label: "Voltar às representações", Href: "/admin/representacoes", Variant: "secondary"}})
	if page.Token != "" {
		@components.StatusMessage("Convite criado. Copie o código agora; não voltará a ser apresentado.", "success")
		<div class="module"><p><strong>Código do convite</strong></p><p><code>{ page.Token }</code></p></div>
	}
	<section class="module" aria-labelledby="guardian-invitation-create-title">
		<h2 id="guardian-invitation-create-title">Emitir convite</h2>
		@components.ErrorSummary(components.FieldErrorsFromMap(map[string]string(page.Errors), []string{"email", "password"}))
		<form method="post" action="/admin/representacoes/convites" class="form-layout">
			@page.Meta.CSRFField
			<div class="form-field">@components.FieldLabel("email", "Email do adulto", true)<input id="email" name="email" type="email" autocomplete="email" required aria-invalid?={ page.Errors["email"] != "" } aria-describedby="email-help email-error"/>@components.FieldHelp("email-help", "A conta tem de ter este email confirmado quando utilizar o convite.")@components.FieldErrorMessage("email", page.Errors["email"])</div>
			if page.RequirePassword {
				<div class="form-field">@components.FieldLabel("password", "Palavra-passe atual", true)<input id="password" name="password" type="password" autocomplete="current-password" required aria-invalid?={ page.Errors["password"] != "" } aria-describedby="password-help password-error"/>@components.FieldHelp("password-help", "Confirme novamente a sua identidade para emitir um convite de acesso.")@components.FieldErrorMessage("password", page.Errors["password"])</div>
			}
			<button class="action action--primary" type="submit">Criar convite</button>
		</form>
	</section>
	<section class="module" aria-labelledby="guardian-invitations-title">
		<h2 id="guardian-invitations-title">Convites recentes</h2>
		if len(page.Items) == 0 {
			@components.EmptyState("Sem convites", "Os convites emitidos aparecerão aqui sem revelar o respetivo código.")
		} else {
			@components.RecordList("Convites") {
				for _, item := range page.Items {
					<li class="record-item"><div class="record-item__copy"><h3>{ item.Email }</h3><p><strong>{ item.State }</strong> · válido até { item.ExpiresAt }</p></div>
					if item.CanRevoke {
						<form method="post" action={ templ.SafeURL("/admin/representacoes/convites/"+item.Reference+"/revogar") }>@page.Meta.CSRFField
							if page.RequirePassword {
								<label>Palavra-passe atual para revogar <input name="password" type="password" autocomplete="current-password" required/></label>
							}
							<button type="submit">Revogar</button>
						</form>
					}
					</li>
				}
			}
		}
	</section>
}

templ GuardianAuthorityDetail(page GuardianAuthorityDetailPage) {
	@components.Base(page.Meta, guardianAuthorityDetailContent(page))
}

templ guardianAuthorityDetailContent(page GuardianAuthorityDetailPage) {
	<div class="task-route-page">
	@components.TaskRoute(components.TaskSurfaceConfig{ID: "guardian-authority-review", TitleID: "guardian-authority-review-title", Eyebrow: "Família", Title: "Verificar representação", Description: "Registe apenas metadados previstos na política. Não carregue documentos nem escreva dados pessoais em campos livres.", ReturnURL: "/admin/representacoes"}) {
		<section class="module" aria-labelledby="guardian-authority-summary-title">
			<h2 id="guardian-authority-summary-title">Resumo do pedido</h2>
			<dl><dt>Referência</dt><dd>{ page.Reference }</dd><dt>Adulto requerente</dt><dd>{ page.GuardianName }</dd><dt>{ page.SubjectLabel }</dt><dd>{ page.SubjectName }</dd><dt>Data de nascimento indicada</dt><dd>{ page.DateOfBirth }</dd><dt>Estado</dt><dd>{ page.Status }</dd>
			if page.Expiry != "" {
				<dt>Validade atual</dt><dd>{ page.Expiry }</dd>
			}
			if page.RenewalStatus == "SUBMITTED" {
				<dt>Renovação</dt><dd>Enviada para revisão · { guardianRenewalResponseLabel(page.RenewalResponse) }</dd>
			}
			</dl>
		</section>
		if page.SelfConflict {
			@components.StatusMessage("Não pode decidir uma representação em que exista envolvimento pessoal ou familiar. Encaminhe-a para outra pessoa administradora.", "error")
		}
		if page.ConflictRecorder {
			@components.StatusMessage("Registou o conflito desta representação. Outra pessoa administradora tem de decidir; não pode limpar nem aprovar este conflito.", "error")
		}
		if page.ReadOnlyMessage != "" {
			@components.StatusMessage(page.ReadOnlyMessage, "info")
		}
		if page.CanDecide {
			@components.ErrorSummary(components.FieldErrorsFor(map[string]string(page.Errors), []components.FieldErrorRef{{Key: "form", Field: "guardian-authority-decisions"}, {Key: "evidence_category", Field: "guardian-authority-decisions"}, {Key: "reason_code", Field: "guardian-authority-decisions"}, {Key: "password", Field: "guardian-authority-decisions"}, {Key: "confirmation", Field: "guardian-authority-decisions"}}))
			<section id="guardian-authority-decisions" class="module" aria-labelledby="guardian-authority-decisions-title">
				<h2 id="guardian-authority-decisions-title">Decisão administrativa</h2>
				<p>Escolha uma ação. Cada formulário apresenta apenas os motivos permitidos para essa ação e nunca pede cópias, referências ou números de documentos.</p>
				if page.CanApprove {
					@guardianAuthorityDecisionForm(page, "APPROVE", "Aprovar representação", []GuardianAuthorityReasonCode{{Code: "RELATIONSHIP_CONFIRMED", Label: "Relação confirmada"}}, false)
				}
				if page.CanRenew {
					@guardianAuthorityDecisionForm(page, "RENEW", "Renovar representação", []GuardianAuthorityReasonCode{{Code: "RELATIONSHIP_CONFIRMED", Label: "Relação confirmada"}}, false)
				}
				if page.CanReject {
					@guardianAuthorityDecisionForm(page, "REJECT", "Rejeitar pedido", []GuardianAuthorityReasonCode{{Code: "EVIDENCE_INSUFFICIENT", Label: "Elementos insuficientes"}, {Code: "AUTHORITY_NOT_ESTABLISHED", Label: "Autoridade não estabelecida"}}, false)
				}
				if page.CanSuspend {
					@guardianAuthorityDecisionForm(page, "SUSPEND", "Suspender acesso", []GuardianAuthorityReasonCode{{Code: "CONFLICT", Label: "Conflito ou disputa"}, {Code: "AUTHORITY_CHANGED", Label: "Autoridade alterada"}, {Code: "UNCERTAINTY", Label: "Incerteza que exige revisão"}}, true)
				}
				if page.CanEnd {
					@guardianAuthorityDecisionForm(page, "END", "Terminar representação", []GuardianAuthorityReasonCode{{Code: "AUTHORITY_ENDED", Label: "Autoridade terminada"}}, true)
				}
			</section>
		}
	}
	</div>
}

func guardianRenewalResponseLabel(value string) string {
	if value == "DADOS_MUDARAM" { return "Os dados mudaram" }
	if value == "NADA_MUDOU" { return "Nada mudou" }
	return "Estado indisponível"
}

templ guardianAuthorityDecisionForm(page GuardianAuthorityDetailPage, action, label string, reasons []GuardianAuthorityReasonCode, destructive bool) {
	<details open?={ page.Action == action }>
		<summary>{ label }</summary>
		<form method="post" action={ templ.SafeURL("/admin/representacoes/" + page.Reference) } class="form-layout" data-task-form>
			@page.Meta.CSRFField
			<input type="hidden" name="version" value={ fmt.Sprint(page.Version) }/>
			<input type="hidden" name="action" value={ action }/>
			<div class="form-field">@components.FieldLabel(action+"-evidence-category", "Categoria de verificação", true)<select id={ action+"-evidence-category" } name="evidence_category" required><option value="">Selecione</option><option value="CLUB_REGISTRATION_RECORD" selected?={ page.Action == action && page.EvidenceCategory == "CLUB_REGISTRATION_RECORD" }>Registo de inscrição do clube</option><option value="IN_PERSON_ID_AND_CIVIL_RECORD" selected?={ page.Action == action && page.EvidenceCategory == "IN_PERSON_ID_AND_CIVIL_RECORD" }>Identificação presencial e registo civil</option><option value="COURT_OR_LEGAL_AUTHORITY" selected?={ page.Action == action && page.EvidenceCategory == "COURT_OR_LEGAL_AUTHORITY" }>Tribunal ou autoridade legal</option></select>@components.FieldHelp(action+"-evidence-category-help", "Registe apenas a categoria observada; não introduza referências, números ou cópias.")</div>
			<div class="form-field">@components.FieldLabel(action+"-reason-code", "Motivo", true)<select id={ action+"-reason-code" } name="reason_code" required><option value="">Selecione</option>
				for _, reason := range reasons {
					<option value={ reason.Code } selected?={ page.Action == action && page.ReasonCode == reason.Code }>{ reason.Label }</option>
				}
			</select></div>
			if page.RequirePassword {
				<div class="form-field">@components.FieldLabel(action+"-password", "Palavra-passe atual", true)<input id={ action+"-password" } name="password" type="password" autocomplete="current-password" required/>@components.FieldHelp(action+"-password-help", "A sessão tem mais de uma hora. Confirme a identidade para decidir.")</div>
			}
			<label><input type="checkbox" name="attested" value="yes" required/> Confirmo que observei a categoria indicada e apliquei a política, sem guardar conteúdo do comprovativo.</label>
			if destructive {
				<label><input id={ action+"-access-end-confirmed" } type="checkbox" name="access_end_confirmed" value="yes" required/> Confirmo que esta ação termina imediatamente o acesso.</label>
			}
			<button class="action action--primary" type="submit">{ label }</button>
		</form>
	</details>
}
