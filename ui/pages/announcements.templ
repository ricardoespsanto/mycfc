package pages

import (
    "fmt"
    "github.com/cfcoimbra/mycfc/internal/validation"
    "github.com/cfcoimbra/mycfc/ui/components"
)

type AnnouncementAudience struct { ID, Name string; Selected bool }
type AnnouncementItem struct { ID, Title, PublishedAt string; Unread bool }
type AuthoredAnnouncement struct { ID, Title, Status string }
type AnnouncementForm struct {
    CSRFField templ.Component
    Title, Body, ExpiresAt, DocumentURL, DocumentSource, ReviewedOn string
    GuardianSelected bool
    Programmes, Teams, Categories, Modalities, Events []AnnouncementAudience
    Errors validation.FieldErrors
}
type AnnouncementsPage struct { Meta components.PageMeta; Management, CanManage bool; VisiblePreviousURL, VisibleNextURL, AuthoredPreviousURL, AuthoredNextURL, Success string; Items []AnnouncementItem; Authored []AuthoredAnnouncement; Form AnnouncementForm }
type AnnouncementDetailPage struct { Meta components.PageMeta; Title, Body, PublishedAt, DocumentURL, DocumentSource, DocumentReviewedOn string }
type AnnouncementPanelPage struct { UnreadCount int64; Items []AnnouncementItem }

templ AnnouncementPanel(page AnnouncementPanelPage) {
    <div class="announcement-panel__content" data-announcement-count={ fmt.Sprint(page.UnreadCount) }>
        <header>
            <div><span>Atividade</span><h2 id="announcement-panel-title">Avisos</h2></div>
            <button type="button" data-announcement-close aria-label="Fechar avisos">Fechar</button>
        </header>
        if len(page.Items) == 0 {
            <p class="announcement-panel__empty">Não há avisos ativos. As novas comunicações do clube aparecerão aqui.</p>
        } else {
            <ul class="announcement-panel__list">
                for _, item := range page.Items {
                    <li class={ templ.KV("announcement-panel__item--unread", item.Unread) }>
                        <a href={ "/announcements/" + item.ID }>
                            <strong>{ item.Title }</strong>
                            <small>{ item.PublishedAt }
                                if item.Unread {
                                    <span>Por ler</span>
                                }
                            </small>
                        </a>
                    </li>
                }
            </ul>
        }
    </div>
}

templ Announcements(page AnnouncementsPage) { @components.Base(page.Meta, announcementsContent(page)) }
templ announcementsContent(page AnnouncementsPage) {
	if page.Management {
		@components.PageHeader("Administração", "Avisos", "Crie, publique e retire comunicações dirigidas aos públicos do clube.", announcementPageActions(page))
	} else {
		@components.PageHeader("Atividade", "Avisos", "Comunicados relevantes para as suas inscrições e responsabilidades.", nil)
	}
	@components.StatusMessage(page.Success, "success")
	if !page.Management {
		<section class="module">
			@components.SectionHeading("", "Avisos para si", "Informação publicada para os seus programas, equipas e responsabilidades.")
			@announcementItems(page)
		</section>
	}
	if page.Management {
		@AnnouncementAuthoringForm(page.Form)
		<section class="module">
			@components.SectionHeading("", "Avisos publicados", "Rascunhos e comunicações publicadas por si.")
            @authoredAnnouncementItems(page)
        </section>
    }
}
templ announcementItems(page AnnouncementsPage) {
        if len(page.Items) == 0 {
            @components.EmptyState("Sem avisos ativos", "Quando o clube publicar algo relevante, aparece aqui.")
        }
        if len(page.Items) > 0 {
            @components.RecordList("Avisos para si") {
                for _, item := range page.Items {
                    @components.RecordItem(item.Title, "/announcements/" + item.ID, item.PublishedAt) {
                        if item.Unread {
                            @components.Badge("Não lido", "selected")
                        } else {
                            @components.Badge("Lido", "success")
                        }
                    }
                }
            }
        }
        if page.VisiblePreviousURL != "" || page.VisibleNextURL != "" {
            <nav class="pagination" aria-label="Paginação de avisos para si">
                if page.VisiblePreviousURL != "" {
                    <a href={ templ.SafeURL(page.VisiblePreviousURL) }>Anterior</a>
                }
                if page.VisibleNextURL != "" {
                    <a href={ templ.SafeURL(page.VisibleNextURL) }>Seguinte</a>
                }
            </nav>
        }
}
templ authoredAnnouncementItems(page AnnouncementsPage) {
        if len(page.Authored) == 0 {
            @components.EmptyState("Ainda sem avisos publicados", "Crie um rascunho quando precisar de comunicar com um público do clube.")
        }
        if len(page.Authored) > 0 {
        @components.RecordList("Avisos que publicou") {
            for _, item := range page.Authored {
                <li class="record-item"><div class="record-item__copy"><h3>{ item.Title }<span class="visually-hidden"> { item.Status }</span></h3><p class="record-meta">{ announcementStatusLabel(item.Status) }</p></div>
                    <details class="inline-disclosure"><summary>Ações</summary><div class="record-item__actions">
                    @components.Badge(announcementStatusLabel(item.Status), announcementStatusTone(item.Status))
                    if item.Status == "DRAFT" {
                        <form method="post" action={ "/admin/announcements/" + item.ID + "/publish" }>@page.Form.CSRFField<button class="action action--secondary" type="submit">Publicar aviso</button></form>
                    }
                    if item.Status == "PUBLISHED" {
                        <form method="post" action={ "/admin/announcements/" + item.ID + "/expire" }>@page.Form.CSRFField<button class="action action--secondary" type="submit">Expirar</button></form>
                    }
                    </div></details>
                </li>
            }
        }
        }
        if page.AuthoredPreviousURL != "" || page.AuthoredNextURL != "" {
            <nav class="pagination" aria-label="Paginação dos meus avisos">
                if page.AuthoredPreviousURL != "" {
                    <a href={ templ.SafeURL(page.AuthoredPreviousURL) }>Anterior</a>
                }
                if page.AuthoredNextURL != "" {
                    <a href={ templ.SafeURL(page.AuthoredNextURL) }>Seguinte</a>
                }
            </nav>
        }
}
templ AnnouncementAuthoringForm(form AnnouncementForm) {
    <details id="criar-aviso" class="module disclosure create-panel" data-create-panel open?={ len(form.Errors) > 0 } aria-labelledby="announcement-authoring-title"><summary><span><strong id="announcement-authoring-title">Criar aviso</strong><small>Prepare uma comunicação para os públicos certos.</small></span></summary><button class="create-panel__close" type="button">Fechar</button><div class="disclosure__content">
    @components.ErrorSummary(components.FieldErrorsFor(map[string]string(form.Errors), []components.FieldErrorRef{{Key: "title", Field: "announcement-title"}, {Key: "body", Field: "announcement-body"}, {Key: "document_url", Field: "announcement-document-url"}, {Key: "document_source", Field: "announcement-document-source"}, {Key: "reviewed_on", Field: "announcement-reviewed-on"}, {Key: "expires_at", Field: "announcement-expires"}, {Key: "audience", Field: "announcement-audience"}}))
    <form class="form-layout" method="post" action="/admin/announcements">@form.CSRFField
        @components.RequiredNote()
        @components.FieldLabel("announcement-title", "Título", true)<input id="announcement-title" name="title" value={ form.Title } required aria-invalid?={ form.Errors["title"] != "" } aria-describedby="announcement-title-help title-error"/>@components.FieldHelp("announcement-title-help", "Use um título curto que identifique claramente o assunto.")@components.FieldErrorMessage("title", form.Errors["title"])
        @components.FieldLabel("announcement-body", "Mensagem", true)<textarea id="announcement-body" name="body" required aria-invalid?={ form.Errors["body"] != "" } aria-describedby="announcement-body-help body-error">{ form.Body }</textarea>@components.FieldHelp("announcement-body-help", "Explique o que mudou e o que o destinatário precisa de fazer.")@components.FieldErrorMessage("body", form.Errors["body"])
        <details><summary>Documento oficial (opcional)</summary><fieldset><legend>Caderno de prova ou documento oficial</legend><p>Publique apenas uma ligação HTTPS revista. A fonte e a data de revisão ficam registadas no aviso.</p>
            @components.FieldLabel("announcement-document-url", "Ligação para PDF/documento", false)<input id="announcement-document-url" name="document_url" type="url" inputmode="url" value={ form.DocumentURL } aria-invalid?={ form.Errors["document_url"] != "" } aria-describedby="document_url-error"/>@components.FieldErrorMessage("document_url", form.Errors["document_url"])
            @components.FieldLabel("announcement-document-source", "Fonte oficial", false)<input id="announcement-document-source" name="document_source" value={ form.DocumentSource } aria-invalid?={ form.Errors["document_source"] != "" } aria-describedby="document_source-error"/>@components.FieldErrorMessage("document_source", form.Errors["document_source"])
            @components.FieldLabel("announcement-reviewed-on", "Revisto em", false)<input id="announcement-reviewed-on" name="reviewed_on" type="date" value={ form.ReviewedOn } aria-invalid?={ form.Errors["reviewed_on"] != "" } aria-describedby="reviewed_on-error"/>@components.FieldErrorMessage("reviewed_on", form.Errors["reviewed_on"])
        </fieldset></details>
        @components.FieldLabel("announcement-expires", "Expira em (opcional)", false)<input id="announcement-expires" type="datetime-local" name="expires_at" value={ form.ExpiresAt } aria-invalid?={ form.Errors["expires_at"] != "" } aria-describedby="expires_at-error"/>@components.FieldErrorMessage("expires_at", form.Errors["expires_at"])
        <details id="announcement-audience" open?={ form.Errors["audience"] != "" }><summary>Contexto e destinatários</summary><fieldset><legend>Contexto e destinatários</legend><p>Os públicos selecionados somam-se. Selecione o evento de competição e/ou a modalidade aplicável. Treinadores só podem usar os seus programas, equipas e eventos.</p>
            <label><input type="checkbox" name="guardian" value="true" checked?={ form.GuardianSelected }/> Tutores</label>
            for _, item := range form.Programmes {
                <label><input type="checkbox" name="programme_id" value={ item.ID } checked?={ item.Selected }/> { item.Name }</label>
            }
            for _, item := range form.Teams {
                <label><input type="checkbox" name="team_id" value={ item.ID } checked?={ item.Selected }/> { item.Name }</label>
            }
            for _, item := range form.Categories {
                <label><input type="checkbox" name="category_id" value={ item.ID } checked?={ item.Selected }/> { item.Name }</label>
            }
            for _, item := range form.Modalities {
                <label><input type="checkbox" name="modality_id" value={ item.ID } checked?={ item.Selected }/> { item.Name }</label>
            }
            for _, item := range form.Events {
                <label><input type="checkbox" name="event_id" value={ item.ID } checked?={ item.Selected }/> { item.Name }</label>
            }
        </fieldset></details>@components.FieldErrorMessage("audience", form.Errors["audience"])
		@components.FormActions("/admin/avisos") {
            <button class="action action--primary" name="action" value="publish" type="submit">Publicar aviso</button>
            <button class="action action--secondary" name="action" value="draft" type="submit">Guardar rascunho</button>
        }
    </form></div></details>
}
templ AnnouncementDetail(page AnnouncementDetailPage) { @components.Base(page.Meta, announcementDetailContent(page)) }
templ announcementDetailContent(page AnnouncementDetailPage) {
    @components.PageHeader("Aviso · " + page.PublishedAt, page.Title, page.Body, []components.PageAction{{Label: "Voltar ao início", Href: "/today", Variant: "quiet"}})
    if page.DocumentURL != "" {
        <section class="module">
            @components.SectionHeading("Referência", "Documento oficial", "Fonte: " + page.DocumentSource + " · Revisto em: " + page.DocumentReviewedOn) {
                <a class="action action--secondary" href={ page.DocumentURL } target="_blank" rel="noopener noreferrer">Abrir documento</a>
            }
        </section>
    }
}

func announcementPageActions(page AnnouncementsPage) []components.PageAction {
    if page.Management {
        return []components.PageAction{{Label: "Criar aviso", Href: "#criar-aviso", Variant: "primary"}}
    }
    return nil
}

func announcementStatusLabel(status string) string {
    switch status {
    case "DRAFT": return "Rascunho"
    case "PUBLISHED": return "Publicado"
    case "EXPIRED": return "Retirado"
    default: return status
    }
}

func announcementStatusTone(status string) string {
    switch status {
    case "PUBLISHED": return "success"
    case "DRAFT": return "warning"
    case "EXPIRED": return "error"
    default: return "selected"
    }
}
