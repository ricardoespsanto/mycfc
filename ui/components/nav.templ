package components

import "strings"

type NavigationItem struct {
	Label string
	Path  string
}

// NavigationGroup clusters related destinations under an optional label. All
// groups remain visible so people with several responsibilities can see their
// complete working context without switching roles or opening menus.
type NavigationGroup struct {
	Label        string
	Items        []NavigationItem
	Capabilities []string
}

templ Navigation(currentPath string, groups []NavigationGroup) {
	<nav aria-label="Navegação principal" class="site-nav">
		for _, group := range groups {
			if len(group.Items) > 0 {
				<div class="site-nav__section">
				if group.Label != "" {
					<p>{ group.Label }</p>
				}
				<ul>
					for _, item := range group.Items {
						@navItem(currentPath, item)
					}
				</ul>
				</div>
			}
		}
	</nav>
}

templ navItem(currentPath string, item NavigationItem) {
	<li>
		if navigationMatches(currentPath, item.Path) {
			<a href={ item.Path } aria-current="page">{ item.Label }</a>
		} else {
			<a href={ item.Path }>{ item.Label }</a>
		}
	</li>
}

func navigationMatches(currentPath, itemPath string) bool { return currentPath == itemPath || (itemPath != "/today" && strings.HasPrefix(currentPath, itemPath+"/")) }
