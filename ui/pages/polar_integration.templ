package pages

import (
  "github.com/cfcoimbra/mycfc/ui/components"
)

type PolarIntegrationPage struct {
  Meta components.PageMeta
  Connected, Available, NeedsReauthorization bool
  Status, Error string
}

templ PolarIntegration(page PolarIntegrationPage) {
  @components.Base(page.Meta, polarIntegrationContent(page))
}

templ polarIntegrationContent(page PolarIntegrationPage) {
  <div class="profile-page">
    @components.PageHeader("Conta", "Polar Flow", "Ligue voluntariamente a sua conta Polar para trazer atividades recentes para o MyCFCoimbra.", []components.PageAction{{Label: "Voltar ao perfil", Href: "/perfil", Variant: "secondary"}})
    @components.StatusMessage(page.Status, "success")
    @components.StatusMessage(page.Error, "error")
    <section class="module" aria-labelledby="polar-connection-title">
      <h2 id="polar-connection-title">Ligação Polar</h2>
      if !page.Available {
        <p>A ligação Polar ainda não está disponível. Pode continuar a usar o MyCFCoimbra normalmente.</p>
      }
      if page.Available && !page.Connected {
        <p>Ao continuar, a Polar pedirá autorização para o MyCFCoimbra ler as suas atividades. Pode desligar quando quiser.</p>
        <form method="post" action="/perfil/integracoes/polar/ligar">@page.Meta.CSRFField<button class="action" type="submit">Ligar a Polar Flow</button></form>
      }
      if page.Connected {
        <p>Polar Flow está ligada. Só são lidas atividades recentes; isto não altera a sua participação em treinos ou eventos.</p>
        if page.NeedsReauthorization {
          <p class="field-hint">A Polar pediu uma nova autorização. Volte a ligar para continuar a sincronizar.</p>
        }
        <div class="task-actions">
          <form method="post" action="/perfil/integracoes/polar/sincronizar">@page.Meta.CSRFField<button class="action action--secondary" type="submit">Sincronizar agora</button></form>
          <form method="post" action="/perfil/integracoes/polar/desligar">@page.Meta.CSRFField<button class="action action--danger" type="submit">Desligar Polar Flow</button></form>
        </div>
      }
    </section>
  </div>
}
