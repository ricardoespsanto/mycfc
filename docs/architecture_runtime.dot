digraph MyCFCRuntime {
  graph [
    rankdir=TB,
    splines=polyline,
    compound=true,
    newrank=true,
    bgcolor="white",
    pad="0.35",
    nodesep="0.55",
    ranksep="0.7",
    fontname="Arial",
    fontsize=24,
    label="MyCFC — Production Runtime Architecture",
    labelloc=t,
    labeljust=c
  ];

  node [
    shape=box,
    style="rounded,filled",
    fillcolor="#ffffff",
    color="#425466",
    penwidth=1.3,
    fontname="Arial",
    fontsize=12,
    margin="0.18,0.12"
  ];

  edge [
    color="#5b6775",
    penwidth=1.2,
    arrowsize=0.75,
    fontname="Arial",
    fontsize=10
  ];

  subgraph cluster_external {
    label="External clients and services";
    color="#c8d0d9";
    style="rounded,dashed";
    penwidth=1.1;
    margin=18;

    users [label="Members and administrators\nWeb browser", fillcolor="#f5f7fa"];
  }

  subgraph cluster_aws {
    label="AWS production account / region";
    color="#8ea0b2";
    style="rounded";
    penwidth=1.5;
    margin=24;

    route53 [label="Route 53\nA / AAAA aliases", fillcolor="#eef5ff"];
    waf [label="AWS WAF\nmanaged rules + rate limits", fillcolor="#fff6e8"];
    acm [label="ACM\nDNS-validated TLS certificate", fillcolor="#eef5ff"];
    { rank=same; route53; waf; acm; }

    subgraph cluster_vpc {
      label="VPC 10.42.0.0/16 across 3 availability zones";
      color="#aebbc7";
      style="rounded,dashed";
      penwidth=1.2;
      margin=20;

      subgraph cluster_public {
        label="Public subnets";
        color="#b8d3f2";
        style="rounded,dashed";
        margin=14;
        alb [label="Application Load Balancer\nHTTPS 443 · HTTP→HTTPS redirect", fillcolor="#eaf3ff"];
      }

      subgraph cluster_app {
        label="Private application subnets — no public IP · no NAT";
        color="#b7ddca";
        style="rounded,dashed";
        margin=14;
        ecs [label="ECS Fargate application service\n2–6 non-root tasks · port 8080", fillcolor="#ebf8f1"];
        endpoints [label="Private VPC endpoints\nECR · Logs · Secrets · SSM · KMS · STS\nS3 gateway endpoint", fillcolor="#f1f8fb"];
        { rank=same; ecs; endpoints; }
      }

      subgraph cluster_db {
        label="Isolated database subnets";
        color="#efc3c3";
        style="rounded,dashed";
        margin=14;
        rds [label="RDS PostgreSQL 16\nMulti-AZ · encrypted · private", fillcolor="#fff0f0"];
      }

      alb -> ecs [label="HTTP 8080 · security-group reference"];
      ecs -> rds [label="PostgreSQL 5432 · application DB role"];
      ecs -> endpoints [label="private AWS service access", constraint=false];
    }

    s3 [label="Private S3 application bucket\nrepair photos under repairs/*\nversioned + encrypted", fillcolor="#f3f9e9"];
    secrets [label="Secrets Manager / SSM\nDB credentials · CSRF key · runtime config", fillcolor="#f6f1ff"];
    ecr [label="ECR\nimmutable image digests", fillcolor="#f6f1ff"];
    cloudwatch [label="CloudWatch\nlogs · metrics · dashboards · alarms", fillcolor="#f6f1ff"];
    events [label="EventBridge + SNS\nservice and alarm notifications", fillcolor="#f6f1ff"];
    { rank=same; s3; secrets; ecr; cloudwatch; events; }

    endpoints -> s3 [label="Put/Get/Delete repairs/*"];
    endpoints -> secrets [label="secret/config retrieval"];
    endpoints -> ecr [label="task-start image pull", dir=back];
    endpoints -> cloudwatch [label="logs and metrics"];
    cloudwatch -> events [label="alarm or event"];

    ecs -> cloudwatch [label="application telemetry", style=dashed, color="#7c8794", constraint=false];
    alb -> cloudwatch [label="access logs and metrics", style=dashed, color="#7c8794", constraint=false];
    rds -> cloudwatch [label="database telemetry", style=dashed, color="#7c8794", constraint=false];
  }

  users -> route53 [label="DNS lookup", style=dashed, color="#7c8794"];
  users -> waf [label="HTTPS request"];
  route53 -> alb [label="alias resolves to ALB", style=dashed, color="#7c8794"];
  waf -> alb [label="Web ACL attached to ALB"];
  acm -> alb [label="TLS certificate", style=dashed, color="#7c8794"];
  users -> s3 [label="short-lived pre-signed image GET", style=dashed, color="#7c8794", constraint=false];

  runtime_note [
    shape=note,
    label="Scope rule\nThis diagram shows running components and request/data flows only.\nBuilds, Terraform state, migrations and deployment orchestration belong in architecture_delivery_pipeline.svg.",
    fillcolor="#fffdf2",
    color="#b9a96a",
    fontsize=10
  ];
  events -> runtime_note [style=invis];
}
