[Unit]
Description=MyCFC exact-version PostgreSQL backup cleanup
After=network-online.target
Wants=network-online.target
OnSuccess=mycfc-postgres-backup-version-cleanup-log.service
OnFailure=mycfc-postgres-backup-version-cleanup-log.service

[Service]
Type=oneshot
ExecStart=/opt/mycfc/deployment/postgres-backup-version-cleanup.sh
DynamicUser=true
User=mycfc-backup-cleanup
LoadCredential=cleanup-env:/etc/mycfc/backup-cleanup.env
LoadCredential=aws-credentials:/etc/mycfc/backup-cleanup-aws/credentials
RuntimeDirectory=mycfc-backup-cleanup
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
InaccessiblePaths=/etc/mycfc
LockPersonality=true
MemoryDenyWriteExecute=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RemoveIPC=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
