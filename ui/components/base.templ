package components

type PageMeta struct {
	Title         string
	StylesheetURL string
	ScriptURL     string
	CurrentPath   string
	CurrentUserName string
	Navigation    []NavigationItem
	CSRFField     templ.Component
}

templ Base(meta PageMeta, content templ.Component) {
	<!doctype html>
	<html lang="pt-PT">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ meta.Title }</title>
			<link rel="stylesheet" href={ meta.StylesheetURL }/>
			<script src={ meta.ScriptURL } defer></script>
		</head>
		<body>
			<a class="skip-link" href="#conteudo-principal">Saltar para o conteúdo principal</a>
			if len(meta.Navigation) > 0 {
				<header class="site-header"><div class="site-header__content"><a class="site-brand" href="/dashboard">MyCFC</a>@Navigation(meta.CurrentPath, meta.Navigation)<form method="post" action="/logout">@meta.CSRFField<button class="logout-button" type="submit">Terminar sessão</button></form></div></header>
			}
			<main id="conteudo-principal">
				@content
			</main>
			<footer class="site-footer">Clube Fluvial de Coimbra</footer>
		</body>
	</html>
}
