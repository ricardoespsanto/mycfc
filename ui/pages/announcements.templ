package pages

import (
    "github.com/cfcoimbra/mycfc/internal/validation"
    "github.com/cfcoimbra/mycfc/ui/components"
)

type AnnouncementAudience struct { ID, Name string }
type AnnouncementItem struct { ID, Title, PublishedAt string; Unread bool }
type AuthoredAnnouncement struct { ID, Title, Status string }
type AnnouncementForm struct {
    CSRFField templ.Component
    Title, Body, ExpiresAt, DocumentURL, DocumentSource, ReviewedOn string
    Programmes, Teams, Categories, Modalities, Events []AnnouncementAudience
    Errors validation.FieldErrors
}
type AnnouncementsPage struct { Meta components.PageMeta; CanManage bool; VisiblePreviousURL, VisibleNextURL, AuthoredPreviousURL, AuthoredNextURL string; Items []AnnouncementItem; Authored []AuthoredAnnouncement; Form AnnouncementForm }
type AnnouncementDetailPage struct { Meta components.PageMeta; Title, Body, PublishedAt, DocumentURL, DocumentSource, DocumentReviewedOn string }

templ Announcements(page AnnouncementsPage) { @components.Base(page.Meta, announcementsContent(page)) }
templ announcementsContent(page AnnouncementsPage) {
    @components.PageHeader("Comunidade", "Avisos", "Comunicados relevantes para as suas inscrições e responsabilidades.", nil)
    @components.Surface("Para si", announcementItems(page))
    if page.CanManage {
        @AnnouncementAuthoringForm(page.Form)
        @components.Surface("Os meus avisos", authoredAnnouncementItems(page))
    }
}
templ announcementItems(page AnnouncementsPage) {
        if len(page.Items) == 0 {
            @components.EmptyState("Sem avisos ativos", "Quando o clube publicar algo relevante, aparece aqui.")
        }
        if len(page.Items) > 0 {
            <ul class="content-list">
                for _, item := range page.Items {
                    <li><a href={ "/announcements/" + item.ID }>{ item.Title }</a> <span>{ item.PublishedAt }</span>
                        if item.Unread {
                            @components.Badge("Não lido", "selected")
                        }
                    </li>
                }
            </ul>
        }
        if page.VisiblePreviousURL != "" || page.VisibleNextURL != "" {
            <nav class="pagination" aria-label="Paginação de avisos para si">
                if page.VisiblePreviousURL != "" {
                    <a href={ templ.SafeURL(page.VisiblePreviousURL) }>Anterior</a>
                }
                if page.VisibleNextURL != "" {
                    <a href={ templ.SafeURL(page.VisibleNextURL) }>Seguinte</a>
                }
            </nav>
        }
}
templ authoredAnnouncementItems(page AnnouncementsPage) { <ul class="content-list">
            for _, item := range page.Authored {
                <li>{ item.Title } · { item.Status }
                    if item.Status == "DRAFT" {
                        <details class="inline-disclosure"><summary>Ações</summary><form class="inline-action" method="post" action={ "/admin/announcements/" + item.ID + "/publish" }>@page.Form.CSRFField<button type="submit">Publicar</button></form></details>
                    }
                    if item.Status == "PUBLISHED" {
                        <details class="inline-disclosure"><summary>Ações</summary><form class="inline-action" method="post" action={ "/admin/announcements/" + item.ID + "/expire" }>@page.Form.CSRFField<button type="submit">Expirar</button></form></details>
                    }
                </li>
            }
        </ul>
        if page.AuthoredPreviousURL != "" || page.AuthoredNextURL != "" {
            <nav class="pagination" aria-label="Paginação dos meus avisos">
                if page.AuthoredPreviousURL != "" {
                    <a href={ templ.SafeURL(page.AuthoredPreviousURL) }>Anterior</a>
                }
                if page.AuthoredNextURL != "" {
                    <a href={ templ.SafeURL(page.AuthoredNextURL) }>Seguinte</a>
                }
            </nav>
        }
}
templ AnnouncementAuthoringForm(form AnnouncementForm) {
    <details class="dashboard-card disclosure-card" open?={ len(form.Errors) > 0 }><summary><span class="disclosure-card__title">Criar aviso</span><span class="disclosure-card__summary">Prepare uma comunicação para os públicos certos.</span></summary><div class="disclosure-card__content"><form class="form-layout" method="post" action="/admin/announcements">@form.CSRFField
        <label for="announcement-title">Título</label><input id="announcement-title" name="title" value={ form.Title } required/>@components.FieldErrorMessage("title", form.Errors["title"])
        <label for="announcement-body">Mensagem</label><textarea id="announcement-body" name="body" required>{ form.Body }</textarea>@components.FieldErrorMessage("body", form.Errors["body"])
        <details><summary>Documento oficial (opcional)</summary><fieldset><legend>Caderno de prova ou documento oficial</legend><p>Publique apenas uma ligação HTTPS revista. A fonte e a data de revisão ficam registadas no aviso.</p>
            <label for="announcement-document-url">Ligação para PDF/documento</label><input id="announcement-document-url" name="document_url" type="url" inputmode="url" value={ form.DocumentURL }/>@components.FieldErrorMessage("document_url", form.Errors["document_url"])
            <label for="announcement-document-source">Fonte oficial</label><input id="announcement-document-source" name="document_source" value={ form.DocumentSource }/>@components.FieldErrorMessage("document_source", form.Errors["document_source"])
            <label for="announcement-reviewed-on">Revisto em</label><input id="announcement-reviewed-on" name="reviewed_on" type="date" value={ form.ReviewedOn }/>@components.FieldErrorMessage("reviewed_on", form.Errors["reviewed_on"])
        </fieldset></details>
        <label for="announcement-expires">Expira em (opcional)</label><input id="announcement-expires" type="datetime-local" name="expires_at" value={ form.ExpiresAt }/>@components.FieldErrorMessage("expires_at", form.Errors["expires_at"])
        <details><summary>Contexto e destinatários</summary><fieldset><legend>Contexto e destinatários</legend><p>Os públicos selecionados somam-se. Selecione o evento de competição e/ou a modalidade aplicável. Treinadores só podem usar os seus programas, equipas e eventos.</p>
            <label><input type="checkbox" name="guardian" value="true"/> Tutores</label>
            for _, item := range form.Programmes {
                <label><input type="checkbox" name="programme_id" value={ item.ID }/> { item.Name }</label>
            }
            for _, item := range form.Teams {
                <label><input type="checkbox" name="team_id" value={ item.ID }/> { item.Name }</label>
            }
            for _, item := range form.Categories {
                <label><input type="checkbox" name="category_id" value={ item.ID }/> { item.Name }</label>
            }
            for _, item := range form.Modalities {
                <label><input type="checkbox" name="modality_id" value={ item.ID }/> { item.Name }</label>
            }
            for _, item := range form.Events {
                <label><input type="checkbox" name="event_id" value={ item.ID }/> { item.Name }</label>
            }
        </fieldset></details>@components.FieldErrorMessage("audience", form.Errors["audience"])
        <button name="action" value="draft" type="submit">Guardar rascunho</button><button name="action" value="publish" type="submit">Publicar</button>
    </form></div></details>
}
templ AnnouncementDetail(page AnnouncementDetailPage) { @components.Base(page.Meta, announcementDetailContent(page)) }
templ announcementDetailContent(page AnnouncementDetailPage) {
    <section class="dashboard-hero"><p class="eyebrow">Aviso · { page.PublishedAt }</p><h1>{ page.Title }</h1><p>{ page.Body }</p></section>
    if page.DocumentURL != "" {
        <section class="dashboard-card"><h2>Documento oficial</h2><p><a href={ page.DocumentURL } target="_blank" rel="noopener noreferrer">Abrir caderno de prova ou documento</a></p><p>Fonte: { page.DocumentSource } · Revisto em: { page.DocumentReviewedOn }</p></section>
    }
}
