# Test-only MinIO image. The upstream registry images are no longer available;
# retain the existing releases and verify their official GitHub asset hashes.
# Keep the upstream image's root runtime so existing local /data volumes remain writable.
FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6

ARG TARGETARCH
SHELL ["/bin/ash", "-e", "-o", "pipefail", "-c"]

RUN apk add --no-cache ca-certificates curl \
    && arch="${TARGETARCH:-$(uname -m)}" \
    && case "${arch}" in \
         amd64|x86_64) arch=amd64; minio_sha='7c5bd8512c6e966455b1d198209358b2d191c77a83ab377c4073281065fb855f'; mc_sha='01f866e9c5f9b87c2b09116fa5d7c06695b106242d829a8bb32990c00312e891' ;; \
         arm64|aarch64) arch=arm64; minio_sha='5c83cd2cf151717ba0243f73e1c7802ff36e272b67144bdd7f1f7d684fd6f03d'; mc_sha='14c8c9616cfce4636add161304353244e8de383b2e2752c0e9dad01d4c27c12c' ;; \
         *) echo "unsupported MinIO test architecture: ${arch}" >&2; exit 1 ;; \
       esac \
    && curl --fail --location --silent --show-error --retry 3 --output /usr/local/bin/minio \
         "https://github.com/minio/minio/releases/download/RELEASE.2025-09-07T16-13-09Z/minio.linux-${arch}.RELEASE.2025-09-07T16-13-09Z" \
    && echo "${minio_sha}  /usr/local/bin/minio" | sha256sum -c - \
    && curl --fail --location --silent --show-error --retry 3 --output /usr/local/bin/mc \
         "https://github.com/minio/mc/releases/download/RELEASE.2025-08-13T08-35-41Z/mc.linux-${arch}.RELEASE.2025-08-13T08-35-41Z" \
    && echo "${mc_sha}  /usr/local/bin/mc" | sha256sum -c - \
    && chmod 0755 /usr/local/bin/minio /usr/local/bin/mc \
    && mkdir -p /data

WORKDIR /data
EXPOSE 9000 9001
ENTRYPOINT ["/usr/local/bin/minio"]
