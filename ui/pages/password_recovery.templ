package pages

import (
	"github.com/cfcoimbra/mycfc/internal/validation"
	"github.com/cfcoimbra/mycfc/ui/components"
)

type PasswordRecoveryRequestPage struct {
	Meta components.PageMeta
	CSRFField templ.Component
}

templ PasswordRecoveryRequest(page PasswordRecoveryRequestPage) {
	@components.AuthBase(page.Meta, passwordRecoveryRequestContent(page))
}

templ passwordRecoveryRequestContent(page PasswordRecoveryRequestPage) {
	<section class="auth-card auth-card--login" aria-labelledby="password-recovery-title">
		<p class="eyebrow">Conta MyCFC</p>
		<h1 id="password-recovery-title">Recuperar palavra-passe</h1>
		<p>Indique o correio eletrónico da sua conta adulta. Se a conta puder recuperar o acesso por email, enviaremos um link.</p>
		<form class="form-layout" method="post" action="/recuperar-palavra-passe">
			@page.CSRFField
			@components.RequiredNote()
			<div class="form-field">
				@components.FieldLabel("recovery-identifier", "Correio eletrónico", true)
				<input id="recovery-identifier" name="identifier" type="text" inputmode="email" autocomplete="email" required aria-describedby="recovery-identifier-help"/>
				@components.FieldHelp("recovery-identifier-help", "Os identificadores CFC de menores são recuperados através do tutor ou da administração do clube.")
			</div>
			@components.FormActions("") { <button class="action action--primary" type="submit">Enviar instruções</button> }
		</form>
		<p class="auth-alternate"><a href="/login">Voltar a iniciar sessão</a></p>
	</section>
}

type PasswordRecoveryConfirmationPage struct { Meta components.PageMeta }

templ PasswordRecoveryConfirmation(page PasswordRecoveryConfirmationPage) {
	@components.AuthBase(page.Meta, passwordRecoveryConfirmationContent())
}

templ passwordRecoveryConfirmationContent() {
	<section class="auth-card auth-card--login" aria-labelledby="password-recovery-confirmation-title">
		<p class="eyebrow">Pedido recebido</p>
		<h1 id="password-recovery-confirmation-title">Consulte o seu email</h1>
		<p>Se os dados corresponderem a uma conta adulta elegível, receberá um link para definir uma nova palavra-passe. O link é válido durante 60 minutos.</p>
		<p>Os identificadores CFC de menores são recuperados através do tutor ou da administração do clube.</p>
		<p><a class="action action--primary" href="/login">Voltar a iniciar sessão</a></p>
	</section>
}

type PasswordRecoveryResetPage struct {
	Meta components.PageMeta
	Token string
	Errors validation.FieldErrors
	CSRFField templ.Component
}

templ PasswordRecoveryReset(page PasswordRecoveryResetPage) {
	@components.AuthBase(page.Meta, passwordRecoveryResetContent(page))
}

templ passwordRecoveryResetContent(page PasswordRecoveryResetPage) {
	<section class="auth-card auth-card--login" aria-labelledby="password-reset-title">
		<p class="eyebrow">Conta MyCFC</p>
		<h1 id="password-reset-title">Definir nova palavra-passe</h1>
		<p>Escolha uma palavra-passe que ainda não utiliza noutros serviços.</p>
		<form class="form-layout" method="post" action="/recuperar-palavra-passe/repor">
			@page.CSRFField
			<input type="hidden" name="token" value={ page.Token }/>
			@components.ErrorSummary(components.FieldErrorsFromMap(page.Errors, []string{"password", "password_confirmation"}))
			@components.RequiredNote()
			<div class="form-field">
				@components.FieldLabel("password", "Nova palavra-passe", true)
				<input id="password" name="password" type="password" autocomplete="new-password" required aria-invalid={ recoveryAriaBoolean(page.Errors.Has("password")) } aria-describedby="password-help password-error"/>
				@components.FieldHelp("password-help", "Use entre 12 e 72 bytes, com pelo menos uma letra e um carácter que não seja uma letra.")
				@components.FieldErrorMessage("password", page.Errors["password"])
			</div>
			<div class="form-field">
				@components.FieldLabel("password_confirmation", "Confirmar nova palavra-passe", true)
				<input id="password_confirmation" name="password_confirmation" type="password" autocomplete="new-password" required aria-invalid={ recoveryAriaBoolean(page.Errors.Has("password_confirmation")) } aria-describedby="password_confirmation-error"/>
				@components.FieldErrorMessage("password_confirmation", page.Errors["password_confirmation"])
			</div>
			@components.FormActions("") { <button class="action action--primary" type="submit">Alterar palavra-passe</button> }
		</form>
	</section>
}

type PasswordRecoveryInvalidPage struct { Meta components.PageMeta }

templ PasswordRecoveryInvalid(page PasswordRecoveryInvalidPage) {
	@components.AuthBase(page.Meta, passwordRecoveryInvalidContent())
}

templ passwordRecoveryInvalidContent() {
	<section class="auth-card auth-card--login" aria-labelledby="password-recovery-invalid-title">
		<p class="eyebrow">Conta MyCFC</p>
		<h1 id="password-recovery-invalid-title">Este link já não está disponível</h1>
		<p>O link é inválido, já foi utilizado, foi substituído por um pedido mais recente ou expirou.</p>
		<p><a class="action action--primary" href="/recuperar-palavra-passe">Pedir um novo link</a></p>
	</section>
}

func recoveryAriaBoolean(value bool) string { if value { return "true" }; return "false" }
