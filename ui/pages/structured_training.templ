package pages

import (
	"fmt"
	"net/url"
	"github.com/cfcoimbra/mycfc/internal/validation"
	"github.com/cfcoimbra/mycfc/ui/components"
	"strings"
)

type StructuredTrainingMembershipChoice struct{ ID, Athlete, Scope string }
type StructuredTrainingChoice struct{ ID, Name, GroupID string }
type StructuredTrainingRoutine struct{ ID, Name, Description, Kind, Visibility, Owner, Scope, Modality, Objective, Method, Tags, Preview, Provenance string }
type StructuredVariationMemberChoice struct{ ID, Athlete, GroupID, GroupName string }
type StructuredVariationTargetChoice struct{ Value, Name, GroupID string }
type StructuredVariationSubjectChoice struct{ Value, Name, PlanID string }
type StructuredVariationGroup struct {
	ID, GroupID, GroupName, Name, Kind, Craft, Period, Competition string
	Members []string
}
type StructuredVariationRule struct {
	ID, Target, Operation, Summary, Patch string
	Version int
	Applied bool
}
type StructuredVariationPreview struct {
	Athlete, Plan, Session, When, Subject, Status string
	Conflict bool
	Rules []StructuredVariationRule
}
type StructuredPublicationState struct {
	PlanID, Plan, SourceUpdatedAt, Status, PublishedAt, PublishedBy string
	Revision, AthleteCount, PrescriptionCount, ConflictCount, AddedCount, ChangedCount, RemovedCount, UnchangedCount int
}
type StructuredPrescriptionChange struct {
	Subject, Operation, Summary, Fields string
}

type StructuredGymExercise struct {
	ID, Name, Prescription, Resistance, Intent, Tempo, Notes string
	Position, Sets, Repetitions, DurationSeconds, DistanceMetres, RecoverySeconds int
}
type StructuredWaterStep struct {
	ID, ParentID, Kind, Name, Prescription, Intensity, Drill, Instructions string
	Position, Repeats, Recovery                                            int
	DurationSeconds, DistanceMetres                                        int
	DurationCertainty, DistanceCertainty                                   string
}
type StructuredWaterProfile struct {
	ID, Name, Craft, Notes string
	Revision               int
	Zones                   []StructuredWaterZone
}
type StructuredWaterZone struct{ Code, Label, Cadence, Meaning string }
type StructuredWaterTotal struct{ Label, Value, Certainty string }
type StructuredTrainingBlock struct {
	ID, Purpose, Title, Instructions, GymStructure, GymObjective, WaterMethod, WaterTarget, WaterProfile string
	WaterTargetDistanceMetres                                                             int
	WaterTargetCertainty                                                                  string
	Position, GymRounds, GymRoundRecovery                                                  int
	Exercises                                                                              []StructuredGymExercise
	WaterSteps                                                                             []StructuredWaterStep
	WaterTotals                                                                            []StructuredWaterTotal
}
type StructuredTrainingSegment struct {
	ID, Modality, Title, Location, Duration, PlannedStart, EquipmentNotes string
	Position, Transition                                                  int
	Blocks                                                                []StructuredTrainingBlock
}
type StructuredTrainingSession struct {
	ID, PrescriptionID, Title, Description, When, EntryKind string
	Outcome, ActualDuration, ActualDistance, PerceivedEffort, RecoveryFeeling, PerceptionNote, FeedbackUpdatedAt string `json:"-"`
	Modalities                              []string
	ActualDurationMinutes, ActualDistanceMetres int
	Segments                                []StructuredTrainingSegment
	Changes                                 []StructuredPrescriptionChange
}
type StructuredTrainingWeek struct {
	ID, Title, Description, Season, DateRange, PlannedLoad string
	Sessions                                               []StructuredTrainingSession
	Summary                                                StructuredTrainingWeekSummary
}
type StructuredTrainingSummaryItem struct{ Label, Value, Certainty string }
type StructuredTrainingWeekSummary struct {
	PlannedWater, SupportingWork, Actual []StructuredTrainingSummaryItem
}
type StructuredTrainingCycleWeek struct {
	ID, Title, DateRange, PlannedLoad, PlannerURL string
	Modalities                                  []string
	MissingLoad, MissingModalities, Direct       bool
}
type StructuredTrainingCycleTarget struct { ID, Label, Status string }
type StructuredTrainingCycle struct {
	ID, GroupID, GroupName, Season, ParentID, ParentName, Name, LevelLabel, Goals, Focus, DateRange, Warning string
	Version                                                                                                   int32
	Weeks                                                                                                     []StructuredTrainingCycleWeek
	Targets                                                                                                   []StructuredTrainingCycleTarget
}
type StructuredTrainingAudience struct {
	AthleteName, GroupID, GroupName, Scope string
	MemberCount                            int
	Weeks                                  []StructuredTrainingWeek
}
type StructuredTrainingSubjectChoice struct { ID, Name string; Selected, Self bool }

type StructuredTrainingGroupForm struct {
	Name, ProgrammeID, TeamID string
	MembershipIDs             map[string]bool
	Errors                    validation.FieldErrors
}
type StructuredTrainingWeekForm struct {
	GroupID, Title, Description, WeekStart, PlannedLoad string
	Errors                                              validation.FieldErrors
}
type StructuredTrainingCycleForm struct {
	CycleID, GroupID, Name, LevelLabel, Goals, Focus, Version string
	WeekIDs, ChildCycleIDs, TargetEventIDs                    map[string]bool
	Errors                                                                    validation.FieldErrors
}
type StructuredTrainingCycleCopyForm struct {
	CycleID, Name, FirstMonday string
	Errors                     validation.FieldErrors
}
type StructuredTrainingSessionForm struct {
	PlanID, Title, Description, StartsAt, EndsAt, EntryKind string
	Errors                                                  validation.FieldErrors
}
type StructuredTrainingSegmentForm struct {
	SessionID, Modality, Title, Location, Duration, StartOffset, Transition, EquipmentNotes, Purpose, BlockTitle, Instructions string
	Errors                                                                                                      validation.FieldErrors
}
type StructuredTrainingBlockForm struct {
	SegmentID, Purpose, Title, Instructions string
	Errors                                  validation.FieldErrors
}

type StructuredTrainingPage struct {
	Meta                                                        components.PageMeta
	CSRFField                                                   templ.Component
	Management                                                  bool
	CanManageWaterProfiles                                      bool
	Success, Error, OpenForm                                    string
	RoutineQuery, RoutineModality, RoutineObjective, RoutineTag string
	Audiences, PlannerAudiences                                 []StructuredTrainingAudience
	Cycles                                                       []StructuredTrainingCycle
	Subjects                                                    []StructuredTrainingSubjectChoice
	AllSubjectsSelected                                         bool
	Routines                                                    []StructuredTrainingRoutine
	Memberships                                                 []StructuredTrainingMembershipChoice
	Programmes, Teams, Groups, Weeks, Sessions, Segments        []StructuredTrainingChoice
	WaterProfiles                                               []StructuredWaterProfile
	VariationMembers                                           []StructuredVariationMemberChoice
	VariationTargets                                           []StructuredVariationTargetChoice
	VariationSubjects                                          []StructuredVariationSubjectChoice
	VariationGroups                                            []StructuredVariationGroup
	VariationPreviews                                          []StructuredVariationPreview
	Publications                                               []StructuredPublicationState
	CrewModalities, CompetitionEvents                          []StructuredTrainingChoice
	SelectedGroupID, SelectedWeekID, SelectedSessionID         string
	PlannerReturnURL                                            string
	GroupForm                                                   StructuredTrainingGroupForm
	WeekForm                                                    StructuredTrainingWeekForm
	CycleForm                                                   StructuredTrainingCycleForm
	CycleCopyForm                                               StructuredTrainingCycleCopyForm
	SessionForm                                                 StructuredTrainingSessionForm
	SegmentForm                                                 StructuredTrainingSegmentForm
	BlockForm                                                   StructuredTrainingBlockForm
}

templ StructuredTraining(page StructuredTrainingPage) {
	@components.Base(page.Meta, structuredTrainingContent(page))
}

templ structuredTrainingContent(page StructuredTrainingPage) {
	if page.Management {
		@components.PageHeader("Coordenação · Treinos", "Planeamento semanal", "Organize grupos, semanas e sessões híbridas a partir de um só lugar.", structuredTrainingActions())
	} else {
		@components.PageHeader("Atividade · Treinos", "Planeamento semanal", "Consulte as semanas e sessões destinadas a si ou aos menores pelos quais é responsável.", []components.PageAction{{Label: "Voltar aos treinos", Href: "/treinos", Variant: "quiet"}})
	}
	@components.StatusMessage(page.Success, "success")
	@components.StatusMessage(page.Error, "error")
	if !page.Management && len(page.Subjects) > 0 {
		<nav class="subject-switcher" aria-label="Pessoa no planeamento">
			<p><strong>Planeamento de</strong></p>
			if page.AllSubjectsSelected {
				<a class="action action--quiet" href="/treinos/estruturados" aria-current="page">Todas as pessoas</a>
			} else {
				<a class="action action--quiet" href="/treinos/estruturados">Todas as pessoas</a>
			}
			for _, subject := range page.Subjects {
				if subject.Selected {
					<a class="action action--quiet" href={ templ.SafeURL("/treinos/estruturados?subject_user_id=" + subject.ID) } aria-current="page">{ structuredSubjectLabel(subject) }</a>
				} else {
					<a class="action action--quiet" href={ templ.SafeURL("/treinos/estruturados?subject_user_id=" + subject.ID) }>{ structuredSubjectLabel(subject) }</a>
				}
			}
		</nav>
	}
	<div class="training-workspace" data-tab-scope>
		if page.Management {
			<nav class="collection-tabs training-workspace__tabs" aria-label="Áreas do planeamento" data-collection-tabs>
				<a href="#training-plan">Plano semanal</a>
				<a href="#training-cycles">Ciclos</a>
				<a href="#training-variations">Variações</a>
				<a href="#training-publication">Publicar</a>
				<a href="#training-routines">Rotinas</a>
				<a href="#training-copy-tools">Copiar conteúdo</a>
				if page.CanManageWaterProfiles {
					<a href="#training-intensity-profiles">Perfis de intensidade</a>
				}
			</nav>
		}
		<section id="training-plan" class="module training-plan" data-tab-panel>
			if page.Management {
				@structuredPlannerContext(page)
			}
			@components.SectionHeading("", "Semanas de treino", "Os horários são exatos; manhã e tarde são apenas agrupamentos visuais.")
			if len(page.Audiences) == 0 {
				@components.EmptyState("Ainda sem planeamento estruturado", "Quando existir uma semana no seu âmbito, ela aparece aqui.")
			}
			for _, audience := range page.Audiences {
				<article class="record-item record-item--stacked">
					<div class="record-item__copy">
						if audience.AthleteName != "" {
							<p class="eyebrow">{ audience.AthleteName }</p>
						}
						<h3>{ audience.GroupName }</h3>
						<p class="record-meta">
							{ audience.Scope }
							if page.Management {
								<span>· { fmt.Sprintf("%d atletas", audience.MemberCount) }</span>
							}
						</p>
						if len(audience.Weeks) == 0 {
							<p>Ainda sem semanas.</p>
						}
						for weekIndex, week := range audience.Weeks {
							<section class="nested-record training-card training-card--week" aria-labelledby={ "week-" + week.ID } data-training-card data-default-open={ fmt.Sprintf("%t", weekIndex == 0) }>
								<div class="training-card__header">
									<div><h4 id={ "week-" + week.ID }>{ week.Title }</h4><p class="record-meta">{ week.Season } · { week.DateRange } · { fmt.Sprintf("%d sessões", len(week.Sessions)) }</p></div>
									<button class="action action--quiet training-card__toggle" type="button" aria-expanded="true" aria-controls={ "week-content-" + week.ID } data-training-toggle><span data-training-toggle-label>Ocultar</span></button>
								</div>
								<div id={ "week-content-" + week.ID } class="training-card__body">
									if week.Description != "" {
										<p>{ week.Description }</p>
									}
									if week.PlannedLoad != "" {
										<p class="record-meta"><strong>Carga planeada:</strong> { week.PlannedLoad } <span>— distribuição definida pelo treinador; não é uma medição do atleta.</span></p>
									}
									if len(week.Summary.PlannedWater) > 0 || len(week.Summary.SupportingWork) > 0 || len(week.Summary.Actual) > 0 {
										<section class="nested-record" aria-label="Resumo semanal">
											<h5>Resumo semanal</h5>
											if len(week.Summary.PlannedWater) > 0 {
												<p><strong>Água planeada</strong></p>
												<dl class="training-totals" aria-label="Totais de água planeados na semana">
													for _, total := range week.Summary.PlannedWater {
														<div><dt>{ total.Label }</dt><dd>{ total.Value } <span class="record-meta">{ total.Certainty }</span></dd></div>
													}
												</dl>
											}
											if len(week.Summary.SupportingWork) > 0 {
												<p><strong>Trabalho complementar planeado</strong></p>
												<ul class="record-list">
													for _, item := range week.Summary.SupportingWork {
														<li>{ item.Label }: { item.Value } <span class="record-meta">{ item.Certainty }</span></li>
													}
												</ul>
											}
											if len(week.Summary.Actual) > 0 {
												<p><strong>Registo real do atleta</strong></p>
												<dl class="training-totals" aria-label="Dados reais registados pelo atleta">
													for _, total := range week.Summary.Actual {
														<div><dt>{ total.Label }</dt><dd>{ total.Value } <span class="record-meta">{ total.Certainty }</span></dd></div>
													}
												</dl>
											}
										</section>
									}
									if page.Management {
										<div class="training-actions">@structuredWeekLoadForm(page, week) @structuredCopyWeekForm(page, week)
</div>
									}
									if len(week.Sessions) == 0 {
										<p class="record-meta">Ainda sem sessões.</p>
									}
									for sessionIndex, session := range week.Sessions {
										<article class="nested-record training-card training-card--session" aria-labelledby={ "structured-session-" + session.ID } data-training-card data-default-open={ fmt.Sprintf("%t", sessionIndex == 0) }>
											<div class="training-card__header">
												<div>
													<h5 id={ "structured-session-" + session.ID }>{ session.Title }</h5>
													<p class="record-meta">
														{ session.When } · { structuredEntryKindLabel(session.EntryKind) }
														if len(session.Modalities) > 0 {
															<span>· { structuredModalitiesLabel(session.Modalities) }</span>
														}
													</p>
												</div>
												<button class="action action--quiet training-card__toggle" type="button" aria-expanded="true" aria-controls={ "session-content-" + session.ID } data-training-toggle><span data-training-toggle-label>Ocultar</span></button>
											</div>
											<div id={ "session-content-" + session.ID } class="training-card__body">
												if session.Description != "" {
													<p>{ session.Description }</p>
												}
												if len(session.Changes) > 0 {
													<div class="notice notice--info" role="note">
														<p><strong>Alterações aplicadas a esta prescrição</strong></p>
														<ul>
															for _, change := range session.Changes {
																<li><strong>{ change.Operation } · { change.Subject }:</strong> { change.Summary }
																	if change.Fields != "" {
																		<span class="record-meta"> · { change.Fields }</span>
																	}
																</li>
															}
														</ul>
													</div>
												}
												if session.PrescriptionID != "" {
													<p><a class="action action--quiet" href={ templ.SafeURL("/treinos/prescricoes/" + session.PrescriptionID) }>Abrir esta revisão da prescrição</a></p>
												}
												if session.Outcome != "" {
													<div class="notice notice--info" role="note">
														<p><strong>Resposta do atleta</strong> · { trainingOutcomeLabel(session.Outcome) }</p>
														if session.ActualDuration != "" {
															<p>Duração real: { session.ActualDuration }</p>
														}
														if session.ActualDistance != "" {
															<p>Distância real: { session.ActualDistance }</p>
														}
														if session.PerceivedEffort != "" {
															<p>Esforço percebido: { session.PerceivedEffort }</p>
														}
														if session.RecoveryFeeling != "" {
															<p>Sensação geral: { session.RecoveryFeeling }</p>
														}
														if session.PerceptionNote != "" {
															<p><strong>Nota do atleta:</strong> { session.PerceptionNote }</p>
														}
														if session.FeedbackUpdatedAt != "" {
															<small>Atualizada em { session.FeedbackUpdatedAt }.</small>
														}
													</div>
												}
												if page.Management {
													<details class="training-action-menu"><summary class="action action--quiet">Ações da sessão</summary><div class="training-actions">@structuredSaveRoutineForm(page, "SESSION", session.ID)
@structuredCopySessionForm(page, session.ID)
</div></details>
													<p><a class="action action--quiet" href={ templ.SafeURL("/treinos/prescricoes/sessoes/" + session.ID) }>Ver prescrições e respostas dos atletas</a></p>
												}
												if len(session.Segments) == 0 && (session.EntryKind == "TRAINING" || session.EntryKind == "COMPETITION") {
													<p class="record-meta">Sessão ainda sem segmentos.</p>
												}
												for _, segment := range session.Segments {
													<section class="nested-record" aria-labelledby={ "segment-" + segment.ID }>
														<h6 id={ "segment-" + segment.ID }>
															{ structuredModalityLabel(segment.Modality) }
															if segment.Title != "" {
																<span>· { segment.Title }</span>
															}
														</h6>
														if segment.Location != "" || segment.Duration != "" || segment.PlannedStart != "" || segment.Transition > 0 {
															<p class="record-meta">
																if segment.PlannedStart != "" {
																	<span>Início previsto { segment.PlannedStart }</span>
																}
																if segment.Duration != "" {
																	<span>· { segment.Duration }</span>
																}
																if segment.Transition > 0 {
																	<span>· { fmt.Sprintf("%d min de transição", segment.Transition) }</span>
																}
																if segment.Location != "" {
																	<span>· { segment.Location }</span>
																}
															</p>
														}
														if segment.EquipmentNotes != "" {
															<p><strong>Material:</strong> { segment.EquipmentNotes }</p>
														}
														for _, block := range segment.Blocks {
															<div class="nested-record">
																<p>
																	<strong>
																		{ structuredPurposeLabel(block.Purpose) }
																		if block.Title != "" {
																			<span>· { block.Title }</span>
																		}
																	</strong>
																</p>
																<p class="preserve-lines">{ block.Instructions }</p>
																if block.GymStructure != "" {
																	<p class="record-meta">
																		{ gymStructureLabel(block.GymStructure) } · { trainingObjectiveLabel(block.GymObjective) } · { fmt.Sprintf("%d voltas", block.GymRounds) }
																		if block.GymRoundRecovery > 0 {
																			<span>· { fmt.Sprintf("%d s de recuperação entre voltas", block.GymRoundRecovery) }</span>
																		}
																	</p>
																	<ol class="record-list">
																		for _, exercise := range block.Exercises {
																			<li class="record-item record-item--stacked">
																				<div class="record-item__copy">
																					<strong>{ exercise.Name }</strong>
																					<p>{ exercise.Prescription }</p>
																					if exercise.Resistance != "" || exercise.Intent != "" || exercise.Tempo != "" {
																						<p class="record-meta">
																							{ exercise.Resistance }
																							if exercise.Intent != "" {
																								<span>· { gymExecutionIntentLabel(exercise.Intent) }</span>
																							}
																							if exercise.Tempo != "" {
																								<span>· Tempo { exercise.Tempo }</span>
																							}
																						</p>
																					}
																					if exercise.Notes != "" {
																						<p>{ exercise.Notes }</p>
																					}
																				</div>
																				if page.Management {
																					@structuredMoveExercise(page, exercise)
																				}
																			</li>
																		}
																	</ol>
																	if page.Management {
																		@structuredGymExerciseForm(page, block.ID)
																	}
																}
																	if block.WaterMethod != "" {
																		<p class="record-meta">
																			{ block.WaterMethod }
																			if block.WaterProfile != "" {
																				<span>· { block.WaterProfile }</span>
																			}
																		if block.WaterTarget != "" {
																			<span>· { block.WaterTarget }</span>
																		}
																		</p>
																		if len(block.WaterTotals) > 0 {
																			<dl class="training-totals" aria-label="Totais planeados do bloco">
																				for _, total := range block.WaterTotals {
																					<div><dt>{ total.Label }</dt><dd>{ total.Value } <span class="record-meta">{ total.Certainty }</span></dd></div>
																				}
																			</dl>
																		}
																	<ol class="record-list">
																		for _, step := range block.WaterSteps {
																			<li class="record-item record-item--stacked"><div class="record-item__copy">
																				<strong>
																					if step.ParentID != "" {
																						<span>↳ </span>
																					}
																					{ step.Name }
																				</strong>
																				<p>
																					{ step.Prescription }
																					if step.Repeats > 0 {
																						<span>{ fmt.Sprintf("%d repetições", step.Repeats) }</span>
																					}
																					if step.Recovery > 0 {
																						<span> · { fmt.Sprintf("%d s de recuperação", step.Recovery) }</span>
																					}
																				</p>
																				if step.Intensity != "" || step.Drill != "" {
																					<p class="record-meta">
																						{ step.Intensity }
																						if step.Drill != "" {
																							<span>· { step.Drill }</span>
																						}
																					</p>
																				}
																				if step.Instructions != "" {
																					<p>{ step.Instructions }</p>
																				}
																			</div></li>
																		}
																	</ol>
																	if page.Management {
																		@structuredWaterStepForm(page, block)
																	}
																}
																if page.Management {
																	<details class="training-action-menu"><summary class="action action--quiet">Ações do bloco</summary><div class="training-actions">@structuredMoveBlock(page, block)
@structuredSaveRoutineForm(page, "BLOCK", block.ID)
@structuredCopyBlockForm(page, block.ID)
</div></details>
																}
															</div>
														}
														if page.Management {
															<details class="training-action-menu">
																<summary class="action action--quiet">Ações do segmento</summary>
																<div class="training-actions">
																	@structuredMoveSegment(page, segment)
																	@structuredSaveRoutineForm(page, "SEGMENT", segment.ID)
											@structuredBlockForm(page, segment.ID)
											if segment.Modality == "GYM" {
												@structuredGymBlockTaskLink(page, session.ID, segment.ID)
																	}
																	if segment.Modality == "WATER" {
																					@structuredWaterBlockForm(page, session.ID, segment)
																	}
																</div>
															</details>
														}
													</section>
												}
												if page.Management && (session.EntryKind == "TRAINING" || session.EntryKind == "COMPETITION") {
													<div class="training-actions">@structuredSegmentForm(page, session.ID)
</div>
												}
											</div>
										</article>
									}
								</div>
							</section>
						}
					</div>
				</article>
			}
		</section>
		if page.Management {
			@structuredCycleManagement(page)
			@structuredVariationManagement(page)
			@structuredPublicationManagement(page)
			@structuredRoutineLibrary(page)
			@structuredCopyDayForm(page)
			if page.CanManageWaterProfiles {
				@structuredWaterProfileManagement(page)
			}
		}
	</div>
	if page.Management {
		@structuredGroupForm(page)
		@structuredWeekForm(page)
		@structuredSessionForm(page)
	}
}

templ structuredPlannerContext(page StructuredTrainingPage) {
	<section class="structured-planner" aria-labelledby="structured-planner-title">
		<div class="structured-planner__heading">
			<div>
				<p class="eyebrow">Contexto de edição</p>
				<h2 id="structured-planner-title">Plano selecionado</h2>
				<p>Escolha o grupo, a semana e a sessão antes de editar. Esta seleção fica no endereço para poder retomar o trabalho.</p>
			</div>
			<span class="badge">Rascunho</span>
		</div>
		<form class="structured-planner__selector" method="get" action="/admin/treinos/estruturados">
			<div>
				@components.FieldLabel("planner-group", "Grupo", true)
				<select id="planner-group" name="group_id" required>
					for _, audience := range structuredPlannerAudiences(page) {
						<option value={ audience.GroupID } selected?={ audience.GroupID == page.SelectedGroupID }>{ audience.GroupName }</option>
					}
				</select>
			</div>
			<div>
				@components.FieldLabel("planner-week", "Semana", true)
				<select id="planner-week" name="week_id" required>
					for _, audience := range structuredPlannerAudiences(page) {
						if audience.GroupID == page.SelectedGroupID {
							for _, week := range audience.Weeks {
								<option value={ week.ID } selected?={ week.ID == page.SelectedWeekID }>{ week.Title } · { week.DateRange }</option>
							}
						}
					}
				</select>
			</div>
			<div>
				@components.FieldLabel("planner-session", "Sessão", false)
				<select id="planner-session" name="session_id">
					<option value="">Todas as sessões da semana</option>
					for _, audience := range structuredPlannerAudiences(page) {
						if audience.GroupID == page.SelectedGroupID {
							for _, week := range audience.Weeks {
								if week.ID == page.SelectedWeekID {
									for _, session := range week.Sessions {
										<option value={ session.ID } selected?={ session.ID == page.SelectedSessionID }>{ session.When } · { session.Title }</option>
									}
								}
							}
						}
					}
				</select>
			</div>
			<button type="submit">Abrir contexto</button>
		</form>
		if page.SelectedWeekID != "" {
			<nav class="structured-planner__sessions" aria-label="Sessões da semana selecionada">
				for _, audience := range structuredPlannerAudiences(page) {
					if audience.GroupID == page.SelectedGroupID {
						for _, week := range audience.Weeks {
							if week.ID == page.SelectedWeekID {
								for _, session := range week.Sessions {
									if session.ID == page.SelectedSessionID {
										<a class="structured-planner__session" href={ templ.SafeURL("/admin/treinos/estruturados?group_id=" + audience.GroupID + "&week_id=" + week.ID + "&session_id=" + session.ID + "#training-plan") } aria-current="page">
											<span>{ session.When }</span><strong>{ session.Title }</strong><small>{ structuredEntryKindLabel(session.EntryKind) }</small>
										</a>
									} else {
										<a class="structured-planner__session" href={ templ.SafeURL("/admin/treinos/estruturados?group_id=" + audience.GroupID + "&week_id=" + week.ID + "&session_id=" + session.ID + "#training-plan") }>
											<span>{ session.When }</span><strong>{ session.Title }</strong><small>{ structuredEntryKindLabel(session.EntryKind) }</small>
										</a>
									}
								}
							}
						}
					}
				}
			</nav>
		}
	</section>
}

func structuredPlannerAudiences(page StructuredTrainingPage) []StructuredTrainingAudience {
	if len(page.PlannerAudiences) > 0 {
		return page.PlannerAudiences
	}
	return page.Audiences
}

templ structuredPublicationManagement(page StructuredTrainingPage) {
	<section id="training-publication" class="module" aria-labelledby="training-publication-title" data-tab-panel>
		@components.SectionHeading("", "Publicar prescrições privadas", "Confirme os destinatários e crie uma revisão imutável por atleta. Alterações posteriores ficam em rascunho até nova publicação.")
		<div class="notice notice--info" role="note"><p>A publicação não envia dados de colegas, subgrupos ou tripulações. Cada atleta recebe apenas a sua sessão resolvida; tutores veem apenas menores atualmente a seu cargo.</p></div>
		if len(page.Publications) == 0 {
			@components.EmptyState("Ainda sem semanas publicáveis", "Crie uma semana estruturada com sessões e destinatários válidos.")
		}
		<div class="record-list">
			for _, publication := range page.Publications {
				<article class="record-item record-item--stacked"><div class="record-item__copy">
					<p class="eyebrow">{ publication.Status }</p>
					<h3>{ publication.Plan }</h3>
					<p class="record-meta">{ fmt.Sprintf("%d atletas · %d prescrições", publication.AthleteCount, publication.PrescriptionCount) }
						if publication.Revision > 0 {
							<span> · revisão { fmt.Sprintf("%d", publication.Revision) } · { publication.PublishedAt } · { publication.PublishedBy }</span>
						}
					</p>
					<p class="record-meta">{ fmt.Sprintf("Pré-visualização: %d novas · %d alteradas · %d removidas · %d sem alterações", publication.AddedCount, publication.ChangedCount, publication.RemovedCount, publication.UnchangedCount) }</p>
					if publication.ConflictCount > 0 {
						<div class="notice notice--error" role="alert"><p>{ fmt.Sprintf("%d conflitos de variação impedem a publicação.", publication.ConflictCount) }</p></div>
					} else if publication.PrescriptionCount == 0 && publication.RemovedCount == 0 {
						<p class="record-meta">Não existem sessões com destinatários válidos nesta semana.</p>
					} else if publication.Revision > 0 && publication.AddedCount == 0 && publication.ChangedCount == 0 && publication.RemovedCount == 0 {
						<p class="record-meta">Não há alterações materiais para publicar.</p>
					} else {
						<form class="form-layout form-layout--compact" method="post" action={ templ.SafeURL("/admin/treinos/estruturados/semanas/" + publication.PlanID + "/publicar") }>
							@page.CSRFField
							<input type="hidden" name="source_updated_at" value={ publication.SourceUpdatedAt }/>
							@components.FieldLabel("publication-summary-" + publication.PlanID, "Resumo desta revisão", true)
							<input id={ "publication-summary-" + publication.PlanID } name="change_summary" required minlength="2" maxlength="500" placeholder="Ex.: semana publicada após revisão das variações"/>
							<button type="submit">Pré-visualizado · publicar revisão</button>
						</form>
					}
				</div></article>
			}
		</div>
	</section>
}

func structuredSubjectLabel(subject StructuredTrainingSubjectChoice) string { if subject.Self { return subject.Name + " (eu)" }; return subject.Name }
func structuredPlannerReturnURL(page StructuredTrainingPage) string { if page.PlannerReturnURL != "" { return page.PlannerReturnURL }; return "/admin/treinos/estruturados#training-plan" }

templ structuredCycleManagement(page StructuredTrainingPage) {
	<section id="training-cycles" class="module" data-tab-panel>
		@components.SectionHeading("Horizonte alargado", "Ciclos de treino", "Agrupe semanas sem alterar os seus rascunhos, publicações ou prescrições históricas.")
		<div class="training-actions">
			<button class="action action--primary" type="button" data-dialog-open="create-training-cycle">Criar ciclo</button>
		</div>
		if len(page.Cycles) == 0 {
			@components.EmptyState("Ainda sem ciclos", "O planeamento semanal continua disponível. Crie um ciclo apenas quando precisar de organizar várias semanas.")
		}
		for _, cycle := range page.Cycles {
			<article class="record-item record-item--stacked" aria-labelledby={ "training-cycle-" + cycle.ID }>
				<div class="record-item__copy">
					if cycle.LevelLabel != "" {
						<p class="eyebrow">{ cycle.LevelLabel }</p>
					}
					<h3 id={ "training-cycle-" + cycle.ID }>{ cycle.Name }</h3>
					<p class="record-meta">{ cycle.GroupName } · { cycle.Season }
						if cycle.DateRange != "" {
							<span> · { cycle.DateRange }</span>
						}
					</p>
					if cycle.ParentName != "" {
						<p><strong>Estrutura superior:</strong> { cycle.ParentName }</p>
					}
					if cycle.Goals != "" {
						<p class="preserve-lines"><strong>Objetivos:</strong> { cycle.Goals }</p>
					}
					if cycle.Focus != "" {
						<p class="preserve-lines"><strong>Fase ou foco:</strong> { cycle.Focus }</p>
					}
					if len(cycle.Targets) > 0 {
						<p><strong>Competições-alvo</strong></p>
						<ul class="record-list">
							for _, target := range cycle.Targets {
								<li>{ target.Label }
									if target.Status == "CANCELLED" {
										<span class="status-badge status-badge--muted">Cancelada</span>
									}
								</li>
							}
						</ul>
					}
					if cycle.Warning != "" {
						<div class="notice notice--info" role="status"><p>{ cycle.Warning }</p></div>
					}
					<ol class="record-list" aria-label={ "Semanas de " + cycle.Name }>
						for _, week := range cycle.Weeks {
							<li class="nested-record">
								<p><a href={ templ.SafeURL(week.PlannerURL) }><strong>{ week.Title }</strong></a> · { week.DateRange }</p>
								<p class="record-meta">
									if week.PlannedLoad != "" {
										<span>Carga planeada: { week.PlannedLoad }</span>
									} else {
										<span>Carga planeada não definida</span>
									}
									if len(week.Modalities) > 0 {
										<span> · Modalidades: { strings.Join(week.Modalities, ", ") }</span>
									} else {
										<span> · Modalidades ainda não definidas</span>
									}
								</p>
							</li>
						}
					</ol>
					<div class="training-actions">
						<button class="action action--quiet" type="button" data-dialog-open={ "edit-training-cycle-" + cycle.ID }>Editar ciclo</button>
						<button class="action action--quiet" type="button" data-dialog-open={ "copy-training-cycle-" + cycle.ID }>Copiar ciclo</button>
					</div>
				</div>
			</article>
			@structuredCycleEditDialog(page, cycle)
			@structuredCycleCopyDialog(page, cycle)
		}
		@structuredCycleCreateDialog(page)
	</section>
}

templ structuredCycleFields(page StructuredTrainingPage, form StructuredTrainingCycleForm, prefix string, editing bool) {
	@components.RequiredNote()
	if !editing {
		@components.FieldLabel(prefix+"-group", "Grupo", true)
		<select id={ prefix+"-group" } name="group_id" required><option value="">Selecione</option>
			for _, choice := range page.Groups {
				<option value={ choice.ID } selected?={ choice.ID == form.GroupID }>{ choice.Name }</option>
			}
		</select>
		@components.FieldErrorMessage("group_id", form.Errors["group_id"])
	}
	@components.FieldLabel(prefix+"-name", "Nome", true)
	<input id={ prefix+"-name" } name="name" value={ form.Name } required minlength="2" maxlength="180"/>@components.FieldErrorMessage("name", form.Errors["name"])
	@components.FieldLabel(prefix+"-level", "Designação usada pela equipa (opcional)", false)
	<input id={ prefix+"-level" } name="level_label" value={ form.LevelLabel } maxlength="80" aria-describedby={ prefix+"-level-help" }/>
	<small id={ prefix+"-level-help" }>Por exemplo, mesociclo ou bloco. MyCFCoimbra não impõe uma metodologia.</small>
	@components.FieldLabel(prefix+"-goals", "Objetivos (opcional)", false)
	<textarea id={ prefix+"-goals" } name="goals" maxlength="4000">{ form.Goals }</textarea>
	@components.FieldLabel(prefix+"-focus", "Fase ou foco (opcional)", false)
	<textarea id={ prefix+"-focus" } name="phase_focus_notes" maxlength="4000">{ form.Focus }</textarea>
	<fieldset id={ prefix+"-weeks" }><legend>Semanas diretas do ciclo (opcional)</legend><p class="field-help">Selecione semanas do mesmo grupo e época. Agrupar uma semana não altera o seu rascunho nem a publicação.</p>
		for _, choice := range page.Weeks {
			<label class="check-row"><input type="checkbox" name="week_id" value={ choice.ID } checked?={ form.WeekIDs[choice.ID] }/> <span>{ choice.Name }</span></label>
		}
		@components.FieldErrorMessage("week_id", form.Errors["week_id"])
	</fieldset>
	<fieldset id={ prefix+"-children" }><legend>Estruturas incluídas (opcional)</legend><p class="field-help">Uma estrutura superior pode agregar ciclos do mesmo grupo e época sem retirar as semanas aos ciclos inferiores.</p>
		for _, candidate := range page.Cycles {
			if candidate.ID != form.CycleID && (candidate.ParentID == "" || candidate.ParentID == form.CycleID) {
				<label class="check-row"><input type="checkbox" name="child_cycle_id" value={ candidate.ID } checked?={ form.ChildCycleIDs[candidate.ID] }/> <span>{ candidate.GroupName } · { candidate.Season } · { candidate.Name }</span></label>
			}
		}
		@components.FieldErrorMessage("child_cycle_id", form.Errors["child_cycle_id"])
	</fieldset>
	<p class="field-help">Selecione pelo menos uma semana direta ou uma estrutura incluída.</p>
	if len(page.CompetitionEvents) > 0 {
		<fieldset><legend>Competições-alvo (opcional)</legend>
			for _, choice := range page.CompetitionEvents {
				<label class="check-row"><input type="checkbox" name="target_event_id" value={ choice.ID } checked?={ form.TargetEventIDs[choice.ID] }/> <span>{ choice.Name }</span></label>
			}
		</fieldset>
	}
}

templ structuredCycleCreateDialog(page StructuredTrainingPage) {
	<dialog id="create-training-cycle" class="task-dialog" data-task-dialog data-task-open-on-load?={ page.OpenForm == "cycle" } aria-labelledby="create-training-cycle-title" open?={ page.OpenForm == "cycle" }>
		<div class="task-dialog__header"><div><p class="eyebrow">Planeamento opcional</p><h3 id="create-training-cycle-title">Criar ciclo</h3></div><button class="action action--quiet" type="button" data-dialog-close>Fechar</button></div>
		@components.ErrorSummary(components.FieldErrorsFor(map[string]string(page.CycleForm.Errors), []components.FieldErrorRef{{Key: "group_id", Field: "create-cycle-group"}, {Key: "name", Field: "create-cycle-name"}, {Key: "week_id", Field: "create-cycle-weeks"}, {Key: "child_cycle_id", Field: "create-cycle-children"}}))
		<form class="form-layout" method="post" action="/admin/treinos/estruturados/ciclos">@page.CSRFField
			@structuredCycleFields(page, page.CycleForm, "create-cycle", false)
			<button type="submit">Criar ciclo</button>
		</form>
	</dialog>
}

templ structuredCycleEditDialog(page StructuredTrainingPage, cycle StructuredTrainingCycle) {
	<dialog id={ "edit-training-cycle-" + cycle.ID } class="task-dialog" data-task-dialog data-task-open-on-load?={ page.OpenForm == "cycle-" + cycle.ID } aria-labelledby={ "edit-training-cycle-title-" + cycle.ID } open?={ page.OpenForm == "cycle-" + cycle.ID }>
		<div class="task-dialog__header"><div><p class="eyebrow">{ cycle.GroupName } · { cycle.Season }</p><h3 id={ "edit-training-cycle-title-" + cycle.ID }>Editar { cycle.Name }</h3></div><button class="action action--quiet" type="button" data-dialog-close>Fechar</button></div>
		@components.FieldErrorMessage("form", structuredCycleEditForm(page, cycle).Errors["form"])
		<form class="form-layout" method="post" action={ templ.SafeURL("/admin/treinos/estruturados/ciclos/" + cycle.ID) }>@page.CSRFField<input type="hidden" name="version" value={ structuredCycleEditForm(page, cycle).Version }/>
			@structuredCycleFields(page, structuredCycleEditForm(page, cycle), "edit-cycle-"+cycle.ID, true)
			<button type="submit">Guardar ciclo</button>
		</form>
	</dialog>
}

templ structuredCycleCopyDialog(page StructuredTrainingPage, cycle StructuredTrainingCycle) {
	<dialog id={ "copy-training-cycle-" + cycle.ID } class="task-dialog" data-task-dialog data-task-open-on-load?={ page.OpenForm == "cycle-copy-" + cycle.ID } aria-labelledby={ "copy-training-cycle-title-" + cycle.ID } open?={ page.OpenForm == "cycle-copy-" + cycle.ID }>
		<div class="task-dialog__header"><div><p class="eyebrow">Cópia independente</p><h3 id={ "copy-training-cycle-title-" + cycle.ID }>Copiar { cycle.Name }</h3></div><button class="action action--quiet" type="button" data-dialog-close>Fechar</button></div>
		<form class="form-layout" method="post" action={ templ.SafeURL("/admin/treinos/estruturados/ciclos/" + cycle.ID + "/copiar") }>@page.CSRFField
			<p class="field-help">Cria semanas e sessões editáveis com novos identificadores. Publicações, respostas de atletas e competições-alvo não são copiadas.</p>
			@components.FieldErrorMessage("form", structuredCycleCopyForm(page, cycle).Errors["form"])
			@components.FieldLabel("copy-cycle-name-"+cycle.ID, "Nome do novo ciclo", true)<input id={ "copy-cycle-name-"+cycle.ID } name="name" value={ structuredCycleCopyForm(page, cycle).Name } required minlength="2" maxlength="180"/>@components.FieldErrorMessage("name", structuredCycleCopyForm(page, cycle).Errors["name"])
			@components.FieldLabel("copy-cycle-start-"+cycle.ID, "Primeira segunda-feira", true)<input id={ "copy-cycle-start-"+cycle.ID } name="first_monday" type="date" value={ structuredCycleCopyForm(page, cycle).FirstMonday } required/>@components.FieldErrorMessage("first_monday", structuredCycleCopyForm(page, cycle).Errors["first_monday"])
			<button type="submit">Criar cópia do ciclo</button>
		</form>
	</dialog>
}

func structuredCycleEditForm(page StructuredTrainingPage, cycle StructuredTrainingCycle) StructuredTrainingCycleForm {
	if page.CycleForm.CycleID == cycle.ID { return page.CycleForm }
	form := StructuredTrainingCycleForm{CycleID: cycle.ID, GroupID: cycle.GroupID, Name: cycle.Name, LevelLabel: cycle.LevelLabel, Goals: cycle.Goals, Focus: cycle.Focus, Version: fmt.Sprintf("%d", cycle.Version), WeekIDs: map[string]bool{}, ChildCycleIDs: map[string]bool{}, TargetEventIDs: map[string]bool{}, Errors: validation.FieldErrors{}}
	for _, week := range cycle.Weeks { if week.Direct { form.WeekIDs[week.ID] = true } }
	for _, candidate := range page.Cycles { if candidate.ParentID == cycle.ID { form.ChildCycleIDs[candidate.ID] = true } }
	for _, target := range cycle.Targets { form.TargetEventIDs[target.ID] = true }
	return form
}

func structuredCycleCopyForm(page StructuredTrainingPage, cycle StructuredTrainingCycle) StructuredTrainingCycleCopyForm {
	if page.CycleCopyForm.CycleID == cycle.ID { return page.CycleCopyForm }
	return StructuredTrainingCycleCopyForm{CycleID: cycle.ID, Name: cycle.Name, Errors: validation.FieldErrors{}}
}

templ structuredVariationManagement(page StructuredTrainingPage) {
	<section id="training-variations" class="module" aria-labelledby="training-variations-title" data-tab-panel>
		@components.SectionHeading("", "Variações por atleta e tripulação", "Mantenha a sessão do grupo como base e registe apenas o que muda. A pré-visualização mostra a instrução que prevalece para cada atleta.")
		<div class="notice notice--info" role="note">
			<p><strong>Precedência:</strong> uma variação individual prevalece sobre tripulações e subgrupos. Duas variações do mesmo nível para o mesmo item são apresentadas como conflito e nunca são escolhidas silenciosamente.</p>
		</div>
		<div class="page-actions">
			<button class="action action--quiet" type="button" data-dialog-open="add-variation-group">Criar subgrupo ou tripulação</button>
			<button class="action" type="button" data-dialog-open="add-training-variation">Adicionar variação</button>
		</div>
		<dialog id="add-variation-group" class="task-dialog" data-task-dialog aria-labelledby="add-variation-group-title">
			<div class="task-dialog__header"><h3 id="add-variation-group-title">Novo alvo de variação</h3><button class="action action--quiet" type="button" data-dialog-close>Fechar</button></div>
			<form class="form-layout" method="post" action="/admin/treinos/estruturados/variacoes/grupos">
				@page.CSRFField
				@components.FieldLabel("variation-group-base", "Grupo de treino", true)
				<select id="variation-group-base" name="training_group_id" required><option value="">Selecione</option>
					for _, choice := range page.Groups {
						<option value={ choice.ID } data-group={ choice.GroupID }>{ choice.Name }</option>
					}
				</select>
				@components.FieldLabel("variation-group-kind", "Tipo", true)<select id="variation-group-kind" name="kind" required><option value="SUBGROUP">Subgrupo</option><option value="CREW">Tripulação temporária</option></select>
				@components.FieldLabel("variation-group-name", "Nome", true)<input id="variation-group-name" name="name" required minlength="2" maxlength="120" placeholder="Ex.: Canoas ou C2 para a Taça"/>
				@components.FieldLabel("variation-group-craft", "Embarcação da tripulação", false)
				<select id="variation-group-craft" name="craft_modality_id"><option value="">Não se aplica</option>
					for _, choice := range page.CrewModalities {
						<option value={ choice.ID }>{ choice.Name }</option>
					}
				</select>
				<div class="form-grid"><div>@components.FieldLabel("variation-effective-from", "Válido desde", true)<input id="variation-effective-from" name="effective_from" type="date" required/></div><div>@components.FieldLabel("variation-effective-until", "Válido até", false)<input id="variation-effective-until" name="effective_until" type="date"/></div></div>
				@components.FieldLabel("variation-competition", "Competição alvo (opcional)", false)
				<select id="variation-competition" name="competition_event_id"><option value="">Sem competição associada</option>
					for _, choice := range page.CompetitionEvents {
						<option value={ choice.ID }>{ choice.Name }</option>
					}
				</select>
				<label class="choice-card"><input type="checkbox" name="open_ended_exception" value="true"/><span><strong>Tripulação excecionalmente sem data final</strong><small>Use apenas quando não existir uma prova ou data final adequada.</small></span></label>
				<fieldset><legend>Atletas</legend><div class="choice-grid">
					for _, member := range page.VariationMembers {
						<label class="choice-card" data-variation-member data-group={ member.GroupID }><input type="checkbox" name="membership_id" value={ member.ID }/><span><strong>{ member.Athlete }</strong><small>{ member.GroupName }</small></span></label>
					}
				</div></fieldset>
				<button type="submit">Guardar alvo</button>
			</form>
		</dialog>
		<dialog id="add-training-variation" class="task-dialog" data-task-dialog aria-labelledby="add-training-variation-title">
			<div class="task-dialog__header"><h3 id="add-training-variation-title">Adicionar variação</h3><button class="action action--quiet" type="button" data-dialog-close>Fechar</button></div>
			<form class="form-layout" method="post" action="/admin/treinos/estruturados/variacoes">
				@page.CSRFField
				@components.FieldLabel("variation-plan", "Semana", true)
				<select id="variation-plan" name="plan_id" required><option value="">Selecione</option>
					for _, choice := range page.Weeks {
						<option value={ choice.ID } data-group={ choice.GroupID }>{ choice.Name }</option>
					}
				</select>
				@components.FieldLabel("variation-target", "Quem recebe", true)<select id="variation-target" name="target" required><option value="">Selecione</option>
					for _, target := range page.VariationTargets {
						<option value={ target.Value } data-group={ target.GroupID }>{ target.Name }</option>
					}
				</select>
				@components.FieldLabel("variation-subject", "Item que muda", true)<select id="variation-subject" name="subject" required><option value="">Selecione</option>
					for _, subject := range page.VariationSubjects {
						<option value={ subject.Value } data-plan={ subject.PlanID }>{ subject.Name }</option>
					}
				</select>
				@components.FieldLabel("variation-operation", "Alteração", true)<select id="variation-operation" name="operation" required><option value="OVERRIDE">Alterar campos</option><option value="OMIT">Omitir este item</option><option value="REPLACE">Substituir este item</option><option value="ADD">Adicionar alternativa após este item</option></select>
				@components.FieldLabel("variation-summary", "Resumo legível", true)<textarea id="variation-summary" name="change_summary" required minlength="2" maxlength="500" placeholder="Ex.: fazer o retorno à calma no ergómetro"></textarea>
				<p class="field-help">Preencha apenas os campos estruturados que mudam. O resumo continua obrigatório e não deve conter informação médica.</p>
				<div class="form-grid"><div>@components.FieldLabel("variation-title", "Novo título", false)<input id="variation-title" name="title" maxlength="180"/></div><div>@components.FieldLabel("variation-modality", "Nova modalidade", false)<select id="variation-modality" name="modality"><option value="">Manter</option>
					for _, value := range []string{"WATER", "GYM", "RUN", "BIKE", "ERGOMETER", "FLEXIBILITY", "SPORTS_GAMES", "OTHER"} {
						<option value={ value }>{ structuredModalityLabel(value) }</option>
					}
				</select></div></div>
				@components.FieldLabel("variation-instructions", "Novas instruções", false)<textarea id="variation-instructions" name="instructions" maxlength="4000"></textarea>
				<div class="form-grid form-grid--three"><div>@components.FieldLabel("variation-repeats", "Repetições", false)<input id="variation-repeats" name="repeats" type="number" min="1" max="10000"/></div><div>@components.FieldLabel("variation-duration", "Duração (s)", false)<input id="variation-duration" name="duration_seconds" type="number" min="1" max="86400"/></div><div>@components.FieldLabel("variation-distance", "Distância (m)", false)<input id="variation-distance" name="distance_metres" type="number" min="1" max="200000"/></div></div>
				<div class="form-grid form-grid--three"><div>@components.FieldLabel("variation-recovery", "Recuperação (s)", false)<input id="variation-recovery" name="recovery_seconds" type="number" min="1" max="86400"/></div><div>@components.FieldLabel("variation-intensity", "Intensidade", false)<input id="variation-intensity" name="intensity_code" maxlength="20" placeholder="Ex.: R4"/></div><div>@components.FieldLabel("variation-sets", "Séries", false)<input id="variation-sets" name="sets" type="number" min="1" max="100"/></div></div>
				<div class="form-grid"><div>@components.FieldLabel("variation-repetitions", "Repetições do exercício", false)<input id="variation-repetitions" name="exercise_repetitions" type="number" min="1" max="10000"/></div><div>@components.FieldLabel("variation-resistance", "Carga ou instrução", false)<input id="variation-resistance" name="resistance" maxlength="180" placeholder="Ex.: 70 kg, peso corporal ou elástico forte"/></div></div>
				<button type="submit">Guardar variação</button>
			</form>
		</dialog>
		<h3>Subgrupos e tripulações</h3>
		if len(page.VariationGroups) == 0 {
			@components.EmptyState("Ainda sem alvos específicos", "Crie um subgrupo ou uma tripulação quando várias pessoas partilharem a mesma alteração.")
		}
		<div class="record-list">
			for _, group := range page.VariationGroups {
				<article class="record-item record-item--stacked"><div class="record-item__copy"><p class="eyebrow">{ group.Kind }</p><h4>{ group.Name }</h4><p class="record-meta">{ group.GroupName } · { group.Period }
					if group.Craft != "" {
						<span>· { group.Craft }</span>
					}
					if group.Competition != "" {
						<span>· { group.Competition }</span>
					}
				</p><p>{ strings.Join(group.Members, ", ") }</p></div></article>
			}
		</div>
		<h3>Pré-visualização resolvida</h3>
		if len(page.VariationPreviews) == 0 {
			@components.EmptyState("Ainda sem variações", "As instruções resolvidas por atleta aparecem aqui antes da publicação.")
		}
		<div class="record-list">
			for _, preview := range page.VariationPreviews {
				<article class={ "record-item record-item--stacked", templ.KV("notice--warning", preview.Conflict) }><div class="record-item__copy"><p class="eyebrow">{ preview.Athlete }</p><h4>{ preview.Session }</h4><p class="record-meta">{ preview.Plan } · { preview.When } · { preview.Subject }</p><p><strong>{ preview.Status }</strong></p><ul>
					for _, rule := range preview.Rules {
						<li><strong>{ rule.Target } · { rule.Operation }</strong>: { rule.Summary }
							if preview.Conflict && rule.Applied {
								<span class="badge badge--warning">em conflito</span>
							} else if rule.Applied {
								<span class="badge badge--success">prevalece</span>
							} else {
								<span class="badge">suplantada</span>
							}
							if rule.Patch != "" {
								<span class="record-meta"> · { rule.Patch }</span>
							}
							<form class="inline-form" method="post" action={ templ.SafeURL("/admin/treinos/estruturados/variacoes/" + rule.ID + "/retirar") }>@page.CSRFField<input type="hidden" name="version" value={ fmt.Sprintf("%d", rule.Version) }/><button class="action action--quiet" type="submit">Retirar</button></form>
						</li>
					}
				</ul></div></article>
			}
		</div>
	</section>
}

templ structuredRoutineLibrary(page StructuredTrainingPage) {
	<section id="training-routines" class="module" aria-labelledby="routine-library-title" data-tab-panel>
		@components.SectionHeading("", "Biblioteca de rotinas", "Pesquise, pré-visualize e insira uma cópia independente no plano de destino.")
		<form class="filter-bar" method="get" action="/admin/treinos/estruturados">
			if page.SelectedGroupID != "" {
				<input type="hidden" name="group_id" value={ page.SelectedGroupID }/>
			}
			if page.SelectedWeekID != "" {
				<input type="hidden" name="week_id" value={ page.SelectedWeekID }/>
			}
			if page.SelectedSessionID != "" {
				<input type="hidden" name="session_id" value={ page.SelectedSessionID }/>
			}
			@components.FieldLabel("routine-query", "Pesquisar", false)
			<input id="routine-query" name="routine_query" value={ page.RoutineQuery } maxlength="180"/>
			@components.FieldLabel("routine-modality", "Modalidade", false)
			<select id="routine-modality" name="routine_modality">
				<option value="">Todas</option>
				for _, value := range []string{"WATER", "GYM", "RUN", "BIKE", "ERGOMETER", "FLEXIBILITY", "SPORTS_GAMES", "OTHER"} {
					<option value={ value } selected?={ page.RoutineModality == value }>{ structuredModalityLabel(value) }</option>
				}
			</select>
			@components.FieldLabel("routine-objective", "Objetivo", false)
			<select id="routine-objective" name="routine_objective">
				<option value="">Todos</option>
				for _, value := range []string{"MOBILITY", "ACTIVATION", "MAX_STRENGTH_HYPERTROPHY", "MAX_STRENGTH_NEURAL", "EXPLOSIVE_STRENGTH", "STRENGTH_ENDURANCE", "TECHNIQUE", "CORE", "CUSTOM"} {
					<option value={ value } selected?={ page.RoutineObjective == value }>{ trainingObjectiveLabel(value) }</option>
				}
			</select>
			@components.FieldLabel("routine-tag", "Etiqueta", false)
			<input id="routine-tag" name="routine_tag" value={ page.RoutineTag } maxlength="40"/>
			<button type="submit">Filtrar rotinas</button>
		</form>
		if len(page.Routines) == 0 {
			@components.EmptyState("Sem rotinas visíveis", "Guarde um bloco, segmento ou sessão para começar.")
		}
		for _, routine := range page.Routines {
			<article class="record-item record-item--stacked">
				<div class="record-item__copy">
					<h3>{ routine.Name }</h3>
					<p class="record-meta">
						{ trainingRoutineKindLabel(routine.Kind) } · { routine.Visibility } · { routine.Owner }
						if routine.Scope != "" {
							<span>· { routine.Scope }</span>
						}
					</p>
					if routine.Description != "" {
						<p>{ routine.Description }</p>
					}
					<p><strong>Pré-visualização:</strong> { routine.Preview }</p>
					<p class="record-meta">
						if routine.Modality != "" {
							<span>{ structuredModalityLabel(routine.Modality) }</span>
						}
						if routine.Objective != "" {
							<span>· { trainingObjectiveLabel(routine.Objective) }</span>
						}
						if routine.Method != "" {
							<span>· Método: { routine.Method }</span>
						}
						if routine.Tags != "" {
							<span>· { routine.Tags }</span>
						}
					</p>
					<p class="record-meta">{ routine.Provenance }</p>
				</div>
				@structuredInsertRoutineForm(page, routine)
			</article>
		}
	</section>
}

templ structuredSaveRoutineForm(page StructuredTrainingPage, kind, sourceID string) {
	<button class="action action--quiet" type="button" data-dialog-open={ "save-routine-" + sourceID }>Guardar como rotina</button>
	<dialog id={ "save-routine-" + sourceID } class="task-dialog" data-task-dialog aria-labelledby={ "save-routine-title-" + sourceID }>
		<div class="task-dialog__header"><div><p class="eyebrow">Biblioteca</p><h3 id={ "save-routine-title-" + sourceID }>Guardar como rotina</h3></div><button class="action action--quiet" type="button" data-dialog-close>Fechar</button></div>
		<form class="form-layout" method="post" action="/admin/treinos/estruturados/rotinas">
			@page.CSRFField
			<input type="hidden" name="return_to" value={ structuredPlannerReturnURL(page) }/>
			<input type="hidden" name="source_kind" value={ kind }/><input type="hidden" name="source_id" value={ sourceID }/>
			@components.FieldLabel("routine-name-"+sourceID, "Nome da rotina", true)
			<input id={ "routine-name-" + sourceID } name="name" required minlength="2" maxlength="180"/>
			@components.FieldLabel("routine-description-"+sourceID, "Descrição (opcional)", false)
			<textarea id={ "routine-description-" + sourceID } name="description" maxlength="1000"></textarea>
			@components.FieldLabel("routine-visibility-"+sourceID, "Partilha", true)
			<select id={ "routine-visibility-" + sourceID } name="visibility" required><option value="PRIVATE">Só para mim</option><option value="SHARED">Partilhar no âmbito deste plano</option></select>
			@components.FieldLabel("routine-method-"+sourceID, "Método (opcional)", false)
			<input id={ "routine-method-" + sourceID } name="method" maxlength="80"/>
			@components.FieldLabel("routine-tags-"+sourceID, "Etiquetas separadas por vírgula (opcional)", false)
			<input id={ "routine-tags-" + sourceID } name="tags" maxlength="400"/>
			<button type="submit">Guardar rotina</button>
		</form>
	</dialog>
}

templ structuredInsertRoutineForm(page StructuredTrainingPage, routine StructuredTrainingRoutine) {
	<button class="action action--quiet" type="button" data-dialog-open={ "insert-routine-" + routine.ID }>Usar rotina</button>
	<dialog id={ "insert-routine-" + routine.ID } class="task-dialog" data-task-dialog aria-labelledby={ "insert-routine-title-" + routine.ID }>
		<div class="task-dialog__header"><div><p class="eyebrow">{ trainingRoutineKindLabel(routine.Kind) }</p><h3 id={ "insert-routine-title-" + routine.ID }>Usar { routine.Name }</h3></div><button class="action action--quiet" type="button" data-dialog-close>Fechar</button></div>
		<form class="form-layout" method="post" action={ templ.SafeURL("/admin/treinos/estruturados/rotinas/" + routine.ID + "/inserir") }>
			@page.CSRFField
			<input type="hidden" name="return_to" value={ structuredPlannerReturnURL(page) }/>
			@components.FieldLabel("routine-target-"+routine.ID, trainingRoutineTargetLabel(routine.Kind), true)
			<select id={ "routine-target-" + routine.ID } name="target_id" required>
				<option value="">Selecione</option>
				if routine.Kind == "BLOCK" {
					for _, choice := range page.Segments {
						<option value={ choice.ID }>{ choice.Name }</option>
					}
				}
				if routine.Kind == "SEGMENT" {
					for _, choice := range page.Sessions {
						<option value={ choice.ID }>{ choice.Name }</option>
					}
				}
				if routine.Kind == "SESSION" {
					for _, choice := range page.Weeks {
						<option value={ choice.ID }>{ choice.Name }</option>
					}
				}
			</select>
			if routine.Kind == "SESSION" {
				@components.FieldLabel("routine-start-"+routine.ID, "Novo início", true)
				<input id={ "routine-start-" + routine.ID } name="starts_at" type="datetime-local" required/>
			}
			<button type="submit">Inserir cópia independente</button>
		</form>
	</dialog>
}

templ structuredCopyBlockForm(page StructuredTrainingPage, blockID string) {
	<button class="action action--quiet" type="button" data-dialog-open={ "copy-block-" + blockID }>Copiar bloco</button>
	<dialog id={ "copy-block-" + blockID } class="task-dialog" data-task-dialog aria-labelledby={ "copy-block-title-" + blockID }>
		<div class="task-dialog__header"><h3 id={ "copy-block-title-" + blockID }>Copiar bloco</h3><button class="action action--quiet" type="button" data-dialog-close>Fechar</button></div>
		<form class="form-layout" method="post" action={ templ.SafeURL("/admin/treinos/estruturados/blocos/" + blockID + "/copiar") }>
			@page.CSRFField
			@components.FieldLabel("copy-block-target-"+blockID, "Segmento de destino", true)
			<select id={ "copy-block-target-" + blockID } name="target_id" required>
				<option value="">Selecione</option>
				for _, choice := range page.Segments {
					<option value={ choice.ID }>{ choice.Name }</option>
				}
			</select><button type="submit">Criar cópia do bloco</button>
		</form>
	</dialog>
}

templ structuredCopySessionForm(page StructuredTrainingPage, sessionID string) {
	<button class="action action--quiet" type="button" data-dialog-open={ "copy-session-" + sessionID }>Copiar sessão</button>
	<dialog id={ "copy-session-" + sessionID } class="task-dialog" data-task-dialog aria-labelledby={ "copy-session-title-" + sessionID }>
		<div class="task-dialog__header"><h3 id={ "copy-session-title-" + sessionID }>Copiar sessão</h3><button class="action action--quiet" type="button" data-dialog-close>Fechar</button></div>
		<form class="form-layout" method="post" action={ templ.SafeURL("/admin/treinos/estruturados/sessoes/" + sessionID + "/copiar") }>
			@page.CSRFField
			@components.FieldLabel("copy-session-week-"+sessionID, "Semana de destino", true)
			<select id={ "copy-session-week-" + sessionID } name="target_id" required>
				<option value="">Selecione</option>
				for _, choice := range page.Weeks {
					<option value={ choice.ID }>{ choice.Name }</option>
				}
			</select>@components.FieldLabel("copy-session-start-"+sessionID, "Novo início", true)
			<input id={ "copy-session-start-" + sessionID } name="starts_at" type="datetime-local" required/><button type="submit">Criar cópia da sessão</button>
		</form>
	</dialog>
}

templ structuredCopyWeekForm(page StructuredTrainingPage, week StructuredTrainingWeek) {
	<button class="action action--quiet" type="button" data-dialog-open={ "copy-week-" + week.ID }>Copiar semana</button><dialog id={ "copy-week-" + week.ID } class="task-dialog" data-task-dialog aria-labelledby={ "copy-week-title-dialog-" + week.ID }><div class="task-dialog__header"><div><p class="eyebrow">{ week.DateRange }</p><h3 id={ "copy-week-title-dialog-" + week.ID }>Copiar { week.Title }</h3></div><button class="action action--quiet" type="button" data-dialog-close>Fechar</button></div><form class="form-layout" method="post" action={ templ.SafeURL("/admin/treinos/estruturados/semanas/" + week.ID + "/copiar") }>@page.CSRFField
	<input type="hidden" name="return_to" value={ structuredPlannerReturnURL(page) }/>
@components.FieldLabel("copy-week-title-"+week.ID, "Título da nova semana", true)
<input id={ "copy-week-title-" + week.ID } name="title" value={ week.Title } required minlength="2" maxlength="180"/>@components.FieldLabel("copy-week-start-"+week.ID, "Nova segunda-feira", true)
<input id={ "copy-week-start-" + week.ID } name="week_start" type="date" required/><button type="submit">Criar cópia da semana</button></form></dialog>
}

templ structuredWeekLoadForm(page StructuredTrainingPage, week StructuredTrainingWeek) {
	<button class="action action--quiet" type="button" data-dialog-open={ "week-load-" + week.ID }>Atualizar carga planeada</button>
	<dialog id={ "week-load-" + week.ID } class="task-dialog" data-task-dialog aria-labelledby={ "week-load-title-" + week.ID }>
		<div class="task-dialog__header"><div><p class="eyebrow">{ week.DateRange }</p><h3 id={ "week-load-title-" + week.ID }>Carga planeada · { week.Title }</h3></div><button class="action action--quiet" type="button" data-dialog-close>Fechar</button></div>
		<form class="form-layout" method="post" action={ templ.SafeURL("/admin/treinos/estruturados/semanas/" + week.ID + "/carga") }>
			@page.CSRFField
			<input type="hidden" name="return_to" value={ structuredPlannerReturnURL(page) }/>
			@components.FieldLabel("week-load-input-" + week.ID, "Carga planeada (%)", false)
			<input id={ "week-load-input-" + week.ID } name="planned_load_percentage" type="number" min="0" max="100" value={ strings.TrimSuffix(week.PlannedLoad, "%") } aria-describedby={ "week-load-help-" + week.ID }/>
			<small id={ "week-load-help-" + week.ID }>Distribuição de carga definida pelo treinador. Não é uma medição do atleta, %1RM, esforço percebido nem uma recomendação automática.</small>
			<button type="submit">Guardar carga planeada</button>
		</form>
	</dialog>
}

templ structuredCopyDayForm(page StructuredTrainingPage) {
	<section id="training-copy-tools" class="module" data-tab-panel>
		@components.SectionHeading("", "Copiar conteúdo", "Repita um dia completo entre semanas. Para copiar uma semana, sessão ou bloco, use o menu de ações junto ao respetivo conteúdo.")
		<form class="form-layout form-layout--compact" method="post" action="/admin/treinos/estruturados/dias/copiar">
			@page.CSRFField
			@components.FieldLabel("copy-day-source-plan", "Semana de origem", true)
			<select id="copy-day-source-plan" name="source_plan_id" required>
				for _, choice := range page.Weeks {
					<option value={ choice.ID }>{ choice.Name }</option>
				}
			</select>@components.FieldLabel("copy-day-source-date", "Dia de origem", true)
			<input id="copy-day-source-date" name="source_date" type="date" required/>@components.FieldLabel("copy-day-target-plan", "Semana de destino", true)
			<select id="copy-day-target-plan" name="target_plan_id" required>
				for _, choice := range page.Weeks {
					<option value={ choice.ID }>{ choice.Name }</option>
				}
			</select>@components.FieldLabel("copy-day-target-date", "Dia de destino", true)
			<input id="copy-day-target-date" name="target_date" type="date" required/><button type="submit">Copiar dia</button>
		</form>
	</section>
}

templ structuredGroupForm(page StructuredTrainingPage) {
	@components.TaskDialog(components.TaskSurfaceConfig{ID: "criar-grupo-treino", TitleID: "structured-group-title", Eyebrow: "Planeamento estruturado", Title: "Criar grupo de treino", Description: "Selecione um âmbito e os atletas atuais.", Variant: "sheet", URL: structuredPlannerReturnURL(page), ReturnURL: structuredPlannerReturnURL(page), Open: page.OpenForm == "group"}) {
		<div class="task-form">
			@components.ErrorSummary(components.FieldErrorsFor(map[string]string(page.GroupForm.Errors), []components.FieldErrorRef{{Key: "name", Field: "structured-group-name"}, {Key: "scope", Field: "structured-group-team"}, {Key: "members", Field: "structured-group-members"}}))
			<form class="form-layout" method="post" action="/admin/treinos/estruturados/grupos" data-task-form>
				@page.CSRFField
				@components.RequiredNote()
				@components.FieldLabel("structured-group-name", "Nome", true)
				<input id="structured-group-name" name="name" value={ page.GroupForm.Name } required minlength="2" maxlength="120"/>@components.FieldErrorMessage("name", page.GroupForm.Errors["name"])
				@components.FieldLabel("structured-group-team", "Equipa", false)
				<select id="structured-group-team" name="team_id">
					<option value="">Sem equipa</option>
					for _, choice := range page.Teams {
						<option value={ choice.ID } selected?={ choice.ID == page.GroupForm.TeamID }>{ choice.Name }</option>
					}
				</select>
				@components.FieldLabel("structured-group-programme", "Programa", false)
				<select id="structured-group-programme" name="programme_id">
					<option value="">Sem programa</option>
					for _, choice := range page.Programmes {
						<option value={ choice.ID } selected?={ choice.ID == page.GroupForm.ProgrammeID }>{ choice.Name }</option>
					}
				</select>
				@components.FieldHelp("structured-group-scope-help", "Escolha exatamente uma equipa ou um programa. A autorização do treinador continua a ser verificada separadamente.")
				@components.FieldErrorMessage("scope", page.GroupForm.Errors["scope"])
				<fieldset id="structured-group-members">
					<legend>Atletas</legend>
					for _, member := range page.Memberships {
						<label><input type="checkbox" name="membership_id" value={ member.ID } checked?={ page.GroupForm.MembershipIDs[member.ID] }/> <strong>{ member.Athlete }</strong> — { member.Scope }</label>
					}
				</fieldset>@components.FieldErrorMessage("members", page.GroupForm.Errors["members"])
				@components.FormActions("/admin/treinos/estruturados") {
					<button type="submit">Criar grupo</button>
				}
			</form>
		</div>
	}
}

templ structuredWeekForm(page StructuredTrainingPage) {
	@components.TaskDialog(components.TaskSurfaceConfig{ID: "criar-semana-treino", TitleID: "structured-week-title", Eyebrow: "Planeamento estruturado", Title: "Criar semana", Description: "Associe uma semana datada a um grupo.", Variant: "sheet", URL: structuredPlannerReturnURL(page), ReturnURL: structuredPlannerReturnURL(page), Open: page.OpenForm == "week"}) {
		<div class="task-form">
			@components.ErrorSummary(components.FieldErrorsFor(map[string]string(page.WeekForm.Errors), []components.FieldErrorRef{{Key: "group_id", Field: "structured-week-group"}, {Key: "title", Field: "structured-week-name"}, {Key: "week_start", Field: "structured-week-start"}}))
			<form class="form-layout" method="post" action="/admin/treinos/estruturados/semanas" data-task-form>
				@page.CSRFField
				<input type="hidden" name="return_to" value={ structuredPlannerReturnURL(page) }/>
				@components.RequiredNote()
				@components.FieldLabel("structured-week-group", "Grupo", true)
				<select id="structured-week-group" name="group_id" required>
					<option value="">Selecione</option>
					for _, choice := range page.Groups {
						<option value={ choice.ID } selected?={ choice.ID == page.WeekForm.GroupID }>{ choice.Name }</option>
					}
				</select>@components.FieldErrorMessage("group_id", page.WeekForm.Errors["group_id"])
				@components.FieldLabel("structured-week-name", "Título", true)
				<input id="structured-week-name" name="title" value={ page.WeekForm.Title } required minlength="2" maxlength="180"/>@components.FieldErrorMessage("title", page.WeekForm.Errors["title"])
				@components.FieldLabel("structured-week-start", "Segunda-feira da semana", true)
				<input id="structured-week-start" name="week_start" type="date" value={ page.WeekForm.WeekStart } required/>@components.FieldErrorMessage("week_start", page.WeekForm.Errors["week_start"])
				@components.FieldLabel("structured-week-load", "Carga planeada (%)", false)
				<input id="structured-week-load" name="planned_load_percentage" type="number" min="0" max="100" value={ page.WeekForm.PlannedLoad } aria-describedby="structured-week-load-help"/>@components.FieldErrorMessage("planned_load_percentage", page.WeekForm.Errors["planned_load_percentage"])
				<small id="structured-week-load-help">Distribuição de carga definida pelo treinador. Não é %1RM, esforço percebido nem uma recomendação automática.</small>
				@components.FieldLabel("structured-week-description", "Notas (opcional)", false)
				<textarea id="structured-week-description" name="description" maxlength="4000">{ page.WeekForm.Description }</textarea>
				@components.FormActions(structuredPlannerReturnURL(page)) {
					<button type="submit">Criar semana</button>
				}
			</form>
		</div>
	}
}

templ structuredSessionForm(page StructuredTrainingPage) {
	@components.TaskDialog(components.TaskSurfaceConfig{ID: "criar-sessao-estruturada", TitleID: "structured-session-title", Eyebrow: "Planeamento estruturado", Title: "Criar sessão", Description: "Adicione um horário exato à semana.", Variant: "sheet", URL: structuredPlannerReturnURL(page), ReturnURL: structuredPlannerReturnURL(page), Open: page.OpenForm == "session"}) {
		<div class="task-form">
			@components.ErrorSummary(components.FieldErrorsFor(map[string]string(page.SessionForm.Errors), []components.FieldErrorRef{{Key: "plan_id", Field: "structured-session-week"}, {Key: "title", Field: "structured-session-name"}, {Key: "starts_at", Field: "structured-session-start"}, {Key: "ends_at", Field: "structured-session-end"}, {Key: "entry_kind", Field: "structured-session-kind"}}))
			<form class="form-layout" method="post" action="/admin/treinos/estruturados/sessoes" data-task-form>
				@page.CSRFField
				<input type="hidden" name="return_to" value={ structuredPlannerReturnURL(page) }/>
				@components.RequiredNote()
				@components.FieldLabel("structured-session-week", "Semana", true)
				<select id="structured-session-week" name="plan_id" required>
					<option value="">Selecione</option>
					for _, choice := range page.Weeks {
						<option value={ choice.ID } selected?={ choice.ID == page.SessionForm.PlanID }>{ choice.Name }</option>
					}
				</select>@components.FieldErrorMessage("plan_id", page.SessionForm.Errors["plan_id"])
				@components.FieldLabel("structured-session-name", "Título", true)
				<input id="structured-session-name" name="title" value={ page.SessionForm.Title } required minlength="2" maxlength="180"/>@components.FieldErrorMessage("title", page.SessionForm.Errors["title"])
				@components.FieldLabel("structured-session-kind", "Tipo", true)
				<select id="structured-session-kind" name="entry_kind" required>
					for _, value := range []string{"TRAINING", "REST", "COMPETITION", "LOGISTICS"} {
						<option value={ value } selected?={ value == page.SessionForm.EntryKind }>{ structuredEntryKindLabel(value) }</option>
					}
				</select>@components.FieldErrorMessage("entry_kind", page.SessionForm.Errors["entry_kind"])
				@components.FieldLabel("structured-session-start", "Início", true)
				<input id="structured-session-start" name="starts_at" type="datetime-local" value={ page.SessionForm.StartsAt } required/>@components.FieldErrorMessage("starts_at", page.SessionForm.Errors["starts_at"])
				@components.FieldLabel("structured-session-end", "Fim", true)
				<input id="structured-session-end" name="ends_at" type="datetime-local" value={ page.SessionForm.EndsAt } required/>@components.FieldErrorMessage("ends_at", page.SessionForm.Errors["ends_at"])
				@components.FieldLabel("structured-session-description", "Instruções gerais (opcional)", false)
				<textarea id="structured-session-description" name="description" maxlength="4000">{ page.SessionForm.Description }</textarea>
				@components.FormActions(structuredPlannerReturnURL(page)) {
					<button type="submit">Criar sessão</button>
				}
			</form>
		</div>
	}
}

templ structuredSegmentForm(page StructuredTrainingPage, sessionID string) {
	<button class="action action--quiet" type="button" data-dialog-open={ "add-segment-" + sessionID }>Adicionar segmento</button>
	<dialog id={ "add-segment-" + sessionID } class="task-dialog" data-task-dialog data-task-open-on-load?={ page.OpenForm == "segment-" + sessionID } data-task-url={ structuredPlannerReturnURL(page) } aria-labelledby={ "add-segment-title-" + sessionID }>
		<div class="task-dialog__header"><h3 id={ "add-segment-title-" + sessionID }>Adicionar segmento</h3><button class="action action--quiet" type="button" data-dialog-close>Fechar</button></div>
		@components.ErrorSummary(components.FieldErrorsFor(map[string]string(page.SegmentForm.Errors), []components.FieldErrorRef{{Key: "session", Field: "add-segment-title-" + sessionID}, {Key: "modality", Field: "segment-modality-" + sessionID}, {Key: "purpose", Field: "segment-purpose-" + sessionID}, {Key: "title", Field: "segment-title-" + sessionID}, {Key: "location", Field: "segment-location-" + sessionID}, {Key: "planned_duration_minutes", Field: "segment-duration-" + sessionID}, {Key: "planned_start_offset_minutes", Field: "segment-start-offset-" + sessionID}, {Key: "transition_duration_minutes", Field: "segment-transition-" + sessionID}, {Key: "equipment_notes", Field: "segment-equipment-" + sessionID}, {Key: "block_title", Field: "segment-block-title-" + sessionID}, {Key: "instructions", Field: "segment-instructions-" + sessionID}}))
		<form class="form-layout" method="post" action={ templ.SafeURL("/admin/treinos/estruturados/sessoes/" + sessionID + "/segmentos") } data-task-form>
			@page.CSRFField
			<input type="hidden" name="return_to" value={ structuredPlannerReturnURL(page) }/>
			@components.FieldLabel("segment-modality-"+sessionID, "Modalidade", true)
			<select id={ "segment-modality-" + sessionID } name="modality" required>
				for _, value := range []string{"WATER", "GYM", "RUN", "BIKE", "ERGOMETER", "FLEXIBILITY", "SPORTS_GAMES", "OTHER"} {
					<option value={ value } selected?={ page.SegmentForm.SessionID == sessionID && page.SegmentForm.Modality == value }>{ structuredModalityLabel(value) }</option>
				}
			</select>
			@components.FieldLabel("segment-title-"+sessionID, "Título (opcional)", false)
			<input id={ "segment-title-" + sessionID } name="title" maxlength="120" value={ page.SegmentForm.Title }/>@components.FieldErrorMessage("title", page.SegmentForm.Errors["title"])
			@components.FieldLabel("segment-location-"+sessionID, "Local (opcional)", false)
			<input id={ "segment-location-" + sessionID } name="location" maxlength="180" value={ page.SegmentForm.Location }/>@components.FieldErrorMessage("location", page.SegmentForm.Errors["location"])
			@components.FieldLabel("segment-duration-"+sessionID, "Duração prevista em minutos (opcional)", false)
			<input id={ "segment-duration-" + sessionID } name="planned_duration_minutes" type="number" min="1" max="1440" value={ page.SegmentForm.Duration }/>@components.FieldErrorMessage("planned_duration_minutes", page.SegmentForm.Errors["planned_duration_minutes"])
			@components.FieldLabel("segment-start-offset-"+sessionID, "Início previsto, em minutos após o início da sessão (opcional)", false)
			<input id={ "segment-start-offset-" + sessionID } name="planned_start_offset_minutes" type="number" min="0" max="1440" value={ page.SegmentForm.StartOffset }/>@components.FieldErrorMessage("planned_start_offset_minutes", page.SegmentForm.Errors["planned_start_offset_minutes"])
			@components.FieldLabel("segment-transition-"+sessionID, "Transição antes deste segmento, em minutos (opcional)", false)
			<input id={ "segment-transition-" + sessionID } name="transition_duration_minutes" type="number" min="1" max="1440" value={ page.SegmentForm.Transition }/>@components.FieldErrorMessage("transition_duration_minutes", page.SegmentForm.Errors["transition_duration_minutes"])
			@components.FieldLabel("segment-equipment-"+sessionID, "Material e preparação (opcional)", false)
			<textarea id={ "segment-equipment-" + sessionID } name="equipment_notes" maxlength="1000">{ page.SegmentForm.EquipmentNotes }</textarea>@components.FieldErrorMessage("equipment_notes", page.SegmentForm.Errors["equipment_notes"])
			@components.FieldLabel("segment-purpose-"+sessionID, "Objetivo do primeiro bloco", true)
			<select id={ "segment-purpose-" + sessionID } name="purpose" required>
				for _, value := range []string{"WARM_UP", "MAIN", "COOL_DOWN", "TECHNIQUE", "CUSTOM"} {
					<option value={ value } selected?={ page.SegmentForm.SessionID == sessionID && page.SegmentForm.Purpose == value }>{ structuredPurposeLabel(value) }</option>
				}
			</select>
			@components.FieldLabel("segment-block-title-"+sessionID, "Título do bloco (opcional)", false)
			<input id={ "segment-block-title-" + sessionID } name="block_title" maxlength="120" value={ page.SegmentForm.BlockTitle }/>@components.FieldErrorMessage("block_title", page.SegmentForm.Errors["block_title"])
			@components.FieldLabel("segment-instructions-"+sessionID, "Instruções", true)
			<textarea id={ "segment-instructions-" + sessionID } name="instructions" minlength="2" maxlength="4000" required>{ page.SegmentForm.Instructions }</textarea>@components.FieldErrorMessage("instructions", page.SegmentForm.Errors["instructions"])
			<button type="submit">Adicionar segmento</button>
		</form>
	</dialog>
}

templ structuredBlockForm(page StructuredTrainingPage, segmentID string) {
	<button class="action action--quiet" type="button" data-dialog-open={ "add-block-" + segmentID }>Adicionar bloco</button>
	<dialog id={ "add-block-" + segmentID } class="task-dialog" data-task-dialog data-task-open-on-load?={ page.OpenForm == "block-" + segmentID } data-task-url={ structuredPlannerReturnURL(page) } aria-labelledby={ "add-block-title-dialog-" + segmentID }>
		<div class="task-dialog__header"><h3 id={ "add-block-title-dialog-" + segmentID }>Adicionar bloco</h3><button class="action action--quiet" type="button" data-dialog-close>Fechar</button></div>
		@components.ErrorSummary(components.FieldErrorsFor(map[string]string(page.BlockForm.Errors), []components.FieldErrorRef{{Key: "segment", Field: "add-block-title-dialog-" + segmentID}, {Key: "purpose", Field: "block-purpose-" + segmentID}, {Key: "title", Field: "block-title-" + segmentID}, {Key: "instructions", Field: "block-instructions-" + segmentID}}))
		<form class="form-layout" method="post" action={ templ.SafeURL("/admin/treinos/estruturados/segmentos/" + segmentID + "/blocos") } data-task-form>
			@page.CSRFField
			<input type="hidden" name="return_to" value={ structuredPlannerReturnURL(page) }/>
			@components.FieldLabel("block-purpose-"+segmentID, "Objetivo", true)
			<select id={ "block-purpose-" + segmentID } name="purpose" required>
				for _, value := range []string{"WARM_UP", "MAIN", "COOL_DOWN", "TECHNIQUE", "CUSTOM"} {
					<option value={ value } selected?={ page.BlockForm.SegmentID == segmentID && page.BlockForm.Purpose == value }>{ structuredPurposeLabel(value) }</option>
				}
			</select>@components.FieldErrorMessage("purpose", page.BlockForm.Errors["purpose"])
			@components.FieldLabel("block-title-"+segmentID, "Título (opcional)", false)
			<input id={ "block-title-" + segmentID } name="title" maxlength="120" value={ page.BlockForm.Title }/>@components.FieldErrorMessage("title", page.BlockForm.Errors["title"])
			@components.FieldLabel("block-instructions-"+segmentID, "Instruções", true)
			<textarea id={ "block-instructions-" + segmentID } name="instructions" minlength="2" maxlength="4000" required>{ page.BlockForm.Instructions }</textarea>@components.FieldErrorMessage("instructions", page.BlockForm.Errors["instructions"])
			<button type="submit">Adicionar bloco</button>
		</form>
	</dialog>
}

templ structuredGymBlockForm(page StructuredTrainingPage, segmentID string) {
	<button class="action action--quiet" type="button" data-dialog-open={ "add-gym-block-" + segmentID }>Adicionar treino de ginásio</button>
	<dialog id={ "add-gym-block-" + segmentID } class="task-dialog" data-task-dialog aria-labelledby={ "add-gym-block-title-" + segmentID }>
		<div class="task-dialog__header"><div><p class="eyebrow">Ginásio</p><h3 id={ "add-gym-block-title-" + segmentID }>Adicionar bloco estruturado</h3></div><button class="action action--quiet" type="button" data-dialog-close>Fechar</button></div>
		<form class="form-layout" method="post" action={ templ.SafeURL("/admin/treinos/estruturados/segmentos/" + segmentID + "/ginasio") }>
			@page.CSRFField
			@components.FieldLabel("gym-purpose-"+segmentID, "Fase do treino", true)
			<select id={ "gym-purpose-" + segmentID } name="purpose" required>@gymPurposeOptions()
</select>
			@components.FieldLabel("gym-title-"+segmentID, "Título do bloco", true)
			<input id={ "gym-title-" + segmentID } name="title" required minlength="2" maxlength="120"/>
			@components.FieldLabel("gym-instructions-"+segmentID, "Instruções gerais", true)
			<textarea id={ "gym-instructions-" + segmentID } name="instructions" required minlength="2" maxlength="4000"></textarea>
			@components.FieldLabel("gym-structure-"+segmentID, "Estrutura", true)
			<select id={ "gym-structure-" + segmentID } name="structure" required><option value="STRAIGHT_SETS">Séries simples</option><option value="CIRCUIT">Circuito</option><option value="SUPERSET">Supersérie</option></select>
			@components.FieldLabel("gym-objective-"+segmentID, "Objetivo", true)
			<select id={ "gym-objective-" + segmentID } name="objective" required>@gymObjectiveOptions()
</select>
			@components.FieldLabel("gym-rounds-"+segmentID, "Voltas", true)
			<input id={ "gym-rounds-" + segmentID } name="rounds" type="number" min="1" max="100" value="1" required/>
			@components.FieldLabel("gym-round-recovery-"+segmentID, "Recuperação entre voltas em segundos (opcional)", false)
			<input id={ "gym-round-recovery-" + segmentID } name="round_recovery_seconds" type="number" min="1" max="86400"/>
			@structuredGymExerciseFields(segmentID)
			<button type="submit">Adicionar bloco de ginásio</button>
		</form>
	</dialog>
}

templ structuredGymExerciseForm(page StructuredTrainingPage, blockID string) {
	<button class="action action--quiet" type="button" data-dialog-open={ "add-exercise-" + blockID }>Adicionar exercício</button>
	<dialog id={ "add-exercise-" + blockID } class="task-dialog" data-task-dialog aria-labelledby={ "add-exercise-title-" + blockID }>
		<div class="task-dialog__header"><h3 id={ "add-exercise-title-" + blockID }>Adicionar exercício</h3><button class="action action--quiet" type="button" data-dialog-close>Fechar</button></div>
		<form class="form-layout" method="post" action={ templ.SafeURL("/admin/treinos/estruturados/blocos/" + blockID + "/exercicios") }>@page.CSRFField
			<input type="hidden" name="return_to" value={ structuredPlannerReturnURL(page) }/>
@structuredGymExerciseFields(blockID)
<button type="submit">Adicionar exercício</button></form>
	</dialog>
}

templ structuredGymExerciseFields(id string) {
	@components.FieldLabel("gym-exercise-name-"+id, "Exercício", true)
	<input id={ "gym-exercise-name-" + id } name="exercise_name" required minlength="2" maxlength="180"/>
	<div class="form-grid form-grid--three">
		<div>@components.FieldLabel("gym-sets-"+id, "Séries (opcional)", false)
<input id={ "gym-sets-" + id } name="sets" type="number" min="1" max="100"/></div>
		<div>@components.FieldLabel("gym-repetitions-"+id, "Repetições (opcional)", false)
<input id={ "gym-repetitions-" + id } name="repetitions" type="number" min="1" max="10000"/></div>
		<div>@components.FieldLabel("gym-duration-"+id, "Duração em segundos (opcional)", false)
<input id={ "gym-duration-" + id } name="duration_seconds" type="number" min="1" max="86400"/></div>
		<div>@components.FieldLabel("gym-distance-"+id, "Distância em metros (opcional)", false)
<input id={ "gym-distance-" + id } name="distance_metres" type="number" min="1" max="100000"/></div>
		<div>@components.FieldLabel("gym-recovery-"+id, "Recuperação em segundos (opcional)", false)
<input id={ "gym-recovery-" + id } name="recovery_seconds" type="number" min="1" max="86400"/></div>
	</div>
	@components.FieldHelp("gym-prescription-help-"+id, "Indique pelo menos repetições, duração ou distância.")
	@components.FieldLabel("gym-resistance-kind-"+id, "Resistência (opcional)", false)
	<select id={ "gym-resistance-kind-" + id } name="resistance_kind"><option value="">Sem resistência indicada</option><option value="KILOGRAMS">Quilogramas</option><option value="PERCENT_1RM">Percentagem de 1RM</option><option value="BODY_WEIGHT">Peso corporal</option><option value="BAND">Banda ou elástico</option><option value="RPE">RPE</option><option value="RIR">RIR</option><option value="COACH_INSTRUCTION">Instrução do treinador</option></select>
	<div data-resistance-value>@components.FieldLabel("gym-resistance-value-"+id, "Valor da resistência", false)
<input id={ "gym-resistance-value-" + id } name="resistance_value" type="number" min="0" max="10000" step="0.01"/></div>
	<div data-resistance-text>@components.FieldLabel("gym-resistance-text-"+id, "Descrição da banda ou instrução", false)
<input id={ "gym-resistance-text-" + id } name="resistance_text" maxlength="180"/></div>
	@components.FieldLabel("gym-intent-"+id, "Intenção de execução (opcional)", false)
	<select id={ "gym-intent-" + id } name="execution_intent"><option value="">Sem indicação</option><option value="CONTROLLED">Controlada</option><option value="EXPLOSIVE">Explosiva</option><option value="MAXIMUM_VELOCITY">Velocidade máxima</option><option value="ISOMETRIC">Isométrica</option><option value="CUSTOM">Outra</option></select>
	@components.FieldLabel("gym-tempo-"+id, "Tempo (opcional)", false)
	<input id={ "gym-tempo-" + id } name="tempo" maxlength="30" placeholder="Ex.: 3-1-1-0"/>
	@components.FieldLabel("gym-exercise-notes-"+id, "Notas do exercício (opcional)", false)
	<textarea id={ "gym-exercise-notes-" + id } name="exercise_notes" maxlength="1000"></textarea>
}

templ structuredWaterBlockForm(page StructuredTrainingPage, sessionID string, segment StructuredTrainingSegment) {
	<a class="action action--quiet" href={ templ.SafeURL("/admin/treinos/estruturados/sessoes/" + sessionID + "/segmentos/" + segment.ID + "/agua?return_to=" + url.QueryEscape(structuredPlannerReturnURL(page))) }>Adicionar treino de água</a>
}

templ structuredGymBlockTaskLink(page StructuredTrainingPage, sessionID string, segmentID string) {
	<a class="action action--quiet" href={ templ.SafeURL("/admin/treinos/estruturados/sessoes/" + sessionID + "/segmentos/" + segmentID + "/ginasio?return_to=" + url.QueryEscape(structuredPlannerReturnURL(page))) }>Adicionar treino de ginásio</a>
}

templ structuredWaterProfileManagement(page StructuredTrainingPage) {
	<section id="training-intensity-profiles" class="module" aria-labelledby="water-profiles-title" data-tab-panel>
		@components.SectionHeading("", "Perfis de intensidade", "Defina a linguagem do clube para kayak e canoa. Cada gravação com o mesmo nome e embarcação cria uma revisão nova; os treinos antigos não mudam.")
		<div class="notice notice--info" role="note">
			<p><strong>Limites do clube, não uma norma universal.</strong> A cadência é orientação. R7 deve descrever o ritmo de prova sustentável para a duração ou distância prescrita. O limite inferior de R5 em kayak continua por confirmar e não é preenchido automaticamente.</p>
		</div>
		<button class="action" type="button" data-dialog-open="add-water-profile">Criar perfil ou nova revisão</button>
		<dialog id="add-water-profile" class="task-dialog" data-task-dialog aria-labelledby="add-water-profile-title">
			<div class="task-dialog__header"><h3 id="add-water-profile-title">Criar perfil de intensidade</h3><button class="action action--quiet" type="button" data-dialog-close>Fechar</button></div>
			<form class="form-layout" method="post" action="/admin/treinos/estruturados/agua/perfis">
				@page.CSRFField
				@components.FieldLabel("water-profile-name", "Nome", true)<input id="water-profile-name" name="name" required minlength="2" maxlength="120"/>
				@components.FieldHelp("water-profile-name-help", "Para rever um perfil, use exatamente o mesmo nome e a mesma embarcação.")
				@components.FieldLabel("water-profile-craft", "Embarcação", true)<select id="water-profile-craft" name="craft" required><option value="KAYAK">Kayak</option><option value="CANOE">Canoa</option></select>
				@components.FieldLabel("water-profile-notes", "Notas (opcional)", false)<textarea id="water-profile-notes" name="notes" maxlength="1000"></textarea>
				<button type="submit">Guardar perfil</button>
			</form>
		</dialog>
		if len(page.WaterProfiles) == 0 {
			@components.EmptyState("Ainda sem perfis", "Crie o primeiro perfil quando os limites tiverem sido confirmados pelo treinador.")
		}
		for _, profile := range page.WaterProfiles {
			<article class="record-item record-item--stacked">
				<div class="record-item__copy"><h3>{ profile.Name }</h3><p class="record-meta">{ profile.Craft } · revisão { fmt.Sprintf("%d", profile.Revision) }</p>
					if profile.Notes != "" {
						<p>{ profile.Notes }</p>
					}
					if len(profile.Zones) == 0 {
						<p class="record-meta">Ainda sem zonas.</p>
					}
					<dl class="training-profile-zones">
						for _, zone := range profile.Zones {
							<div><dt><strong>{ zone.Code } · { zone.Label }</strong></dt><dd>{ zone.Cadence } · { zone.Meaning }</dd></div>
						}
					</dl>
				</div>
				<button class="action action--quiet" type="button" data-dialog-open={ "add-water-zone-" + profile.ID }>Adicionar ou atualizar zona</button>
				<dialog id={ "add-water-zone-" + profile.ID } class="task-dialog" data-task-dialog aria-labelledby={ "add-water-zone-title-" + profile.ID }>
					<div class="task-dialog__header"><h3 id={ "add-water-zone-title-" + profile.ID }>Adicionar ou atualizar zona de { profile.Name }</h3><button class="action action--quiet" type="button" data-dialog-close>Fechar</button></div>
					<form class="form-layout" method="post" action={ templ.SafeURL("/admin/treinos/estruturados/agua/perfis/" + profile.ID + "/zonas") }>
						@page.CSRFField
						@components.FieldLabel("water-zone-code-"+profile.ID, "Código curto", true)<input id={ "water-zone-code-" + profile.ID } name="code" required maxlength="20" placeholder="Ex.: R7"/>
						@components.FieldHelp("water-zone-code-help-"+profile.ID, "Se este código já existir na revisão ativa, os restantes campos substituem a definição dessa revisão.")
						@components.FieldLabel("water-zone-label-"+profile.ID, "Nome completo", true)<input id={ "water-zone-label-" + profile.ID } name="label" required minlength="2" maxlength="120"/>
						<div class="form-grid"><div>@components.FieldLabel("water-zone-min-"+profile.ID, "Cadência mínima (opcional)", false)<input id={ "water-zone-min-" + profile.ID } name="cadence_min" type="number" min="0" max="300"/></div><div>@components.FieldLabel("water-zone-max-"+profile.ID, "Cadência máxima (opcional)", false)<input id={ "water-zone-max-" + profile.ID } name="cadence_max" type="number" min="0" max="300"/></div></div>
						@components.FieldLabel("water-zone-meaning-"+profile.ID, "Significado para o atleta", true)<textarea id={ "water-zone-meaning-" + profile.ID } name="meaning" required minlength="2" maxlength="500"></textarea>
						<button type="submit">Guardar zona</button>
					</form>
				</dialog>
			</article>
		}
	</section>
}

templ structuredWaterStepForm(page StructuredTrainingPage, block StructuredTrainingBlock) {
	<button class="action action--quiet" type="button" data-dialog-open={ "add-water-step-" + block.ID }>Adicionar passo</button>
	<dialog id={ "add-water-step-" + block.ID } class="task-dialog" data-task-dialog aria-labelledby={ "add-water-step-title-" + block.ID }>
		<div class="task-dialog__header"><h3 id={ "add-water-step-title-" + block.ID }>Adicionar esforço ou grupo</h3><button class="action action--quiet" type="button" data-dialog-close>Fechar</button></div>
		<form class="form-layout" method="post" action={ templ.SafeURL("/admin/treinos/estruturados/blocos/" + block.ID + "/agua/passos") }>@page.CSRFField
			<input type="hidden" name="return_to" value={ structuredPlannerReturnURL(page) }/>
			@structuredWaterStepFields(block.ID, block.WaterSteps)<button type="submit">Adicionar passo</button></form>
	</dialog>
}

templ structuredWaterStepFields(id string, steps []StructuredWaterStep) {
	@components.FieldLabel("water-step-parent-"+id, "Dentro de um grupo (opcional)", false)
	<select id={ "water-step-parent-" + id } name="parent_step_id">
		<option value="">Ao nível do bloco</option>
		for _, step := range steps {
			if step.Kind == "REPEAT_GROUP" {
				<option value={ step.ID }>{ step.Name }</option>
			}
		}
	</select>
	@components.FieldLabel("water-step-kind-"+id, "Tipo", true)<select id={ "water-step-kind-" + id } name="step_kind" required><option value="EFFORT">Esforço ou exercício</option><option value="REPEAT_GROUP">Grupo de repetições</option></select>
	@components.FieldLabel("water-step-name-"+id, "Nome", true)<input id={ "water-step-name-" + id } name="step_name" required minlength="2" maxlength="180"/>
	<div class="form-grid form-grid--three"><div>@components.FieldLabel("water-repeats-"+id, "Repetições (para grupo)", false)<input id={ "water-repeats-" + id } name="repeats" type="number" min="1" max="100"/></div><div>@components.FieldLabel("water-duration-"+id, "Duração (s)", false)<input id={ "water-duration-" + id } name="duration_seconds" type="number" min="1" max="86400"/></div><div>@components.FieldLabel("water-duration-certainty-"+id, "Precisão da duração", false)<select id={ "water-duration-certainty-" + id } name="duration_certainty"><option value="">Sem duração</option><option value="EXACT">Exata</option><option value="ESTIMATED">Estimada</option></select></div><div>@components.FieldLabel("water-distance-"+id, "Distância (m)", false)<input id={ "water-distance-" + id } name="distance_metres" type="number" min="1" max="200000"/></div><div>@components.FieldLabel("water-distance-certainty-"+id, "Precisão da distância", false)<select id={ "water-distance-certainty-" + id } name="distance_certainty"><option value="">Sem distância</option><option value="EXACT">Exata</option><option value="ESTIMATED">Estimada</option></select></div><div>@components.FieldLabel("water-recovery-"+id, "Recuperação (s)", false)<input id={ "water-recovery-" + id } name="recovery_seconds" type="number" min="1" max="86400"/></div></div>
	<div class="form-grid form-grid--three"><div>@components.FieldLabel("water-intensity-"+id, "Intensidade", false)<input id={ "water-intensity-" + id } name="intensity_code" maxlength="20" placeholder="Ex.: R7"/></div><div>@components.FieldLabel("water-cadence-"+id, "Cadência (remadas/min)", false)<input id={ "water-cadence-" + id } name="cadence_spm" type="number" min="1" max="300"/></div><div>@components.FieldLabel("water-focus-"+id, "Foco técnico/tático", false)<input id={ "water-focus-" + id } name="drill_focus" maxlength="180"/></div><div>@components.FieldLabel("water-format-"+id, "Formato", false)<input id={ "water-format-" + id } name="drill_format" maxlength="180" placeholder="Ex.: 3 contra 2"/></div><div>@components.FieldLabel("water-roles-"+id, "Papéis", false)<input id={ "water-roles-" + id } name="role_notes" maxlength="500" placeholder="Ex.: GR e pivot"/></div></div>
	@components.FieldLabel("water-step-notes-"+id, "Instruções (opcional)", false)<textarea id={ "water-step-notes-" + id } name="step_instructions" maxlength="1000"></textarea>
}

templ waterMethodOptions() {
	for _, option := range []struct{ Value, Label string }{{"CONTINUOUS", "Contínuo"}, {"INTERVALS", "Intervalos"}, {"FARTLEK", "Fartlek"}, {"TECHNIQUE", "Técnica"}, {"STARTS", "Partidas"}, {"RACE_SIMULATION", "Simulação de prova"}, {"TACTICAL_DRILL", "Exercício técnico-tático"}, {"CUSTOM", "Outro método"}} {
		<option value={ option.Value }>{ option.Label }</option>
	}
}

templ structuredMoveSegment(page StructuredTrainingPage, segment StructuredTrainingSegment) {
	<div class="record-item__actions" aria-label="Ordenar segmento">
		for _, move := range []struct{ Value, Label, Symbol string }{{"up", "Subir segmento", "↑"}, {"down", "Descer segmento", "↓"}} {
			<form method="post" action={ templ.SafeURL("/admin/treinos/estruturados/segmentos/" + segment.ID + "/mover") }>@page.CSRFField
	<input type="hidden" name="return_to" value={ structuredPlannerReturnURL(page) }/><input type="hidden" name="direction" value={ move.Value }/><button class="action action--quiet action--icon" type="submit" aria-label={ move.Label } title={ move.Label }>{ move.Symbol }</button></form>
		}
	</div>
}

templ structuredMoveBlock(page StructuredTrainingPage, block StructuredTrainingBlock) {
	<div class="record-item__actions" aria-label="Ordenar bloco">
		for _, move := range []struct{ Value, Label, Symbol string }{{"up", "Subir bloco", "↑"}, {"down", "Descer bloco", "↓"}} {
			<form method="post" action={ templ.SafeURL("/admin/treinos/estruturados/blocos/" + block.ID + "/mover") }>@page.CSRFField
	<input type="hidden" name="return_to" value={ structuredPlannerReturnURL(page) }/><input type="hidden" name="direction" value={ move.Value }/><button class="action action--quiet action--icon" type="submit" aria-label={ move.Label } title={ move.Label }>{ move.Symbol }</button></form>
		}
	</div>
}

templ structuredMoveExercise(page StructuredTrainingPage, exercise StructuredGymExercise) {
	<div class="record-item__actions" aria-label="Ordenar exercício">
		for _, move := range []struct{ Value, Label, Symbol string }{{"up", "Subir exercício", "↑"}, {"down", "Descer exercício", "↓"}} {
			<form method="post" action={ templ.SafeURL("/admin/treinos/estruturados/exercicios/" + exercise.ID + "/mover") }>@page.CSRFField
	<input type="hidden" name="return_to" value={ structuredPlannerReturnURL(page) }/><input type="hidden" name="direction" value={ move.Value }/><button class="action action--quiet action--icon" type="submit" aria-label={ move.Label } title={ move.Label }>{ move.Symbol }</button></form>
		}
	</div>
}

templ gymPurposeOptions() {
	for _, value := range []string{"WARM_UP", "MAIN", "COOL_DOWN", "TECHNIQUE", "CUSTOM"} {
		<option value={ value }>{ structuredPurposeLabel(value) }</option>
	}
}

templ gymObjectiveOptions() {
	for _, value := range []string{"MOBILITY", "ACTIVATION", "MAX_STRENGTH_HYPERTROPHY", "MAX_STRENGTH_NEURAL", "EXPLOSIVE_STRENGTH", "STRENGTH_ENDURANCE", "TECHNIQUE", "CORE", "CUSTOM"} {
		<option value={ value }>{ trainingObjectiveLabel(value) }</option>
	}
}

func structuredTrainingActions() []components.PageAction {
	return []components.PageAction{{Label: "Criar grupo", Href: "#criar-grupo-treino", Variant: "primary", TaskID: "criar-grupo-treino"}, {Label: "Criar semana", Href: "#criar-semana-treino", Variant: "secondary", TaskID: "criar-semana-treino"}, {Label: "Criar sessão", Href: "#criar-sessao-estruturada", Variant: "secondary", TaskID: "criar-sessao-estruturada"}, {Label: "Treinos atuais", Href: "/admin/treinos", Variant: "quiet"}}
}
func structuredEntryKindLabel(value string) string {
	switch value {
	case "REST":
		return "Descanso"
	case "COMPETITION":
		return "Competição"
	case "LOGISTICS":
		return "Logística"
	default:
		return "Treino"
	}
}
func structuredModalityLabel(value string) string {
	switch value {
	case "WATER":
		return "Água"
	case "GYM":
		return "Ginásio"
	case "RUN":
		return "Corrida"
	case "BIKE":
		return "Bicicleta"
	case "ERGOMETER":
		return "Ergómetro"
	case "FLEXIBILITY":
		return "Flexibilidade e mobilidade"
	case "SPORTS_GAMES":
		return "Jogos desportivos"
	default:
		return "Outra"
	}
}
func structuredModalitiesLabel(values []string) string {
	labels := make([]string, 0, len(values))
	for _, value := range values {
		labels = append(labels, structuredModalityLabel(value))
	}
	return strings.Join(labels, " + ")
}
func structuredPurposeLabel(value string) string {
	switch value {
	case "WARM_UP":
		return "Aquecimento"
	case "MAIN":
		return "Trabalho principal"
	case "COOL_DOWN":
		return "Retorno à calma"
	case "TECHNIQUE":
		return "Técnica"
	default:
		return "Outro objetivo"
	}
}
func gymStructureLabel(value string) string {
	switch value {
	case "CIRCUIT":
		return "Circuito"
	case "SUPERSET":
		return "Supersérie"
	default:
		return "Séries simples"
	}
}
func trainingObjectiveLabel(value string) string {
	switch value {
	case "MOBILITY":
		return "Flexibilidade e mobilidade"
	case "ACTIVATION":
		return "Ativação"
	case "MAX_STRENGTH_HYPERTROPHY":
		return "Força máxima — hipertrofia"
	case "MAX_STRENGTH_NEURAL":
		return "Força máxima — neural"
	case "EXPLOSIVE_STRENGTH":
		return "Força veloz e explosiva"
	case "STRENGTH_ENDURANCE":
		return "Força resistência"
	case "TECHNIQUE":
		return "Técnica"
	case "CORE":
		return "Core"
	default:
		return "Outro objetivo"
	}
}
func gymExecutionIntentLabel(value string) string {
	switch value {
	case "CONTROLLED":
		return "Execução controlada"
	case "EXPLOSIVE":
		return "Execução explosiva"
	case "MAXIMUM_VELOCITY":
		return "Velocidade máxima"
	case "ISOMETRIC":
		return "Isométrica"
	default:
		return "Outra intenção"
	}
}
func trainingRoutineKindLabel(value string) string {
	switch value {
	case "BLOCK":
		return "Bloco"
	case "SEGMENT":
		return "Segmento"
	default:
		return "Sessão"
	}
}
func trainingRoutineTargetLabel(value string) string {
	switch value {
	case "BLOCK":
		return "Segmento de destino"
	case "SEGMENT":
		return "Sessão de destino"
	default:
