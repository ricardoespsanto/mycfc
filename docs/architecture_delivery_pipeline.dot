digraph MyCFCDelivery {
  graph [
    rankdir=TB,
    splines=polyline,
    compound=true,
    newrank=true,
    bgcolor="white",
    pad="0.35",
    nodesep="0.5",
    ranksep="0.68",
    fontname="Arial",
    fontsize=24,
    label="MyCFC — Verified Release and Production Delivery",
    labelloc=t
  ];
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", color="#425466", penwidth=1.3, fontname="Arial", fontsize=11.5, margin="0.18,0.12"];
  edge [color="#5b6775", penwidth=1.2, arrowsize=0.75, fontname="Arial", fontsize=9.5];

  change [label="Reviewed change", fillcolor="#f5f7fa"];
  pr [label="Pull request"];
  ci [label="Required CI summary\nsource · integration · browser · Terraform\npredecessor → candidate release gate", fillcolor="#eef5ff"];
  merge [label="Human merge approval", shape=octagon, fillcolor="#fff6e8"];
  main [label="Protected main commit\n(no automatic deployment)", fillcolor="#eef2f7"];
  release [label="Resumable release command\nmerge / infrastructure / release hard stops", fillcolor="#fffdf4"];
  approve [label="Human publish + deploy approval\nexact version and commit", shape=octagon, fillcolor="#fff6e8"];
  tag [label="Signed annotated semantic tag"];

  change -> pr -> ci -> merge -> main -> release -> approve -> tag;

  subgraph cluster_github {
    label="Protected GitHub production environment";
    color="#d7b97c";
    style="rounded,dashed";
    margin=18;

    dispatch [label="Manual deploy.yml dispatch\nexact main SHA + version + issue allowlist", fillcolor="#fff6e8"];
    verify [label="Verify signed commit + tag\nmain ancestry · canonical CI workflow"];
    build [label="Build + attest immutable app image\nrevision + version + schema labels", fillcolor="#f6f1ff"];
    manifest [label="Build + attest canonical manifest image\ntree · migrations · gates · issue allowlist", fillcolor="#eef5ff"];
    publish [label="Publish release pickup tag\nonly after both attestations verify", fillcolor="#eaf8ef"];
    deploy_role [label="Short-lived deploy role\npublish only", fillcolor="#f6f1ff"];
    observer_role [label="Short-lived observer role\nlogs · ECR inventory · alarms only", fillcolor="#f6f1ff"];
    finalise [label="Credential-separated GitHub record job\nrelease assets + explicit issue IDs", fillcolor="#eaf8ef"];

    dispatch -> verify -> build -> manifest -> publish;
    deploy_role -> build;
    observer_role -> finalise;
  }
  tag -> dispatch;

  subgraph cluster_aws {
    label="Retained AWS services";
    color="#8ea0b2";
    style="rounded";
    margin=18;

    ecr [label="Immutable ECR repository"];
    logs [label="CloudWatch deployment log\nallowlisted events only"];
    alarms [label="Deployment alarms"];
  }
  build -> ecr;
  manifest -> ecr;
  logs -> observer_role [label="read exact receipt"];
  alarms -> observer_role [style=dashed];

  subgraph cluster_host {
    label="Hetzner production host — pull based; no GitHub credential";
    color="#79a38b";
    style="rounded";
    margin=18;

    poll [label="Root release timer\ndedicated ECR-read / log-write identity"];
    trust [label="Verify app + manifest attestations\nmatch SHA · digest · labels · release tag", fillcolor="#fff6e8"];
    phases [label="Ordered fail-closed phases\nbootstrap → migrate → harden → guardian bind"];
    candidate [label="Inactive blue/green candidate\nlive · ready · login · fingerprinted asset"];
    receipt [label="Atomic sanitized deployment receipt v1", fillcolor="#eef5ff"];
    switch [label="Atomic Caddy upstream switch", fillcolor="#eaf8ef"];
    rollback [label="No switch or restore prior route\nquarantine failed digest", fillcolor="#fff0f0"];

    poll -> trust -> phases -> candidate;
    candidate -> switch [label="all checks pass"];
    candidate -> rollback [label="failure", color="#b94a48", fontcolor="#8f2f2d"];
    switch -> receipt;
    rollback -> receipt;
  }
  publish -> ecr;
  ecr -> poll [label="poll app + manifest tags"];
  receipt -> logs [label="fixed receipt summary"];
  receipt -> finalise [label="exact successful binding", style=dashed];

  activation [label="Separate feature-specific approval\nand operator activation", shape=octagon, fillcolor="#fff6e8"];
  finalise -> activation [label="never implied", style=dashed];
}
