{
	# cloudflared is the only proxy that can reach Caddy on the private Docker network.
	servers {
		trusted_proxies static private_ranges
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

http://{$MYCFC_DOMAIN} {
	encode zstd gzip

	rate_limit {
		zone registration_create {
			match {
				method POST
				path /registo
			}
			key {client_ip}
			events 5
			window 5m
		}
	}

	# The release agent updates this single upstream and reloads Caddy only after
	# the inactive application slot has passed its direct candidate checks.
	import /etc/mycfc/deployment/caddy-upstream.caddy
}
