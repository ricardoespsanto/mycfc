package components

type PageAction struct { Label, Href, Variant, TaskID string }
type StatusItem struct { Label, Value string }
type CollectionToolbarData struct { TitleID, Title, Count, ClearHref, ClearLabel string }

templ PageHeader(eyebrow, title, intro string, actions []PageAction) {
	<header class="page-header">
		<div class="page-header__copy"><p class="eyebrow">{ eyebrow }</p><h1>{ title }</h1><p>{ intro }</p></div>
		if len(actions) > 0 {
				<div class="page-actions">
					for _, action := range normalizedPageActions(actions) {
						if action.TaskID != "" {
							<a class={ "action action--" + action.Variant } href={ templ.SafeURL(action.Href) } aria-haspopup="dialog" aria-controls={ action.TaskID } data-task-open={ action.TaskID }>{ action.Label }</a>
						} else {
							<a class={ "action action--" + action.Variant } href={ templ.SafeURL(action.Href) }>{ action.Label }</a>
						}
					}
			</div>
		}
	</header>
}

templ Surface(title string, content templ.Component) {
	<section class="module"><h2>{ title }</h2>@content</section>
}

templ SectionHeading(eyebrow, title, summary string) {
	<header class="section-heading">
		<div>
			<h2>{ title }</h2>
			if summary != "" {
				<p>{ summary }</p>
			}
		</div>
		{ children... }
	</header>
}

templ RecordList(label string) {
	<ul class="record-list" aria-label={ label }>{ children... }</ul>
}

templ RecordItem(title, href, meta string) {
	<li class="record-item">
		<div class="record-item__copy">
			if href != "" {
				<h3><a href={ templ.SafeURL(href) }>{ title }</a></h3>
			} else {
				<h3>{ title }</h3>
			}
			if meta != "" {
				<p class="record-meta">{ meta }</p>
			}
		</div>
		{ children... }
	</li>
}

templ Badge(label, tone string) { <span class={ "badge badge--" + tone }><span class="badge__cue" aria-hidden="true"></span>{ label }</span> }

templ EmptyState(title, description string) {
	<div class="empty-state"><span class="empty-state__icon" aria-hidden="true">≈</span><strong>{ title }</strong><p>{ description }</p></div>
}

templ Callout(title, message, tone string) {
	<div class={ "callout callout--" + tone } role={ calloutRole(tone) }><strong>{ title }</strong><p>{ message }</p></div>
}

templ Icon(label string, decorative bool) {
	if decorative {
		<span class="icon" aria-hidden="true">{ children... }</span>
	} else {
		<span class="icon" role="img" aria-label={ label }>{ children... }</span>
	}
}

templ DataRegion(label string, content templ.Component) { <div class="data-region" role="region" aria-label={ label } tabindex="0">@content</div> }
templ DataRegionDescribed(label, describedBy string, content templ.Component) { <div class="data-region" role="region" aria-label={ label } aria-describedby={ describedBy } tabindex="0">@content</div> }

templ CollectionToolbar(data CollectionToolbarData) {
	<div class="collection-toolbar">
		<h2 id={ data.TitleID } class="visually-hidden">{ data.Title }</h2>
		<div class="collection-toolbar__controls">{ children... }</div>
		<div class="collection-toolbar__summary">
			<span class="collection-count">{ data.Count }</span>
			if data.ClearHref != "" {
				<a class="action action--quiet" href={ templ.SafeURL(data.ClearHref) }>{ data.ClearLabel }</a>
			}
		</div>
	</div>
}

templ RowActionMenu(id, recordName string) {
	<details class="row-action-menu" data-row-action-menu>
		<summary aria-controls={ id } aria-label={ "Mais ações para " + recordName }><span aria-hidden="true">Mais ações</span></summary>
		<div id={ id } class="row-action-menu__panel" data-row-action-menu-panel>
			<div class="row-action-menu__items">{ children... }</div>
		</div>
	</details>
}

templ StatusSummary(label string, items []StatusItem) {
	<dl class="status-summary" aria-label={ label }>
		for _, item := range items {
			<div><dt>{ item.Label }</dt><dd>{ item.Value }</dd></div>
		}
	</dl>
}

templ Avatar(userID, name string) {
	if userID != "" {
		<img class="person-avatar" src={ "/membros/"+userID+"/foto" } alt="" width="36" height="36"/>
	}
}

templ PersonName(userID, name string) { <span class="person-name">@Avatar(userID, name)<span>{ name }</span></span> }

func calloutRole(tone string) string { if tone == "error" { return "alert" }; return "status" }

func normalizedPageActions(actions []PageAction) []PageAction {
	normalized := make([]PageAction, len(actions))
	primarySeen := false
	for index, action := range actions {
		switch action.Variant {
		case "primary":
			if primarySeen { action.Variant = "secondary" }
			primarySeen = true
		case "secondary", "quiet", "danger":
		default:
			action.Variant = "secondary"
		}
		normalized[index] = action
	}
	return normalized
}
