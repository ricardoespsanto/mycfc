package components

// AdminTab describes one of the top-level administration sections. The list
// is small and fixed, so it is defined here rather than assembled per
// handler.
type AdminTab struct {
	Label string
	Path  string
}

var AdminTabs = []AdminTab{
	{Label: "Membros", Path: "/admin/membros"},
	{Label: "Notícias", Path: "/admin/noticias"},
	{Label: "Frota", Path: "/admin/fleet"},
	{Label: "Componentes", Path: "/admin/componentes"},
}

// AdminSubNav gives every /admin/* page a shared "you are here" strip across
// the three administration sections, so navigating between them doesn't feel
// like jumping between unrelated pages.
templ AdminSubNav(currentPath string) {
	<nav aria-label="Secções de administração" class="admin-subnav">
		<ul>
			for _, tab := range AdminTabs {
				<li>
					if tab.Path == currentPath {
						<a href={ tab.Path } aria-current="page">{ tab.Label }</a>
					} else {
						<a href={ tab.Path }>{ tab.Label }</a>
					}
				</li>
			}
		</ul>
	</nav>
}
