package pages

import "github.com/cfcoimbra/mycfc/internal/validation"
import "github.com/cfcoimbra/mycfc/ui/components"

type RegistrationPage struct {
	Meta                                components.PageMeta
	Name, Email, DateOfBirth string
	TermsURL, ImageURL                 string
	TermsAccepted, ImageAccepted       bool
	Errors                       validation.FieldErrors
	CSRFField                    templ.Component
}

templ Registration(page RegistrationPage) {
	@components.AuthBase(page.Meta, registrationContent(page))
}

templ registrationContent(page RegistrationPage) {
	<section class="auth-card" aria-labelledby="registration-title">
		<p class="eyebrow">Junte-se ao clube</p>
		<h1 id="registration-title">Criar conta</h1>
		<p>Crie o seu acesso pessoal ao MyCFC. Os campos assinalados são obrigatórios.</p>
		<form class="form-layout" method="post" action="/registo">
			@page.CSRFField
			@components.ErrorSummary(components.FieldErrorsFromMap(map[string]string(page.Errors), []string{"name", "email", "date_of_birth", "password", "password_confirmation", "accept_terms", "accept_image_use"}))
			@components.RequiredNote()
			<div class="form-field">@components.FieldLabel("name", "Nome", true)<input id="name" name="name" autocomplete="name" value={ page.Name } required aria-invalid={ ariaBoolean(page.Errors["name"] != "") } aria-describedby="name-help name-error"/>@components.FieldHelp("name-help", "Use o seu nome completo.")@components.FieldErrorMessage("name", page.Errors["name"])</div>
			<div class="form-field">@components.FieldLabel("email", "Correio eletrónico", true)<input id="email" name="email" type="email" autocomplete="email" value={ page.Email } required aria-invalid={ ariaBoolean(page.Errors["email"] != "") } aria-describedby="email-help email-error"/>@components.FieldHelp("email-help", "Este endereço será o seu identificador principal de acesso.")@components.FieldErrorMessage("email", page.Errors["email"])</div>
			<div class="form-field">@components.FieldLabel("date_of_birth", "Data de nascimento", true)<input id="date_of_birth" name="date_of_birth" type="date" autocomplete="bday" value={ page.DateOfBirth } required aria-invalid={ ariaBoolean(page.Errors["date_of_birth"] != "") } aria-describedby="date-of-birth-help date_of_birth-error"/>@components.FieldHelp("date-of-birth-help", "A conta de adulto exige pelo menos 18 anos.")@components.FieldErrorMessage("date_of_birth", page.Errors["date_of_birth"])</div>
			<div class="form-field">@components.FieldLabel("password", "Palavra-passe", true)<input id="password" name="password" type="password" autocomplete="new-password" required aria-invalid={ ariaBoolean(page.Errors["password"] != "") } aria-describedby="password-help password-error"/>@components.FieldHelp("password-help", "Use entre 12 e 72 bytes, com pelo menos uma letra e um carácter que não seja uma letra. Por segurança, este valor não é reposto após um erro.")@components.FieldErrorMessage("password", page.Errors["password"])</div>
			<div class="form-field">@components.FieldLabel("password_confirmation", "Confirmar palavra-passe", true)<input id="password_confirmation" name="password_confirmation" type="password" autocomplete="new-password" required aria-invalid={ ariaBoolean(page.Errors["password_confirmation"] != "") } aria-describedby="password-confirmation-help password_confirmation-error"/>@components.FieldHelp("password-confirmation-help", "Introduza novamente a mesma palavra-passe.")@components.FieldErrorMessage("password_confirmation", page.Errors["password_confirmation"])</div>
			<div class="consent-field"><label for="accept_terms"><input id="accept_terms" name="accept_terms" type="checkbox" required checked?={ page.TermsAccepted } aria-invalid={ ariaBoolean(page.Errors["accept_terms"] != "") } aria-describedby="accept_terms-error"/> Aceito os <a href={ templ.SafeURL(page.TermsURL) } target="_blank" rel="noopener">termos gerais</a>. <span class="required-mark" aria-hidden="true">*</span></label>@components.FieldErrorMessage("accept_terms", page.Errors["accept_terms"])</div>
			<div class="consent-field"><label for="accept_image_use"><input id="accept_image_use" name="accept_image_use" type="checkbox" required checked?={ page.ImageAccepted } aria-invalid={ ariaBoolean(page.Errors["accept_image_use"] != "") } aria-describedby="accept_image_use-error"/> Aceito a <a href={ templ.SafeURL(page.ImageURL) } target="_blank" rel="noopener">autorização de uso de imagem</a>. <span class="required-mark" aria-hidden="true">*</span></label>@components.FieldErrorMessage("accept_image_use", page.Errors["accept_image_use"])</div>
			@components.FormActions("") { <button class="action action--primary" type="submit">Criar conta</button> }
		</form>
		<p class="auth-alternate">Já tem conta? <a href="/login">Iniciar sessão</a></p>
	</section>
}
