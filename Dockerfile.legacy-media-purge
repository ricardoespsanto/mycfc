# syntax=docker/dockerfile:1.8

FROM golang:1.27.1-alpine3.24@sha256:f86f1a6701e3dcc445fec097a42f78b758f15950ccf032c2d3e54e2754d32fdb AS build
WORKDIR /src
RUN apk add --no-cache ca-certificates git
COPY go.mod go.sum* ./
RUN go mod download
COPY cmd/legacy-media-purge ./cmd/legacy-media-purge
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -tags=legacy_media_purge_execute -ldflags="-s -w" -o /out/legacy-media-purge ./cmd/legacy-media-purge

FROM gcr.io/distroless/static-debian12:nonroot@sha256:52dcfbabb7457ea47c82f6e13af8c8a4a1d9f7b0145142b3ecab20f2b888411d
WORKDIR /app
COPY --from=build /out/legacy-media-purge /app/legacy-media-purge
USER nonroot:nonroot
ENTRYPOINT ["/app/legacy-media-purge"]
