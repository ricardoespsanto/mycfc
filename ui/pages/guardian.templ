package pages

import "github.com/cfcoimbra/mycfc/internal/validation"
import "github.com/cfcoimbra/mycfc/ui/components"

type GuardianPage struct {
	Meta       components.PageMeta
	Dependents []DashboardItem
	Calendars  []CalendarLink
	CalendarAPIKey string
	CalendarSources string
	ResponsibilityURL string
	Name, DateOfBirth string
	Errors     validation.FieldErrors
	Success    string
	RepairForm components.RepairFormData
}

templ Guardian(page GuardianPage) {
	@components.Base(page.Meta, GuardianContent(page))
}

templ GuardianContent(page GuardianPage) {
	<div id="guardian-content">
		<section class="dashboard-hero"><p class="eyebrow">MyCFC</p><h1>Menores a cargo</h1><p>Consulte os menores a seu cargo e respetivas agendas.</p></section>
		if page.Success != "" {
			@components.StatusMessage(page.Success, "success")
		}
		<section class="dashboard-card" aria-labelledby="dependents-title"><h2 id="dependents-title">Menores a cargo</h2>
			if len(page.Dependents) == 0 {
				<p class="empty-state">Ainda não tem menores a cargo.</p>
			}
			if len(page.Dependents) > 0 {
				<ul class="content-list">
					for _, dependent := range page.Dependents {
						<li><strong>{ dependent.Title }</strong><span> { dependent.Detail }</span></li>
					}
				</ul>
			}
		</section>
		<details class="dashboard-card disclosure-card" open?={ len(page.Dependents) == 0 || len(page.Errors) > 0 } aria-labelledby="add-dependent-title"><summary><span id="add-dependent-title" class="disclosure-card__title">Adicionar menor a cargo</span><span class="disclosure-card__summary">Associe um novo dependente à sua conta.</span></summary><div class="disclosure-card__content">
			@components.StatusMessage(page.Errors["form"], "error")
			@components.ErrorSummary(components.FieldErrorsFromMap(map[string]string(page.Errors), []string{"name", "date_of_birth", "accept_minor_responsibility"}))
			<form class="form-layout" method="post" action="/guardian/add-dependent" hx-post="/guardian/add-dependent" hx-target="#guardian-content" hx-swap="outerHTML" hx-target-422="#guardian-content" hx-swap-422="outerHTML" hx-disabled-elt="find button, find input[type='submit']">
				@page.Meta.CSRFField
				@components.RequiredNote()
				<div class="form-field">@components.FieldLabel("name", "Nome", true)<input id="name" name="name" autocomplete="name" value={ page.Name } required aria-invalid?={ page.Errors["name"] != "" } aria-describedby="name-help name-error"/>@components.FieldHelp("name-help", "Use o nome completo do menor.")@components.FieldErrorMessage("name", page.Errors["name"])</div>
				<div class="form-field">@components.FieldLabel("date_of_birth", "Data de nascimento", true)<input id="date_of_birth" name="date_of_birth" type="date" value={ page.DateOfBirth } required aria-invalid?={ page.Errors["date_of_birth"] != "" } aria-describedby="date-of-birth-help date_of_birth-error"/>@components.FieldHelp("date-of-birth-help", "A idade é validada à data de hoje.")@components.FieldErrorMessage("date_of_birth", page.Errors["date_of_birth"])</div>
				<label for="accept_minor_responsibility"><input id="accept_minor_responsibility" name="accept_minor_responsibility" type="checkbox" required aria-invalid?={ page.Errors["accept_minor_responsibility"] != "" } aria-describedby="accept_minor_responsibility-error"/> Aceito a <a href={ templ.SafeURL(page.ResponsibilityURL) } target="_blank" rel="noopener">responsabilidade pelo menor a cargo</a>. <span class="required-mark" aria-hidden="true">*</span></label>@components.FieldErrorMessage("accept_minor_responsibility", page.Errors["accept_minor_responsibility"])
				@components.FormActions("/dashboard/guardian") { <button type="submit">Adicionar menor</button> }
			</form>
		</div></details>
		@components.RepairForm(page.RepairForm)
	</div>
}
